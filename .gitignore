# Rust / Cargo
/target/
**/target/

# Imágenes de disco (bootloader BIOS y datos sosofs)
*.img

# Userspace: binarios ELF copiados por `cargo xtask` desde user/
/rootfs/bin/
/rootfs/lib/rustlib/
/rootfs/lib/sal/
/rootfs/usr/share/sal/

# Artefactos de `cargo xtask test-update` (release de prueba y su marcador)
/rootfs/etc/actualiza-marca.txt
/rootfs/var/

# Claves SSH generadas o inyectadas por mkfs-soso / xtask
/rootfs/etc/authorized_key
/rootfs/etc/soso-release
/rootfs/etc/ssh_host_key

# Configuración local de Claude Code
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Logs de `cargo xtask test` (serial por shard en la raíz del repo)
/test-*-serial.log

# Bytecode de las pruebas Python (tests/self-improvement)
__pycache__/

# Editor / OS
.DS_Store
*~
*.swp
*.swo

# Capa lxdde (Linux pinneado + artefactos de build)
lxdde/linux/
lxdde/reference/
lxdde/ports-extern/
lxdde/shim/src/generated_dummies.c
drivers-extern.toml
board.txt
/vendor/rust/

node_modules/
# Campañas de automejora (tests/self-improvement/campana/ejecucion-*): el arnés deja copias completas del repo por
# tarea (~25 MB cada una) mientras corre; sólo se versionan registros, conversaciones, eventos e informes.
/tests/self-improvement/campana/ejecucion-*/base-*/
/tests/self-improvement/campana/ejecucion-*/refs/
/tests/self-improvement/campana/ejecucion-*/*/copia/
/tests/self-improvement/campana/ejecucion-*/*/validador/
/tests/self-improvement/campana/ejecucion-*/*/captura/
/tests/self-improvement/campana/ejecucion-*/*/estado/

# Evidencia de las ejecuciones de campaña 6 en adelante: sólo local (los bancos campana3/, campana4/ y los
# campaign-N.json sí se versionan, que son lo que hace falta para repetirlas). Las ejecuciones 1–8 ya estaban versionadas.
/tests/self-improvement/campana/ejecucion-9/
/tests/self-improvement/campana/ejecucion-[1-9][0-9]*/
