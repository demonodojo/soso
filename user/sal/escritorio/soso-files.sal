import "soso.sal"
import "proto.sal"
import "superficie.sal"
import "fuente.sal"
import "files_path.sal"
import "tema.sal"
import "fuentes.sal"

fn st_size() -> Int
    4096

fn st_off_nrows() -> Int
    8

fn st_off_sel() -> Int
    12

fn st_off_esc() -> Int
    16

fn st_off_tema() -> Int
    20

fn st_off_nivel() -> Int
    24

fn st_off_gw() -> Int
    28

fn st_off_gh() -> Int
    32

fn st_off_path() -> Int
    64

fn st_path_cap() -> Int
    255

fn st_off_rows() -> Int
    320

fn st_row_stride() -> Int
    64

fn st_max_rows() -> Int
    48

fn st_row_type(st: Int, i: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_get_u8(b, st_off_rows() + i * st_row_stride())

fn st_row_nlen(st: Int, i: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_get_u8(b, st_off_rows() + i * st_row_stride() + 1)

fn st_row_name_off(st: Int, i: Int) -> Int
    st + st_off_rows() + i * st_row_stride() + 2

fn st_path_len(st: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    v = bytes_get_i64(b, 0)
    if v < 0
        0
    else
        if v > st_path_cap()
            st_path_cap()
        else
            v

fn st_path_ptr(st: Int) -> Int
    st + st_off_path()

fn st_nrows(st: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_get_u32(b, st_off_nrows())

fn st_set_nrows(st: Int, n: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_set_u32(b, st_off_nrows(), n)

fn st_sel(st: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_get_u32(b, st_off_sel())

fn st_set_sel(st: Int, v: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_set_u32(b, st_off_sel(), v)

fn st_esc(st: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_get_u32(b, st_off_esc())

fn st_set_esc(st: Int, v: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_set_u32(b, st_off_esc(), v)

fn st_tema(st: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_get_u32(b, st_off_tema())

fn st_set_tema(st: Int, v: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_set_u32(b, st_off_tema(), v)

fn st_nivel(st: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_get_u32(b, st_off_nivel())

fn st_set_nivel(st: Int, v: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_set_u32(b, st_off_nivel(), v)

fn st_gw(st: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_get_u32(b, st_off_gw())

fn st_set_gw(st: Int, v: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_set_u32(b, st_off_gw(), v)

fn st_gh(st: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_get_u32(b, st_off_gh())

fn st_set_gh(st: Int, v: Int) -> Int ! alloc
    b = bytes_view_mem(st, st_size())
    bytes_set_u32(b, st_off_gh(), v)

fn st_path_set_str(st: Int, s: String) -> Int ! alloc
    n = str_len(s)
    if n > st_path_cap()
        n = st_path_cap()
    b = bytes_view_mem(st, st_size())
    bytes_set_i64(b, 0, n)
    tmp = bytes_new(n + 1)
    str_bytes_copy(tmp, 0, s)
    _c = bytes_copy(st, st_off_path(), tmp, 0, n)
    0

fn st_path_set_bytes(st: Int, src: Int, n: Int) -> Int ! alloc
    if n > st_path_cap()
        n = st_path_cap()
    b = bytes_view_mem(st, st_size())
    bytes_set_i64(b, 0, n)
    _c = bytes_copy(st, st_off_path(), src, 0, n)
    0

fn st_path_is_root(st: Int) -> Int ! alloc
    n = st_path_len(st)
    if n != 1
        0
    else
        b = bytes_view_mem(st, st_size())
        if bytes_get_u8(b, st_off_path()) == 47
            1
        else
            0

fn st_path_go_parent(st: Int) -> Int ! alloc
    n = st_path_len(st)
    if st_path_is_root(st) != 0
        0
    else
        slash = 0
        i = n - 1
        while i > 0
            if slash == 0
                b = bytes_view_mem(st, st_size())
                if bytes_get_u8(b, st_off_path() + i) == 47
                    slash = i
            i = i - 1
        if slash == 0
            st_path_set_str(st, d"/")
        else
            b = bytes_view_mem(st, st_size())
            bytes_set_i64(b, 0, slash)
        0

fn st_path_join_row(st: Int, row: Int) -> Int ! alloc
    nlen = st_row_nlen(st, row)
    if nlen <= 0
        0
    else
        if nlen > 60
            nlen = 60
        base = st_path_len(st)
        new_len = base + 1 + nlen
        if st_path_is_root(st) != 0
            new_len = 1 + nlen
        if new_len > st_path_cap()
            0
        else
            b = bytes_view_mem(st, st_size())
            if st_path_is_root(st) == 0
                bytes_set_u8(b, st_off_path() + base, 47)
                _c = bytes_copy(st, st_off_path() + base + 1, st_row_name_off(st, row), 0, nlen)
            else
                _c = bytes_copy(st, st_off_path() + 1, st_row_name_off(st, row), 0, nlen)
            bytes_set_i64(b, 0, new_len)
            0

fn st_rows_clear(st: Int) -> Int ! alloc
    st_set_nrows(st, 0)
    st_set_sel(st, 0)

fn st_row_push(st: Int, file_type: Int, name_ptr: Int, name_len: Int) -> Int ! alloc
    n = st_nrows(st)
    if n >= st_max_rows()
        0
    else
        if name_len > 60
            name_len = 60
        off = st_off_rows() + n * st_row_stride()
        b = bytes_view_mem(st, st_size())
        bytes_set_u8(b, off, u8(file_type))
        bytes_set_u8(b, off + 1, u8(name_len))
        _c = bytes_copy(st, off + 2, name_ptr, 0, name_len)
        st_set_nrows(st, n + 1)
        0

fn st_row_push_literal(st: Int, file_type: Int, name: String) -> Int ! alloc
    nlen = str_len(name)
    if nlen > 60
        nlen = 60
    tmp = bytes_new(nlen + 1)
    str_bytes_copy(tmp, 0, name)
    _r = st_row_push(st, file_type, bytes_ptr(tmp), nlen)
    0

fn files_reload(st: Int) -> Int ! io, alloc
    st_rows_clear(st)
    plen = st_path_len(st)
    fd = open_path_ptr(st_path_ptr(st), plen)
    if fd < 0
        st_row_push_literal(st, ft_dir(), d"(error)")
        0
    else
        dent_cap = dirent_size() * 24
        dent = bytes_new(dent_cap)
        dent_p = bytes_ptr(dent)
        got = getdents_fd(fd, dent_p, dent_cap)
        _x = close_fd(fd)
        if st_path_is_root(st) == 0
            _d = st_row_push_literal(st, ft_dir(), d"..")
        pos = 0
        while pos + dirent_size() <= got
            db = bytes_view_mem(dent_p, dent_cap)
            ft = bytes_get_u8(db, pos + dirent_off_file_type())
            nl = bytes_get_u8(db, pos + dirent_off_name_len())
            if nl > 0
                if nl <= 60
                    nm_off = pos + dirent_off_name()
                    skip = 0
                    if nl == 1
                        if bytes_get_u8(db, nm_off) == 46
                            skip = 1
                    if nl == 2
                        if bytes_get_u8(db, nm_off) == 46
                            if bytes_get_u8(db, nm_off + 1) == 46
                                skip = 1
                    if skip == 0
                        _p = st_row_push(st, ft, dent_p + nm_off, nl)
            pos = pos + dirent_size()
        if st_nrows(st) == 0
            _e = st_row_push_literal(st, ft_file(), d"(vacío)")
        0

fn files_color_bg(st: Int) -> Int ! alloc
    tema_cliente_bg(st_tema(st))

fn files_color_fg(st: Int) -> Int ! alloc
    tema_texto(st_tema(st))

fn files_color_sel(st: Int) -> Int ! alloc
    tema_menu_sel(st_tema(st))

fn files_color_dir(st: Int) -> Int ! alloc
    tema_acento(st_tema(st))

fn files_row_h(st: Int) -> Int ! alloc
    st_gh(st)

fn files_top_h(st: Int) -> Int ! alloc
    st_gh(st) + 4

fn files_texto_psf(st: Int, psf: Int, plen: Int, pix: Int, plen_pix: Int, cw: Int, ch: Int, stride: Int, bpp: Int, fmt: Int, s: String, x: Int, y: Int, fg: Int, bg: Int) -> Int ! alloc
    gw = st_gw(st)
    n = str_len(s)
    j = 0
    while j < n
        _d = fuente_dibujar(psf, plen, pix, plen_pix, stride, bpp, fmt, str_char(s, j), fg, bg, x + j * gw, y)
        j = j + 1
    0

fn files_texto_bytes(st: Int, psf: Int, plen: Int, pix: Int, plen_pix: Int, cw: Int, ch: Int, stride: Int, bpp: Int, fmt: Int, txt: Int, n: Int, x: Int, y: Int, fg: Int, bg: Int) -> Int ! alloc
    gw = st_gw(st)
    j = 0
    while j < n
        if j < cw * gw
            b = bytes_view_mem(txt, n)
            cp = bytes_get_u8(b, j)
            if cp != 0
                _d = fuente_dibujar(psf, plen, pix, plen_pix, stride, bpp, fmt, cp, fg, bg, x + j * gw, y)
        j = j + 1
    0

fn files_pintar(st: Int, psf: Int, plen: Int, pix: Int, plen_pix: Int, cw: Int, ch: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc
    bg = files_color_bg(st)
    fg = files_color_fg(st)
    gw = st_gw(st)
    gh = st_gh(st)
    _f = rellenar_rect(pix, plen_pix, cw, ch, stride, bpp, fmt, 0, 0, cw, ch, bg)
    path_s = d"/"
    if st_path_is_root(st) == 0
        tmp = bytes_new(st_path_len(st) + 1)
        _c = bytes_copy(bytes_ptr(tmp), 0, st, st_off_path(), st_path_len(st))
        _t = files_texto_bytes(st, psf, plen, pix, plen_pix, cw, ch, stride, bpp, fmt, bytes_ptr(tmp), st_path_len(st), gw, 2, fg, bg)
    else
        _t0 = files_texto_psf(st, psf, plen, pix, plen_pix, cw, ch, stride, bpp, fmt, d"/", gw, 2, fg, bg)
    sel = st_sel(st)
    n = st_nrows(st)
    row_h = files_row_h(st)
    top_h = files_top_h(st)
    i = 0
    while i < n
        y = top_h + i * row_h
        if y + row_h <= ch
            row_bg = bg
            if i == sel
                cap_x0 = gw
                cap_x1 = cw - gw
                _c = rellenar_rect_redondeado(pix, plen_pix, cw, ch, stride, bpp, fmt, cap_x0, y + 1, cap_x1, y + row_h - 1, metrica_radio(gh), files_color_sel(st))
                row_bg = files_color_sel(st)
            else
                _r = rellenar_rect(pix, plen_pix, cw, ch, stride, bpp, fmt, 0, y, cw, y + row_h, row_bg)
            nlen = st_row_nlen(st, i)
            ft = st_row_type(st, i)
            row_fg = fg
            if ft == ft_dir()
                row_fg = files_color_dir(st)
            px = gw
            if ft == ft_dir()
                _p = files_texto_psf(st, psf, plen, pix, plen_pix, cw, ch, stride, bpp, fmt, d"[", px, y + 2, row_fg, row_bg)
                px = px + gw
            _n = files_texto_bytes(st, psf, plen, pix, plen_pix, cw, ch, stride, bpp, fmt, st_row_name_off(st, i), nlen, px, y + 2, row_fg, row_bg)
            if ft == ft_dir()
                _q = files_texto_psf(st, psf, plen, pix, plen_pix, cw, ch, stride, bpp, fmt, d"]", px + nlen * gw, y + 2, row_fg, row_bg)
        i = i + 1
    0

fn files_danio(sock: Int, cw: Int, ch: Int) -> Int ! io, alloc
    md = msg_nuevo()
    _d = msg_encode_danio(md, 0, 0, cw, ch)
    write_fd(sock, md, msg_len())

fn files_row_at_y(st: Int, y: Int) -> Int ! alloc
    if y < files_top_h(st)
        -1
    else
        r = (y - files_top_h(st)) / files_row_h(st)
        if r < 0
            -1
        else
            if r >= st_nrows(st)
                -1
            else
                r

fn files_activate(st: Int, row: Int) -> Int ! io, alloc
    if row < 0
        0
    else
        if row >= st_nrows(st)
            0
        else
            nlen = st_row_nlen(st, row)
            if nlen == 2
                b = bytes_view_mem(st_row_name_off(st, row), 2)
                if bytes_get_u8(b, 0) == 46
                    if bytes_get_u8(b, 1) == 46
                        _p = st_path_go_parent(st)
                        _l = files_reload(st)
                        st_set_sel(st, 0)
                        1
            ft = st_row_type(st, row)
            if ft == ft_dir()
                _j = st_path_join_row(st, row)
                _l2 = files_reload(st)
                st_set_sel(st, 0)
                1
            0

fn files_on_tecla(st: Int, key: Int) -> Int ! io, alloc
    esc = st_esc(st)
    if esc == 1
        if key == 91
            st_set_esc(st, 2)
        else
            st_set_esc(st, 0)
        0
    elsif esc == 2
        st_set_esc(st, 0)
        n = st_nrows(st)
        sel = st_sel(st)
        if key == 65
            if sel > 0
                st_set_sel(st, sel - 1)
            1
        elsif key == 66
            if sel + 1 < n
                st_set_sel(st, sel + 1)
            1
        else
            0
    else
        if key == 27
            st_set_esc(st, 1)
            0
        else
            chg = 0
            n = st_nrows(st)
            sel = st_sel(st)
            if key == 10
                chg = files_activate(st, sel)
            if key == 13
                chg = files_activate(st, sel)
            if key == 106
                if sel + 1 < n
                    st_set_sel(st, sel + 1)
                chg = 1
            if key == 107
                if sel > 0
                    st_set_sel(st, sel - 1)
                chg = 1
            chg

fn files_on_raton(st: Int, x: Int, y: Int, botones: Int) -> Int ! io, alloc
    if botones == 0
        0
    else
        row = files_row_at_y(st, y)
        if row < 0
            0
        else
            st_set_sel(st, row)
            files_activate(st, row)
            1

fn files_bucle(sock: Int, st: Int, psf: Int, plen: Int, pix: Int, plen_pix: Int, cw: Int, ch: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    vivo = 1
    while vivo != 0
        _p = files_pintar(st, psf, plen, pix, plen_pix, cw, ch, stride, bpp, fmt)
        _d = files_danio(sock, cw, ch)
        m = msg_nuevo()
        n = read_timeout_fd(sock, m, msg_len(), 100)
        if n == 0
            vivo = 0
        if n > 0
            if n == msg_len()
                op = msg_get_op(m)
                repint = 0
                if op == op_tecla()
                    k = msg_get_u32(m, 4)
                    repint = files_on_tecla(st, k)
                if op == op_raton()
                    rx = msg_get_u32(m, 4)
                    ry = msg_get_u32(m, 8)
                    btn = msg_get_u32(m, 12)
                    repint = files_on_raton(st, rx, ry, btn)
                if op == op_tema()
                    _tm = st_set_tema(st, msg_get_u32(m, 4))
                    repint = 1
                if op == op_escala()
                    nv = msg_get_u32(m, 4)
                    _n = st_set_nivel(st, nv)
                    _gw = st_set_gw(st, msg_get_u32(m, 8))
                    _gh = st_set_gh(st, msg_get_u32(m, 12))
                    repint = 1
                if op == op_cerrar_wm()
                    vivo = 0
                if op == op_redim()
                    vivo = 0
                if repint == 0
                    _p2 = files_pintar(st, psf, plen, pix, plen_pix, cw, ch, stride, bpp, fmt)
                    _d2 = files_danio(sock, cw, ch)
    0

fn files_wm_conectar() -> Int ! io, alloc
    tcp_connect(7430, 5000)

fn main() -> Int ! io, alloc
    sock = files_wm_conectar()
    if sock < 0
        1
    else
        m = msg_nuevo()
        _h = msg_encode_hola(m, 1)
        _w = write_fd(sock, m, msg_len())
        m2 = msg_nuevo()
        _c = msg_encode_crear(m2, 520, 400, 0)
        _w2 = write_fd(sock, m2, msg_len())
        rep = msg_nuevo()
        n = read_fd(sock, rep, msg_len())
        if n != msg_len()
            2
        else
            if msg_get_op(rep) != op_ventana()
                3
            else
                sid = msg_get_u32(rep, 8)
                cw = msg_get_u32(rep, 12)
                ch = msg_get_u32(rep, 16)
                ptr = shm_map(sid)
                if ptr < 0
                    4
                else
                    slen = cw * ch * 4
                    stride = cw
                    bpp = 4
                    fmt = msg_get_u32(rep, 20)
                    tema = msg_get_u32(rep, 24)
                    nivel = msg_get_u32(rep, 28)
                    st = bytes_ptr(bytes_new(st_size()))
                    _te = st_set_tema(st, tema)
                    _nv = st_set_nivel(st, nivel)
                    _gw0 = st_set_gw(st, fuente_gw(nivel))
                    _gh0 = st_set_gh(st, fuente_gh(nivel))
                    if argc() > 1
                        _ps = st_path_set_str(st, argv(1))
                    else
                        _pr = st_path_set_str(st, d"/")
                    _ld = files_reload(st)
                    psf_s = read_file(fuente_ruta(nivel))
                    psf_n = str_len(psf_s)
                    psf_buf = bytes_new(psf_n + 1)
                    str_bytes_copy(psf_buf, 0, psf_s)
                    psf = bytes_ptr(psf_buf)
                    _loop = files_bucle(sock, st, psf, psf_n, ptr, slen, cw, ch, stride, bpp, fmt)
                    _x = close_fd(sock)
                    0
