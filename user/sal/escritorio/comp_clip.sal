import "mate.sal"
import "comp_proto.sal"

fn comp_intersect_x0(a0: Int, b0: Int) -> Int
    if a0 > b0
        a0
    else
        b0

fn comp_intersect_len(a0: Int, a1: Int, b0: Int, b1: Int) -> Int
    x0 = comp_intersect_x0(a0, b0)
    x1 = a1
    if b1 < a1
        x1 = b1
    if x1 <= x0
        0
    else
        x1 - x0

fn comp_rect_contains(ox: Int, oy: Int, ow: Int, oh: Int, ix: Int, iy: Int, iw: Int, ih: Int) -> Int
    ok = 1
    if ox > ix
        ok = 0
    if oy > iy
        ok = 0
    if ox + ow < ix + iw
        ok = 0
    if oy + oh < iy + ih
        ok = 0
    ok

fn comp_flag_hidden(fl: Int) -> Int
    if mod_pos(fl, 2) == 1
        1
    else
        0

fn comp_flag_opaque(fl: Int) -> Int
    if mod_pos(fl, 4) >= 2
        1
    else
        0

fn comp_surf_visible(fl: Int) -> Int
    if comp_flag_hidden(fl) != 0
        0
    else
        1

fn comp_surf_opaque(fl: Int) -> Int
    comp_flag_opaque(fl)
