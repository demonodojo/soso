# ---- Título y acumulador de mensajes ----------------------------------------

method Tabla.titulo_set(&mut self, i: Int, titulo: String) -> Int ! alloc
    p = list_get(&mut self.ps, i)
    j = 0
    n = str_len(titulo)
    while j < 32
        ch = 32
        if j < n
            ch = str_char(titulo, j)
        p.titulo.set_u8(j, ch)
        j = j + 1
    0

method Tabla.titulo_desde_msg(&mut self, i: Int, msg: Int) -> Int ! alloc
    src = bytes_view_mem(msg, 32)
    p = list_get(&mut self.ps, i)
    j = 0
    while j < 16
        p.titulo.set_u8(j, src.get_u8(16 + j))
        j = j + 1
    while j < 32
        p.titulo.set_u8(j, 32)
        j = j + 1
    0

method Tabla.titulo_byte(&mut self, i: Int, j: Int) -> Int
    p = list_get(&mut self.ps, i)
    p.titulo.get_u8(j)

method Tabla.acc_reset(&mut self, i: Int) -> Int
    p = list_get(&mut self.ps, i)
    p.acc_len = 0
    0

method Tabla.acc_push_byte(&mut self, i: Int, b: Int) -> Int
    p = list_get(&mut self.ps, i)
    if p.acc_len >= 32
        -1
    else
        p.acc.set_u8(p.acc_len, u8(b))
        p.acc_len = p.acc_len + 1
        p.acc_len

method Tabla.acc_copiar_msg(&mut self, i: Int, dst: Int) -> Int ! alloc
    p = list_get(&mut self.ps, i)
    if p.acc_len < 32
        0
    else
        dview = bytes_view_mem(dst, 32)
        _c = bytes_copy(dview, 0, p.acc, 0, 32)
        p.acc_len = 0
        32

# ---- Grupos y pestañas -------------------------------------------------------

method Tabla.slot_activo(&mut self, i: Int) -> Int
    if i < 0
        0
    elsif i >= tab_cap()
        0
    elsif self.tipo(i) == tab_tipo_libre()
        0
    else
        1

method Tabla.buscar_libre(&mut self) -> Int
    i = 0
    found = -1
    while i < tab_cap()
        if found < 0
            if self.tipo(i) == tab_tipo_libre()
                found = i
        i = i + 1
    found

method Tabla.guardar_float(&mut self, i: Int) -> Int
    _x = self.set_fwx(i, self.wx(i))
    _y = self.set_fwy(i, self.wy(i))
    _w = self.set_fww(i, self.ww(i))
    _h = self.set_fwh(i, self.wh(i))
    0

method Tabla.restaurar_float(&mut self, i: Int) -> Int
    fw = self.fww(i)
    if fw > 0
        _x = self.set_wx(i, self.fwx(i))
        _y = self.set_wy(i, self.fwy(i))
        _w = self.set_ww(i, fw)
        _h = self.set_wh(i, self.fwh(i))
    0

method Tabla.contar_tipo(&mut self, tipo: Int) -> Int
    i = 0
    n = 0
    while i < tab_cap()
        if self.tipo(i) == tipo
            n = n + 1
        i = i + 1
    n


