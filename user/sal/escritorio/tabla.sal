    0

# Paneles del grupo cuya cabecera es `cab`.
method Tabla.grupo_n(&mut self, cab: Int) -> Int
    n = 0
    i = 0
    while i < tab_cap()
        if self.tipo(i) != tab_tipo_libre()
            if self.cab(i) == cab
                n = n + 1
        i = i + 1
    n

# k-ésimo panel del grupo en orden de pestañas (orden, y a igualdad el índice), o -1.
method Tabla.grupo_miembro(&mut self, cab: Int, k: Int) -> Int
    r = -1
    i = 0
    while i < tab_cap()
        if self.tipo(i) != tab_tipo_libre()
            if self.cab(i) == cab
                menores = 0
                j = 0
                while j < tab_cap()
                    if self.tipo(j) != tab_tipo_libre()
                        if self.cab(j) == cab
                            if j != i
                                oj = self.orden(j)
                                oi = self.orden(i)
                                if oj < oi
                                    menores = menores + 1
                                elsif oj == oi
                                    if j < i
                                        menores = menores + 1
                    j = j + 1
                if menores == k
                    r = i
        i = i + 1
    r

# Posición (0..n-1) del panel `i` en la tira de su grupo.
method Tabla.grupo_pos(&mut self, i: Int) -> Int
    cab = self.cab(i)
    n = self.grupo_n(cab)
    r = -1
    k = 0
    while k < n
        if self.grupo_miembro(cab, k) == i
            r = k
        k = k + 1
    r

method Tabla.grupo_orden_max(&mut self, cab: Int) -> Int
    m = -1
    i = 0
    while i < tab_cap()
        if self.tipo(i) != tab_tipo_libre()
            if self.cab(i) == cab
                m = max(m, self.orden(i))
        i = i + 1
    m

# Panel activo del grupo al que pertenece `i`.
method Tabla.grupo_panel_activo(&mut self, i: Int) -> Int
    h = self.cab(i)
    a = self.activo(h)
    if a == 0
        h
    else
        if self.cab(a - 1) == h
            a - 1
        else
            h

method Tabla.grupo_activar(&mut self, i: Int) -> Int
    h = self.cab(i)
    if i == h
        self.set_activo(h, 0)
    else
        self.set_activo(h, i + 1)

# Saca el panel `i` de su grupo y lo deja como ventana propia con la misma geometría.
# Devuelve 1 si había algo que separar.
method Tabla.grupo_separar(&mut self, i: Int) -> Int
    h = self.cab(i)
    if self.grupo_n(h) <= 1
        0
    else
        act = self.grupo_panel_activo(i)
        if h == i
            nh = -1
            k = 0
            while k < tab_cap()
                if nh < 0
                    if k != i
                        if self.tipo(k) != tab_tipo_libre()
                            if self.cab(k) == h
                                nh = k
                k = k + 1
            _g = self.copiar_geom(h, nh)
            k = 0
            while k < tab_cap()
                if k != i
                    if self.tipo(k) != tab_tipo_libre()
                        if self.cab(k) == h
                            if k == nh
                                _a = self.set_cab(k, 0)
                            else
                                _b = self.set_cab(k, nh + 1)
                k = k + 1
            if act == i
                _c = self.set_activo(nh, 0)
            else
                _d = self.set_activo(nh, act + 1)
            _e = self.set_activo(i, 0)
        else
            _g = self.copiar_geom(h, i)
            _c = self.set_cab(i, 0)
            _v = self.set_activo(i, 0)
            if act == i
                _x = self.set_activo(h, 0)
        1

# Integra el panel `i` (y, si es cabecera de un grupo, todo su grupo) al final del
# grupo de `dest`, conservando su orden relativo; el integrado pasa a ser el activo.
method Tabla.grupo_integrar(&mut self, i: Int, dest: Int) -> Int
    h0 = self.cab(i)
    d = self.cab(dest)
    if h0 == d
        0
    else
        if h0 != i
            _sp = self.grupo_separar(i)
        h = self.cab(i)
        n = self.grupo_n(h)
        base = self.grupo_orden_max(d) + 1
        j = 0
        while j < n
            m = self.grupo_miembro(h, 0)
            _a = self.set_cab(m, d + 1)
            _b = self.set_activo(m, 0)
            _c = self.set_orden(m, base + j)
            j = j + 1
        _e = self.set_activo(d, i + 1)
        1

# Mueve el panel `i` a la posición `kpos` (0..n-1) de la tira de su grupo; renumera.
method Tabla.grupo_mover(&mut self, i: Int, kpos: Int) -> Int ! alloc
    cab = self.cab(i)
    n = self.grupo_n(cab)
    pos = self.grupo_pos(i)
    kp = kpos
    if kp < 0
        kp = 0
    if kp > n - 1
        kp = n - 1
    if n <= 1
        0
    elsif pos == kp
        0
    else
        ord = list_new[Int]()
        j = 0
        d = 0
        while j < n
            if j == kp
                _s1 = list_push(&mut ord, i)
            else
                m = self.grupo_miembro(cab, d)
                if m == i
                    d = d + 1
                    m = self.grupo_miembro(cab, d)
                _s2 = list_push(&mut ord, m)
                d = d + 1
            j = j + 1
        j = 0
        while j < n
            _o = self.set_orden(list_get(&ord, j), j)
            j = j + 1
        1

method Tabla.cerrar_slot(&mut self, i: Int) -> Int ! io, alloc
    if self.slot_activo(i) == 0
        0
    else
        fd = self.fd(i)
        if fd > 0
            _c = close_fd(fd)
        sid = self.shm_id(i)
        if sid > 0
            _f = shm_free(sid)
        _g = self.grupo_separar(i)
        _z = self.set_tipo(i, tab_tipo_libre())
        _a = self.set_fd(i, 0)
        _p = self.set_pid(i, 0)
        _s = self.set_shm_id(i, 0)
        _m = self.set_fase(i, 0)
        _l = self.set_acc_len(i, 0)
        _e = self.set_estado(i, 0)
        _c = self.set_cab(i, 0)
        _v = self.set_activo(i, 0)
        _o = self.set_orden(i, 0)
        _ap = self.set_app(i, 0)
        _vv = self.set_vis(i, 0)
        _pp = self.set_pend(i, 0)
        1

# ---- Z-order -----------------------------------------------------------------

method Tabla.z_get(&mut self, k: Int) -> Int
    list_get(&mut self.z, k)

method Tabla.z_set(&mut self, k: Int, v: Int) -> Int
    list_set(&mut self.z, k, v)
    0

method Tabla.nz(&mut self) -> Int
    self.nz

method Tabla.set_nz(&mut self, n: Int) -> Int
    self.nz = n
    0

method Tabla.z_subir(&mut self, n: Int, idx: Int) -> Int
    if n <= 1
        n
    else
        k = 0
        while k < n
            if self.z_get(k) == idx
                if k + 1 < n
                    otro = self.z_get(k + 1)
                    _a = self.z_set(k, otro)
                    _b = self.z_set(k + 1, idx)
            k = k + 1
        n

method Tabla.z_quitar(&mut self, n: Int, idx: Int) -> Int
    k = 0
    while k < n
        if self.z_get(k) == idx
            j = k
            while j + 1 < n
                _m = self.z_set(j, self.z_get(j + 1))
                j = j + 1
            _t = self.z_set(n - 1, -1)
            n = n - 1
        else
            k = k + 1
    n

# Sustituye `viejo` por `nuevo` en el mismo lugar del orden.
method Tabla.z_reemplazar(&mut self, n: Int, viejo: Int, nuevo: Int) -> Int
    k = 0
    while k < n
        if self.z_get(k) == viejo
            _s = self.z_set(k, nuevo)
        k = k + 1
    n

method Tabla.z_anadir(&mut self, n: Int, idx: Int) -> Int
    if n >= tab_cap()
        n
    else
        _a = self.z_set(n, idx)
        n + 1

# ---- Estado del terminal del panel -------------------------------------------

method Tabla.term_nuevo(&mut self, i: Int, cols: Int, rows: Int) -> Int ! alloc
    p = list_get(&mut self.ps, i)
    p.term = Term.new(cols, rows)
    p.term_pos = 0
    0

method Tabla.term_dirty(&mut self, i: Int) -> Int
    p = list_get(&mut self.ps, i)
    p.term.dirty

method Tabla.term_set_dirty(&mut self, i: Int, v: Int) -> Int
    p = list_get(&mut self.ps, i)
    p.term.dirty = v
    0

method Tabla.term_cols(&mut self, i: Int) -> Int
    p = list_get(&mut self.ps, i)
    p.term.cols

method Tabla.term_rows(&mut self, i: Int) -> Int
    p = list_get(&mut self.ps, i)
    p.term.rows

method Tabla.term_cursor(&mut self, i: Int) -> Int
    p = list_get(&mut self.ps, i)
    p.term.cursor

method Tabla.term_pintar(&mut self, i: Int, grid: Int, glen: Int, cols: Int, rows: Int, psf: Int, psflen: Int, gw: Int, gh: Int, tema: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int, ox: Int, oy: Int, force: Int) -> Int ! alloc
    p = list_get(&mut self.ps, i)
    p.term.pintar(grid, glen, cols, rows, psf, psflen, gw, gh, tema, compos, clen, sw, sh, stride, bpp, fmt, ox, oy, force)

method Tabla.term_redimensionar(&mut self, i: Int, ptr: Int, len: Int, ow: Int, oh: Int, nw: Int, nh: Int) -> Bytes ! alloc
    p = list_get(&mut self.ps, i)
    p.term.redimensionar(ptr, len, ow, oh, nw, nh)

method Tabla.term_feed_byte(&mut self, i: Int, ptr: Int, len: Int, w: Int, h: Int, byte: Int) -> Int ! alloc
    p = list_get(&mut self.ps, i)
    p.term.feed_byte(ptr, len, w, h, byte)
