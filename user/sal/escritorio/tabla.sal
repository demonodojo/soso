method Tabla.copiar_geom(&mut self, de: Int, a: Int) -> Int
    _a = self.set_wx_raw(a, self.wx(de))
    _b = self.set_wy_raw(a, self.wy(de))
    _c = self.set_ww_raw(a, self.ww(de))
    _d = self.set_wh_raw(a, self.wh(de))
    _e = self.set_fwx_raw(a, self.fwx(de))
    _f = self.set_fwy_raw(a, self.fwy(de))
    _g = self.set_fww_raw(a, self.fww(de))
    _h = self.set_fwh_raw(a, self.fwh(de))
    _i = self.set_estado_raw(a, self.estado(de))
    _j = self.set_sx_raw(a, self.sx(de))
    _k = self.set_sy_raw(a, self.sy(de))
    _l = self.set_sw_raw(a, self.sw(de))
    _m = self.set_sh_raw(a, self.sh(de))
    0

method Tabla.set_cab(&mut self, i: Int, v: Int) -> Int
    p = list_get(&mut self.ps, i)
    p.cab = v
    0

