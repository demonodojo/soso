import "mate.sal"

fn fmt_rgb() -> Int
    0

fn fmt_bgr() -> Int
    1

fn pix_idx(stride_px: Int, bpp: Int, x: Int, y: Int) -> Int
    (y * stride_px + x) * bpp

fn color_rgb(r: Int, g: Int, b: Int) -> Int
    u8(r) * 65536 + u8(g) * 256 + u8(b)

fn mezclar_rgb(a: Int, b: Int, alfa: Int) -> Int
    if alfa <= 0
        b
    elsif alfa >= 255
        a
    else
        inv = 255 - alfa
        r = (u8(u32_b2(a)) * alfa + u8(u32_b2(b)) * inv) / 255
        g = (u8(u32_b1(a)) * alfa + u8(u32_b1(b)) * inv) / 255
        bb = (u8(u32_b0(a)) * alfa + u8(u32_b0(b)) * inv) / 255
        color_rgb(r, g, bb)

fn color_interp(a: Int, b: Int, t: Int, denom: Int) -> Int
    if denom <= 0
        a
    else
        inv = denom - t
        r = (u8(u32_b2(a)) * inv + u8(u32_b2(b)) * t) / denom
        g = (u8(u32_b1(a)) * inv + u8(u32_b1(b)) * t) / denom
        bb = (u8(u32_b0(a)) * inv + u8(u32_b0(b)) * t) / denom
        color_rgb(r, g, bb)

fn pixel_leer(ptr: Int, len: Int, stride: Int, bpp: Int, fmt: Int, x: Int, y: Int) -> Int ! alloc
    if bpp != 4
        0
    else
        b = bytes_view_mem(ptr, len)
        o = pix_idx(stride, bpp, x, y)
        if fmt == fmt_bgr()
            bb = bytes_get_u8(b, o)
            gg = bytes_get_u8(b, o + 1)
            rr = bytes_get_u8(b, o + 2)
            color_rgb(rr, gg, bb)
        else
            rr = bytes_get_u8(b, o)
            gg = bytes_get_u8(b, o + 1)
            bb = bytes_get_u8(b, o + 2)
            color_rgb(rr, gg, bb)

fn pixel_escribir(ptr: Int, len: Int, stride: Int, bpp: Int, fmt: Int, x: Int, y: Int, rgb: Int) -> Int ! alloc
    if bpp != 4
        0
    elsif fmt == fmt_bgr()
        b = bytes_view_mem(ptr, len)
        o = pix_idx(stride, bpp, x, y)
        r = u32_b2(rgb)
        g = u32_b1(rgb)
        bb = u32_b0(rgb)
        bytes_set_u8(b, o, bb)
        bytes_set_u8(b, o + 1, g)
        bytes_set_u8(b, o + 2, r)
        bytes_set_u8(b, o + 3, 255)
        0
    else
        b = bytes_view_mem(ptr, len)
        o = pix_idx(stride, bpp, x, y)
        r = u32_b2(rgb)
        g = u32_b1(rgb)
        bb = u32_b0(rgb)
        bytes_set_u8(b, o, r)
        bytes_set_u8(b, o + 1, g)
        bytes_set_u8(b, o + 2, bb)
        bytes_set_u8(b, o + 3, 255)
        0

# Palabra de 32 bits (little-endian) con los bytes en el orden de memoria que
# usan `pixel_leer`/`pixel_escribir`: BGR guarda [b, g, r, 255]; RGB, [r, g, b, 255].
fn pixel_u32_le(rgb: Int, fmt: Int) -> Int
    if fmt == fmt_bgr()
        (255 << 24) + (u32_b2(rgb) << 16) + (u32_b1(rgb) << 8) + u32_b0(rgb)
    else
        (255 << 24) + (u32_b0(rgb) << 16) + (u32_b1(rgb) << 8) + u32_b2(rgb)

fn rellenar_rect(ptr: Int, len: Int, ancho: Int, alto: Int, stride_px: Int, bpp: Int, fmt: Int, x0: Int, y0: Int, x1: Int, y1: Int, rgb: Int) -> Int ! alloc
    ya = max(0, y0)
    yb = min(alto, y1)
    xa = max(0, x0)
    xb = min(ancho, x1)
    colb = xb - xa
    if colb <= 0
        0
    else
        v = pixel_u32_le(rgb, fmt)
        b = bytes_view_mem(ptr, len)
        y = ya
        while y < yb
            off = pix_idx(stride_px, bpp, xa, y)
            bytes_fill_u32(b, off, colb, v)
            y = y + 1
        0

fn rellenar_rect_alfa(ptr: Int, len: Int, ancho: Int, alto: Int, stride_px: Int, bpp: Int, fmt: Int, x0: Int, y0: Int, x1: Int, y1: Int, rgb: Int, alfa: Int) -> Int ! alloc
    ya = max(0, y0)
    yb = min(alto, y1)
    xa = max(0, x0)
    xb = min(ancho, x1)
    if xb <= xa
        0
    else
        y = ya
        while y < yb
            x = xa
            while x < xb
                bg = pixel_leer(ptr, len, stride_px, bpp, fmt, x, y)
                fg = mezclar_rgb(rgb, bg, alfa)
                _p = pixel_escribir(ptr, len, stride_px, bpp, fmt, x, y, fg)
                x = x + 1
            y = y + 1
        0

fn degradado_vertical(ptr: Int, len: Int, ancho: Int, alto: Int, stride_px: Int, bpp: Int, fmt: Int, x0: Int, y0: Int, x1: Int, y1: Int, arriba: Int, abajo: Int) -> Int ! alloc
    ya = max(0, y0)
    yb = min(alto, y1)
    xa = max(0, x0)
    xb = min(ancho, x1)
    h = yb - ya
    if h <= 0
        0
    else
        y = ya
        while y < yb
            t = y - ya
            c = color_interp(arriba, abajo, t, h - 1)
            _r = rellenar_rect(ptr, len, ancho, alto, stride_px, bpp, fmt, xa, y, xb, y + 1, c)
            y = y + 1
        0

fn rect_esquina_redonda_ok(x: Int, y: Int, x0: Int, y0: Int, x1: Int, y1: Int, radio: Int, esq: Int) -> Int
    if radio <= 0
        1
    else
        ok = 1
        if esq == 0
            cx = x0 + radio
            cy = y0 + radio
            if x < x0 + radio
                if y < y0 + radio
                    dx = cx - x
                    dy = cy - y
                    if dx * dx + dy * dy > radio * radio
                        ok = 0
        if esq == 1
            cx = x1 - radio
            cy = y0 + radio
            if x >= x1 - radio
                if y < y0 + radio
                    dx = x - cx
                    dy = cy - y
                    if dx * dx + dy * dy > radio * radio
                        ok = 0
        if esq == 2
            cx = x0 + radio
            cy = y1 - radio
            if x < x0 + radio
                if y >= y1 - radio
                    dx = cx - x
                    dy = y - cy
                    if dx * dx + dy * dy > radio * radio
                        ok = 0
        if esq == 3
            cx = x1 - radio
            cy = y1 - radio
            if x >= x1 - radio
                if y >= y1 - radio
                    dx = x - cx
                    dy = y - cy
                    if dx * dx + dy * dy > radio * radio
                        ok = 0
        ok

# Píxeles que se saltan por lado en la fila `d` (0 = la del borde) de una esquina de radio `radio`.
fn rr_inset(radio: Int, d: Int) -> Int
    k = 0
    if d < radio
        dy = radio - d
        seguir = 1
        while seguir != 0
            if k >= radio
                seguir = 0
            else
                dx = radio - k
                if dx * dx + dy * dy > radio * radio
                    k = k + 1
                else
                    seguir = 0
    k

# Rectángulo con las esquinas de arriba redondeadas. Por filas: sólo las `radio`
# filas de la esquina necesitan cálculo; el resto es un único relleno.
fn rellenar_rect_redondeado(ptr: Int, len: Int, ancho: Int, alto: Int, stride_px: Int, bpp: Int, fmt: Int, x0: Int, y0: Int, x1: Int, y1: Int, radio: Int, rgb: Int) -> Int ! alloc
    r = min(radio, min((x1 - x0) / 2, y1 - y0))
    if r <= 0
        rellenar_rect(ptr, len, ancho, alto, stride_px, bpp, fmt, x0, y0, x1, y1, rgb)
    else
        d = 0
        while d < r
            k = rr_inset(r, d)
            _f = rellenar_rect(ptr, len, ancho, alto, stride_px, bpp, fmt, x0 + k, y0 + d, x1 - k, y0 + d + 1, rgb)
            d = d + 1
        rellenar_rect(ptr, len, ancho, alto, stride_px, bpp, fmt, x0, y0 + r, x1, y1, rgb)

# Igual con las cuatro esquinas redondeadas.
fn rellenar_rect_redondeado4(ptr: Int, len: Int, ancho: Int, alto: Int, stride_px: Int, bpp: Int, fmt: Int, x0: Int, y0: Int, x1: Int, y1: Int, radio: Int, rgb: Int) -> Int ! alloc
    r = min(radio, min((x1 - x0) / 2, (y1 - y0) / 2))
    if r <= 0
        rellenar_rect(ptr, len, ancho, alto, stride_px, bpp, fmt, x0, y0, x1, y1, rgb)
    else
        d = 0
        while d < r
            k = rr_inset(r, d)
            _a = rellenar_rect(ptr, len, ancho, alto, stride_px, bpp, fmt, x0 + k, y0 + d, x1 - k, y0 + d + 1, rgb)
            _b = rellenar_rect(ptr, len, ancho, alto, stride_px, bpp, fmt, x0 + k, y1 - 1 - d, x1 - k, y1 - d, rgb)
            d = d + 1
        rellenar_rect(ptr, len, ancho, alto, stride_px, bpp, fmt, x0, y0 + r, x1, y1 - r, rgb)

# Capa de sombra: el rectángulo expandido (ex0..ey1) menos la ventana (wx0..wy1), en cuatro tiras.
fn sombra_anillo(ptr: Int, len: Int, ancho: Int, alto: Int, stride_px: Int, bpp: Int, fmt: Int, ex0: Int, ey0: Int, ex1: Int, ey1: Int, wx0: Int, wy0: Int, wx1: Int, wy1: Int, rgb: Int, alfa: Int) -> Int ! alloc
    _a = rellenar_rect_alfa(ptr, len, ancho, alto, stride_px, bpp, fmt, ex0, ey0, ex1, wy0, rgb, alfa)
    _b = rellenar_rect_alfa(ptr, len, ancho, alto, stride_px, bpp, fmt, ex0, wy1, ex1, ey1, rgb, alfa)
    _c = rellenar_rect_alfa(ptr, len, ancho, alto, stride_px, bpp, fmt, ex0, wy0, wx0, wy1, rgb, alfa)
    _d = rellenar_rect_alfa(ptr, len, ancho, alto, stride_px, bpp, fmt, wx1, wy0, ex1, wy1, rgb, alfa)
    0

fn copiar_rect(dptr: Int, dlen: Int, dstride_px: Int, sptr: Int, slen: Int, sstride_px: Int, bpp: Int, fmt: Int, dx: Int, dy: Int, sx: Int, sy: Int, w: Int, h: Int) -> Int ! alloc
    if w <= 0
        0
    else
        if h <= 0
            0
        else
            dview = bytes_view_mem(dptr, dlen)
            sview = bytes_view_mem(sptr, slen)
            row = 0
            nb = w * bpp
            while row < h
                doff = pix_idx(dstride_px, bpp, dx, dy + row)
                soff = pix_idx(sstride_px, bpp, sx, sy + row)
                bytes_copy(dview, doff, sview, soff, nb)
                row = row + 1
            0
