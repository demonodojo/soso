import "mate.sal"

fn fmt_rgb() -> Int
    0

fn fmt_bgr() -> Int
    1

fn pix_idx(stride_px: Int, bpp: Int, x: Int, y: Int) -> Int
    (y * stride_px + x) * bpp

fn color_rgb(r: Int, g: Int, b: Int) -> Int
    u8(r) * 65536 + u8(g) * 256 + u8(b)

fn mezclar_rgb(a: Int, b: Int, alfa: Int) -> Int
    if alfa <= 0
        b
    elsif alfa >= 255
        a
    else
        inv = 255 - alfa
        r = (u8(u32_b2(a)) * alfa + u8(u32_b2(b)) * inv) / 255
        g = (u8(u32_b1(a)) * alfa + u8(u32_b1(b)) * inv) / 255
        bb = (u8(u32_b0(a)) * alfa + u8(u32_b0(b)) * inv) / 255
        color_rgb(r, g, bb)

fn color_interp(a: Int, b: Int, t: Int, denom: Int) -> Int
    if denom <= 0
        a
    else
        inv = denom - t
        r = (u8(u32_b2(a)) * inv + u8(u32_b2(b)) * t) / denom
        g = (u8(u32_b1(a)) * inv + u8(u32_b1(b)) * t) / denom
        bb = (u8(u32_b0(a)) * inv + u8(u32_b0(b)) * t) / denom
        color_rgb(r, g, bb)

fn pixel_leer(ptr: Int, len: Int, stride: Int, bpp: Int, fmt: Int, x: Int, y: Int) -> Int ! alloc
    if bpp != 4
        0
    else
        b = bytes_view_mem(ptr, len)
        o = pix_idx(stride, bpp, x, y)
        if fmt == fmt_bgr()
            bb = bytes_get_u8(b, o)
            gg = bytes_get_u8(b, o + 1)
            rr = bytes_get_u8(b, o + 2)
            color_rgb(rr, gg, bb)
        else
            rr = bytes_get_u8(b, o)
            gg = bytes_get_u8(b, o + 1)
            bb = bytes_get_u8(b, o + 2)
            color_rgb(rr, gg, bb)

fn pixel_escribir(ptr: Int, len: Int, stride: Int, bpp: Int, fmt: Int, x: Int, y: Int, rgb: Int) -> Int ! alloc
    if bpp != 4
        0
    elsif fmt == fmt_bgr()
        b = bytes_view_mem(ptr, len)
        o = pix_idx(stride, bpp, x, y)
        r = u32_b2(rgb)
        g = u32_b1(rgb)
        bb = u32_b0(rgb)
        bytes_set_u8(b, o, bb)
        bytes_set_u8(b, o + 1, g)
        bytes_set_u8(b, o + 2, r)
        bytes_set_u8(b, o + 3, 255)
        0
    else
        b = bytes_view_mem(ptr, len)
        o = pix_idx(stride, bpp, x, y)
        r = u32_b2(rgb)
        g = u32_b1(rgb)
        bb = u32_b0(rgb)
        bytes_set_u8(b, o, r)
        bytes_set_u8(b, o + 1, g)
        bytes_set_u8(b, o + 2, bb)
        bytes_set_u8(b, o + 3, 255)
        0

fn pixel_u32_le(rgb: Int, fmt: Int) -> Int
    if fmt == fmt_bgr()
        (255 << 24) + (u32_b0(rgb) << 16) + (u32_b1(rgb) << 8) + u32_b2(rgb)
    else
        (255 << 24) + (u32_b2(rgb) << 16) + (u32_b1(rgb) << 8) + u32_b0(rgb)

fn rellenar_rect(ptr: Int, len: Int, ancho: Int, alto: Int, stride_px: Int, bpp: Int, fmt: Int, x0: Int, y0: Int, x1: Int, y1: Int, rgb: Int) -> Int ! alloc
    ya = max(0, y0)
    yb = min(alto, y1)
    xa = max(0, x0)
    xb = min(ancho, x1)
    colb = xb - xa
    if colb <= 0
        0
    else
        v = pixel_u32_le(rgb, fmt)
        b = bytes_view_mem(ptr, len)
        y = ya
        while y < yb
            off = pix_idx(stride_px, bpp, xa, y)
            bytes_fill_u32(b, off, colb, v)
            y = y + 1
        0

fn rellenar_rect_alfa(ptr: Int, len: Int, ancho: Int, alto: Int, stride_px: Int, bpp: Int, fmt: Int, x0: Int, y0: Int, x1: Int, y1: Int, rgb: Int, alfa: Int) -> Int ! alloc
    ya = max(0, y0)
    yb = min(alto, y1)
    xa = max(0, x0)
    xb = min(ancho, x1)
    if xb <= xa
        0
    else
        y = ya
        while y < yb
            x = xa
            while x < xb
                bg = pixel_leer(ptr, len, stride_px, bpp, fmt, x, y)
                fg = mezclar_rgb(rgb, bg, alfa)
                _p = pixel_escribir(ptr, len, stride_px, bpp, fmt, x, y, fg)
                x = x + 1
            y = y + 1
        0

fn degradado_vertical(ptr: Int, len: Int, ancho: Int, alto: Int, stride_px: Int, bpp: Int, fmt: Int, x0: Int, y0: Int, x1: Int, y1: Int, arriba: Int, abajo: Int) -> Int ! alloc
    ya = max(0, y0)
    yb = min(alto, y1)
    xa = max(0, x0)
    xb = min(ancho, x1)
    h = yb - ya
    if h <= 0
        0
    else
        y = ya
        while y < yb
            t = y - ya
            c = color_interp(arriba, abajo, t, h - 1)
            _r = rellenar_rect(ptr, len, ancho, alto, stride_px, bpp, fmt, xa, y, xb, y + 1, c)
            y = y + 1
        0

fn rect_esquina_redonda_ok(x: Int, y: Int, x0: Int, y0: Int, x1: Int, y1: Int, radio: Int, esq: Int) -> Int
    if radio <= 0
        1
    else
        ok = 1
        if esq == 0
            cx = x0 + radio
            cy = y0 + radio
            if x < x0 + radio
                if y < y0 + radio
                    dx = cx - x
                    dy = cy - y
                    if dx * dx + dy * dy > radio * radio
                        ok = 0
        if esq == 1
            cx = x1 - radio
            cy = y0 + radio
            if x >= x1 - radio
                if y < y0 + radio
                    dx = x - cx
                    dy = cy - y
                    if dx * dx + dy * dy > radio * radio
                        ok = 0
        ok

fn rellenar_rect_redondeado(ptr: Int, len: Int, ancho: Int, alto: Int, stride_px: Int, bpp: Int, fmt: Int, x0: Int, y0: Int, x1: Int, y1: Int, rgb: Int, radio: Int) -> Int ! alloc
    ya = max(0, y0)
    yb = min(alto, y1)
    xa = max(0, x0)
    xb = min(ancho, x1)
    if xb <= xa
        0
    else
        y = ya
        while y < yb
            x = xa
            while x < xb
                if rect_esquina_redonda_ok(x, y, xa, ya, xb, yb, radio, 0) != 0
                    if rect_esquina_redonda_ok(x, y, xa, ya, xb, yb, radio, 1) != 0
                        _p = pixel_escribir(ptr, len, stride_px, bpp, fmt, x, y, rgb)
                x = x + 1
            y = y + 1
        0

fn copiar_rect(dptr: Int, dlen: Int, dstride_px: Int, sptr: Int, slen: Int, sstride_px: Int, bpp: Int, fmt: Int, dx: Int, dy: Int, sx: Int, sy: Int, w: Int, h: Int) -> Int ! alloc
    if w <= 0
        0
    else
        if h <= 0
            0
        else
            dview = bytes_view_mem(dptr, dlen)
            sview = bytes_view_mem(sptr, slen)
            row = 0
            nb = w * bpp
            while row < h
                doff = pix_idx(dstride_px, bpp, dx, dy + row)
                soff = pix_idx(sstride_px, bpp, sx, sy + row)
                bytes_copy(dview, doff, sview, soff, nb)
                row = row + 1
            0
