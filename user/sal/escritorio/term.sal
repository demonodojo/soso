import "mate.sal"
import "utf8.sal"
import "fuente.sal"
import "superficie.sal"
import "tema.sal"

fn celda_bytes() -> Int
    8

fn attr_inv() -> Int
    1

fn col_default_fg() -> Int
    7

fn col_default_bg() -> Int
    0

fn term_hist_cap() -> Int
    2000

fn term_cursor_scale() -> Int
    4096

# Estado del emulador de un panel PTY. `hist` es el historial de líneas
# (`hist_cap * hist_w` celdas) y `csi` los parámetros CSI pendientes.
struct Term
    cols: Int
    rows: Int
    cursor: Int
    fg: Int
    bg: Int
    attr: Int
    mode: Int
    csi_n: Int
    csi_cur: Int
    csi: List[Int]
    utf8: Int
    dirty: Int
    hist: Bytes
    hist_w: Int
    hist_cap: Int
    hist_head: Int

init Term(cols: Int, rows: Int) ! alloc
    csi = list_new[Int]()
    i = 0
    while i < 8
        _p = list_push(&mut csi, 0)
        i = i + 1
    hw = cols * celda_bytes()
    hist = bytes_new(term_hist_cap() * hw)
    Term(cols, rows, 0, col_default_fg(), col_default_bg(), 0, 0, 0, 0,
         csi, utf8_inicio(), -1, hist, cols, term_hist_cap(), 0)

method Term.csi_param(&self, i: Int) -> Int
    list_get(&self.csi, i)

method Term.set_csi_param(&mut self, i: Int, v: Int) -> Int
    list_set(&mut self.csi, i, v)
    0

method Term.marcar_fila(&mut self, row: Int) -> Int
    if self.dirty == -1
        0
    elsif self.dirty >= 0
        if self.dirty != row
            self.dirty = -1
            0
        else
            0
    else
        self.dirty = row
        0

# Fuga intencional: capa SHM / grid del terminal (vida = panel).
fn term_capa(w: Int, h: Int) -> Int ! alloc
    bytes_ptr(bytes_new(w * h * celda_bytes()))

fn term_idx(w: Int, col: Int, row: Int) -> Int
    (row * w + col) * celda_bytes()

fn term_pack_cursor(col: Int, row: Int) -> Int
    row * term_cursor_scale() + col

fn term_cursor_col(pos: Int) -> Int
    mod_pos(pos, term_cursor_scale())

fn term_cursor_row(pos: Int) -> Int
    pos / term_cursor_scale()

fn term_paleta_rgb(i: Int) -> Int
    if i == 0
        color_rgb(0, 0, 0)
    elsif i == 1
        color_rgb(128, 0, 0)
    elsif i == 2
        color_rgb(0, 128, 0)
    elsif i == 3
        color_rgb(128, 128, 0)
    elsif i == 4
        color_rgb(0, 0, 128)
    elsif i == 5
        color_rgb(128, 0, 128)
    elsif i == 6
        color_rgb(0, 128, 128)
    elsif i == 7
        color_rgb(192, 192, 192)
    elsif i == 8
        color_rgb(128, 128, 128)
    elsif i == 9
        color_rgb(255, 0, 0)
    elsif i == 10
        color_rgb(0, 255, 0)
    elsif i == 11
        color_rgb(255, 255, 0)
    elsif i == 12
        color_rgb(0, 0, 255)
    elsif i == 13
        color_rgb(255, 0, 255)
    elsif i == 14
        color_rgb(0, 255, 255)
    else
        color_rgb(255, 255, 255)

fn term_escribir(ptr: Int, len: Int, w: Int, col: Int, row: Int, cp: Int, fg: Int, bg: Int, attr: Int) -> Int ! alloc
    if col >= 0
        if row >= 0
            if col < w
                b = bytes_view_mem(ptr, len)
                o = term_idx(w, col, row)
                _w0 = bytes_set_u32(b, o, cp)
                _w1 = bytes_set_u8(b, o + 4, u8(fg))
                _w2 = bytes_set_u8(b, o + 5, u8(bg))
                _w3 = bytes_set_u8(b, o + 6, u8(attr))
    0

fn term_leer_cp(ptr: Int, len: Int, w: Int, col: Int, row: Int) -> Int ! alloc
    b = bytes_view_mem(ptr, len)
    bytes_get_u32(b, term_idx(w, col, row))

fn term_leer_fg(ptr: Int, len: Int, w: Int, col: Int, row: Int) -> Int ! alloc
    b = bytes_view_mem(ptr, len)
    bytes_get_u8(b, term_idx(w, col, row) + 4)

fn term_leer_bg(ptr: Int, len: Int, w: Int, col: Int, row: Int) -> Int ! alloc
    b = bytes_view_mem(ptr, len)
    bytes_get_u8(b, term_idx(w, col, row) + 5)

method Term.limpiar_pantalla(&mut self, ptr: Int, len: Int, w: Int, h: Int) -> Int ! alloc
    row = 0
    while row < h
        col = 0
        while col < w
            _t = term_escribir(ptr, len, w, col, row, 32, col_default_fg(), col_default_bg(), 0)
            col = col + 1
        _m = self.marcar_fila(row)
        row = row + 1
    self.cursor = 0
    0

fn term_fila_copiar(dst: Int, dlen: Int, dw: Int, drow: Int, src: Int, slen: Int, sw: Int, srow: Int, cols: Int) -> Int ! alloc
    col = 0
    while col < cols
        cp = term_leer_cp(src, slen, sw, col, srow)
        fg = term_leer_fg(src, slen, sw, col, srow)
        bg = col_default_bg()
        attr = 0
        _t = term_escribir(dst, dlen, dw, col, drow, cp, fg, bg, attr)
        col = col + 1
    0

method Term.hist_push(&mut self, ptr: Int, len: Int, w: Int, row: Int) -> Int ! alloc
    hw = self.hist_w
    slot = mod_pos(self.hist_head, self.hist_cap)
    hlen = self.hist_cap * hw * celda_bytes()
    _c = term_fila_copiar(bytes_ptr(self.hist), hlen, hw, slot, ptr, len, w, row, w)
    self.hist_head = self.hist_head + 1
    0

method Term.scroll(&mut self, ptr: Int, len: Int, w: Int, h: Int) -> Int ! alloc
    _h = self.hist_push(ptr, len, w, 0)
    row = 1
    while row < h
        _cp = term_fila_copiar(ptr, len, w, row - 1, ptr, len, w, row, w)
        _m = self.marcar_fila(row - 1)
        row = row + 1
    col = 0
    lr = h - 1
    while col < w
        _t = term_escribir(ptr, len, w, col, lr, 32, col_default_fg(), col_default_bg(), 0)
        col = col + 1
    _ml = self.marcar_fila(lr)
    0

method Term.redimensionar(&mut self, ptr: Int, len: Int, ow: Int, oh: Int, nw: Int, nh: Int) -> Int ! alloc
    newp = term_capa(nw, nh)
    nlen = nw * nh * celda_bytes()
    mr = min(oh, nh)
    mc = min(ow, nw)
    row = 0
    while row < mr
        if mc > 0
            _cp = term_fila_copiar(newp, nlen, nw, row, ptr, len, ow, row, mc)
        row = row + 1
    row = 0
    while row < nh
        col = 0
        while col < nw
            if row >= mr
                _t = term_escribir(newp, nlen, nw, col, row, 32, col_default_fg(), col_default_bg(), 0)
            if row < mr
                if col >= mc
                    _t2 = term_escribir(newp, nlen, nw, col, row, 32, col_default_fg(), col_default_bg(), 0)
            col = col + 1
        row = row + 1
    self.cols = nw
    self.rows = nh
    self.hist_w = nw
    pos = self.cursor
    nc = min(term_cursor_col(pos), nw - 1)
    nr = min(term_cursor_row(pos), nh - 1)
    if nw <= 0
        nc = 0
    if nh <= 0
        nr = 0
    self.cursor = term_pack_cursor(nc, nr)
    self.dirty = -1
    newp

method Term.nueva_linea(&mut self, ptr: Int, len: Int, w: Int, h: Int, col: Int, row: Int) -> Int ! alloc
    nr = row + 1
    if nr >= h
        _s = self.scroll(ptr, len, w, h)
    if nr >= h
        nr = h - 1
    self.cursor = term_pack_cursor(0, nr)
    0

method Term.borrar_linea(&mut self, ptr: Int, len: Int, w: Int, h: Int, row: Int, mode: Int) -> Int ! alloc
    if mode == 0
        c = term_cursor_col(self.cursor)
        while c < w
            _t = term_escribir(ptr, len, w, c, row, 32, col_default_fg(), col_default_bg(), 0)
            c = c + 1
        _m = self.marcar_fila(row)
    if mode == 1
        c = 0
        while c < w
            _t = term_escribir(ptr, len, w, c, row, 32, col_default_fg(), col_default_bg(), 0)
            c = c + 1
        _m = self.marcar_fila(row)
    if mode >= 2
        r = 0
        while r < h
            c = 0
            while c < w
                _t = term_escribir(ptr, len, w, c, r, 32, col_default_fg(), col_default_bg(), 0)
                c = c + 1
            _m = self.marcar_fila(r)
            r = r + 1
    0

method Term.borrar_pantalla(&mut self, ptr: Int, len: Int, w: Int, h: Int, mode: Int) -> Int ! alloc
    if mode == 0
        r = term_cursor_row(self.cursor)
        _b = self.borrar_linea(ptr, len, w, h, r, 0)
    if mode == 1
        r = term_cursor_row(self.cursor)
        c = 0
        while c <= r
            _b = self.borrar_linea(ptr, len, w, h, c, 1)
            c = c + 1
    if mode >= 2
        _l = self.limpiar_pantalla(ptr, len, w, h)
    0

method Term.csi_color(&mut self, p: Int) -> Int
    if p == 0
        self.fg = col_default_fg()
        self.bg = col_default_bg()
        self.attr = 0
    if p == 7
        self.attr = self.attr | attr_inv()
    if p == 27
        self.attr = self.attr & (255 - attr_inv())
    if p == 39
        self.fg = col_default_fg()
    if p == 49
        self.bg = col_default_bg()
    if p >= 100
        if p <= 107
            self.bg = p - 100 + 8
    if p >= 90
        if p <= 97
            self.fg = p - 90 + 8
    if p >= 40
        if p <= 47
            self.bg = p - 40
    if p >= 30
        if p <= 37
            self.fg = p - 30
    0

method Term.csi_fin(&mut self, ptr: Int, len: Int, w: Int, h: Int, cmd: Int) -> Int ! alloc
    if cmd == 72
        if self.csi_n >= 2
            self.cursor = term_pack_cursor(self.csi_param(1) - 1, self.csi_param(0) - 1)
        if self.csi_n < 2
            self.cursor = 0
    if cmd == 102
        if self.csi_n >= 2
            self.cursor = term_pack_cursor(self.csi_param(1) - 1, self.csi_param(0) - 1)
        if self.csi_n < 2
            self.cursor = 0
    if cmd == 74
        m = 0
        if self.csi_n >= 1
            m = self.csi_param(0)
        _b = self.borrar_pantalla(ptr, len, w, h, m)
    if cmd == 75
        m = 0
        if self.csi_n >= 1
            m = self.csi_param(0)
        r = term_cursor_row(self.cursor)
        _b = self.borrar_linea(ptr, len, w, h, r, m)
    if cmd == 65
        n = 1
        if self.csi_n >= 1
            n = self.csi_param(0)
        pos = self.cursor
        row = max(0, term_cursor_row(pos) - n)
        self.cursor = term_pack_cursor(term_cursor_col(pos), row)
    if cmd == 66
        n = 1
        if self.csi_n >= 1
            n = self.csi_param(0)
        pos = self.cursor
        row = min(h - 1, term_cursor_row(pos) + n)
        self.cursor = term_pack_cursor(term_cursor_col(pos), row)
    if cmd == 67
        n = 1
        if self.csi_n >= 1
            n = self.csi_param(0)
        pos = self.cursor
        col = min(w - 1, term_cursor_col(pos) + n)
        self.cursor = term_pack_cursor(col, term_cursor_row(pos))
    if cmd == 68
        n = 1
        if self.csi_n >= 1
            n = self.csi_param(0)
        pos = self.cursor
        col = max(0, term_cursor_col(pos) - n)
        self.cursor = term_pack_cursor(col, term_cursor_row(pos))
    if cmd == 109
        i = 0
        n = self.csi_n
        if n == 0
            _z = self.set_csi_param(0, 0)
            n = 1
        while i < n
            _p = self.csi_color(self.csi_param(i))
            i = i + 1
    self.csi_n = 0
    self.mode = 0
    0

method Term.csi_byte(&mut self, ptr: Int, len: Int, w: Int, h: Int, b: Int) -> Int ! alloc
    if b >= 48
        if b <= 57
            cur = self.csi_cur
            if cur == 0
                cur = b - 48
            else
                cur = cur * 10 + (b - 48)
            self.csi_cur = cur
        else
            if b == 59
                n = self.csi_n
                _p = self.set_csi_param(n, self.csi_cur)
                self.csi_n = n + 1
                self.csi_cur = 0
            else
                n = self.csi_n
                if self.csi_cur > 0
                    _p = self.set_csi_param(n, self.csi_cur)
                    self.csi_n = n + 1
                _f = self.csi_fin(ptr, len, w, h, b)
    0

method Term.put_cp(&mut self, ptr: Int, len: Int, w: Int, h: Int, cp: Int) -> Int ! alloc
    pos = self.cursor
    col = term_cursor_col(pos)
    row = term_cursor_row(pos)
    fg = self.fg
    bg = self.bg
    attr = self.attr
    if cp == 10
        _n = self.nueva_linea(ptr, len, w, h, col, row)
    if cp == 13
        self.cursor = term_pack_cursor(0, row)
    if cp == 8
        nc = 0
        if col > 0
            nc = col - 1
            _t = term_escribir(ptr, len, w, nc, row, 32, fg, bg, attr)
            _m = self.marcar_fila(row)
        self.cursor = term_pack_cursor(nc, row)
    if cp == 9
        nc = col + 8 - mod_pos(col, 8)
        self.cursor = term_pack_cursor(nc, row)
    if cp != 10
        if cp != 13
            if cp != 8
                if cp != 9
                    _t = term_escribir(ptr, len, w, col, row, cp, fg, bg, attr)
                    _m = self.marcar_fila(row)
                    self.cursor = term_pack_cursor(col + 1, row)
    0

method Term.feed_byte(&mut self, ptr: Int, len: Int, w: Int, h: Int, byte: Int) -> Int ! alloc
    if self.mode == 0
        if byte == 27
            self.mode = 1
        else
            u8st = self.utf8
            if u8st == 0
                if byte < 128
                    _p = self.put_cp(ptr, len, w, h, byte)
                else
                    cp = utf8_feed(0, byte)
                    if utf8_pendiente(cp) != 0
                        self.utf8 = cp
                    else
                        _p = self.put_cp(ptr, len, w, h, cp)
            else
                cp = utf8_feed(u8st, byte)
                if cp == utf8_reempl()
                    _p = self.put_cp(ptr, len, w, h, cp)
                    self.utf8 = utf8_inicio()
                    if byte < 128
                        _q = self.put_cp(ptr, len, w, h, byte)
                else
                    if utf8_pendiente(cp) != 0
                        self.utf8 = cp
                    else
                        _p = self.put_cp(ptr, len, w, h, cp)
                        self.utf8 = utf8_inicio()
    elsif self.mode == 1
        if byte == 91
            self.mode = 2
            self.csi_n = 0
            self.csi_cur = 0
        else
            self.mode = 0
    else
        _e = self.csi_byte(ptr, len, w, h, byte)
    0

method Term.pintar(&mut self, grid: Int, glen: Int, cols: Int, rows: Int, psf: Int, psflen: Int, gw: Int, gh: Int, tema: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int, ox: Int, oy: Int) -> Int ! alloc
    dr = self.dirty
    row = 0
    while row < rows
        pinta = 0
        if dr == -1
            pinta = 1
        if dr == row
            pinta = 1
        if pinta != 0
            col = 0
            while col < cols
                cp = term_leer_cp(grid, glen, cols, col, row)
                fg = term_leer_fg(grid, glen, cols, col, row)
                bg_i = term_leer_bg(grid, glen, cols, col, row)
                rgb_fg = tema_term_rgb(tema, fg)
                rgb_bg = tema_term_rgb(tema, bg_i)
                px = ox + col * gw
                py = oy + row * gh
                _f = fuente_dibujar(psf, psflen, compos, clen, stride, bpp, fmt, cp, rgb_fg, rgb_bg, px, py)
                col = col + 1
        row = row + 1
    if dr >= 0
        self.dirty = -2
    if dr == -1
        self.dirty = -2
    pos = self.cursor
    cc = term_cursor_col(pos)
    cr = term_cursor_row(pos)
    cx = ox + cc * gw
    cy = oy + cr * gh
    _c = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, cx, cy, cx + 2, cy + gh, tema_term_cursor(tema))
    0

fn term_limpiar(ptr: Int, len: Int, w: Int, h: Int) -> Int ! alloc
    st = Term.new(w, h)
    st.limpiar_pantalla(ptr, len, w, h)
