# Pinta el fotograma `f` en el sprite `b` (s×s): cada píxel del dibujo es un
# bloque de k×k, sin suavizar.
fn mono_pintar_fotograma(b: &mut Bytes, s: Int, f: Int) -> Int ! alloc
    a = mono_arte()
    k = s / a
    datos = mono_datos(f)
    y = 0
    while y < s
        ay = y / k
        x = 0
        while x < s
            v = mono_color(str_char(datos, ay * a + x / k))
            _w = bytes_set_u32(b, (y * s + x) * 4, v)
            x = x + 1
        y = y + 1
    0

# ---- pintar en la pantalla ----------------------------------------------------

# Píxel rgb → u32 en memoria del framebuffer (fmt 1 BGR: [b,g,r,255]).
fn mono_px_mem(rgb: Int, fmt: Int) -> Int
    if fmt == fmt_bgr()
        (255 << 24) + rgb
    else
        (255 << 24) + ((rgb & 255) << 16) + (rgb & 65280) + ((rgb >> 16) & 255)

fn mono_px_rgb(v: Int, fmt: Int) -> Int
    if fmt == fmt_bgr()
        v & 16777215
    else
        ((v & 255) << 16) + (v & 65280) + ((v >> 16) & 255)

# Oscurece toda la superficie (el escritorio queda detrás, en penumbra).
fn mono_oscurecer(ptr: Int, len: Int, k: Int) -> Int ! alloc
    b = bytes_view_mem(ptr, len)
    i = 0
    while i + 4 <= len
        v = bytes_get_u32(b, i)
        r = (((v >> 16) & 255) * k) >> 8
        g = (((v >> 8) & 255) * k) >> 8
        bl = ((v & 255) * k) >> 8
        _w = bytes_set_u32(b, i, (255 << 24) + (r << 16) + (g << 8) + bl)
        i = i + 4
    0

# Copia el sprite en (x, y) de la superficie dw×dh, mezclando los bordes.
fn mono_blit(dptr: Int, dlen: Int, dw: Int, dh: Int, fmt: Int, spr: &Bytes, s: Int, x: Int, y: Int, espejo: Int) -> Int ! alloc
    d = bytes_view_mem(dptr, dlen)
    ya = max(0, 0 - y)
    yb = min(s, dh - y)
    xa = max(0, 0 - x)
    xb = min(s, dw - x)
    sy = ya
    while sy < yb
        fila = (y + sy) * dw
        sx = xa
        while sx < xb
            fx = sx
            if espejo != 0
                fx = s - 1 - sx
            v = bytes_get_u32(spr, (sy * s + fx) * 4)
            a = (v >> 24) & 255
            if a > 0
                o = (fila + x + sx) * 4
                rgb = v & 16777215
                if a < 255
                    rgb = mezclar_rgb(rgb, mono_px_rgb(bytes_get_u32(d, o), fmt), a)
                _w = bytes_set_u32(d, o, mono_px_mem(rgb, fmt))
            sx = sx + 1
        sy = sy + 1
    0

# Restaura desde `limpio` el cuadro s×s en (x, y), recortado a la superficie.
fn mono_restaurar(dptr: Int, limpio: Int, len: Int, dw: Int, dh: Int, fmt: Int, s: Int, x: Int, y: Int) -> Int ! alloc
    xa = max(0, x)
    ya = max(0, y)
    xb = min(dw, x + s)
    yb = min(dh, y + s)
    if xb > xa
        if yb > ya
            _c = copiar_rect(dptr, len, dw, limpio, len, dw, 4, fmt, xa, ya, xa, ya, xb - xa, yb - ya)
    0

# Posición del mono en `--once` (la prueba del WM mira un píxel de la barriga).
fn mono_once_x(w: Int, s: Int) -> Int
    w / 2 - s / 2

fn mono_once_y(h: Int, s: Int) -> Int
    h - s - h / 30

# Centro del píxel (16, 22) del dibujo: la barriga.
fn mono_prueba_dx(s: Int) -> Int
    16 * (s / mono_arte()) + s / mono_arte() / 2

fn mono_prueba_dy(s: Int) -> Int
    22 * (s / mono_arte()) + s / mono_arte() / 2

# Altura (y de arriba del sprite) por la que cruza la pantalla.
fn mono_suelo(h: Int, s: Int, semilla: Int) -> Int
    lo = h * 40 / 100
    hi = max(lo + 1, h - s - h / 30)
    lo + mod_pos(semilla, hi - lo)

# Fotograma de la pausa en el tick `k` (parpadea, saluda y sigue).
fn mono_pausa_ticks() -> Int
    56

fn mono_f_pausa(k: Int) -> Int
    if k < 10
        mono_f_quieto()
    elsif k < 13
        mono_f_parpadeo()
    elsif k < 20
        mono_f_quieto()
    elsif k < 44
        mono_f_saludo() + mod_pos(k / 3, 2)
    elsif k < 47
        mono_f_parpadeo()
    else
        mono_f_quieto()

# ---- martillazos ---------------------------------------------------------------
# Tres golpes seguidos: martillo arriba 4 ticks, abajo 3; pega al bajar.

fn mono_golpe_ticks() -> Int
    21

fn mono_f_golpe_tick(k: Int) -> Int
    if mod_pos(k, 7) < 4
        mono_f_arriba()
    else
        mono_f_golpe()

# Número de golpe (1..3) si en el tick `k` baja el martillo; 0 si no.
fn mono_golpe_en(k: Int) -> Int
    if mod_pos(k, 7) == 4
        k / 7 + 1
    else
        0

# Punto de la pantalla donde pega, con el mono en (x, y) y lado s.
fn mono_impacto_x(x: Int, s: Int, espejo: Int) -> Int
    k = s / mono_arte()
    ax = mono_impacto_ax()
    if espejo != 0
        ax = mono_arte() - 1 - ax
    x + ax * k + k / 2

fn mono_impacto_y(y: Int, s: Int) -> Int
    k = s / mono_arte()
    y + mono_impacto_ay() * k + k / 2

fn mono_dir_dx(d: Int) -> Int
    if d == 0
        1
    elsif d == 1
        1
    elsif d == 2
        0
    elsif d == 3
        -1
    elsif d == 4
        -1
    elsif d == 5
        -1
    elsif d == 6
        0
    else
        1

fn mono_dir_dy(d: Int) -> Int
    if d == 0
        0
    elsif d == 1
        1
    elsif d == 2
        1
    elsif d == 3
        1
    elsif d == 4
        0
    elsif d == 5
        -1
    elsif d == 6
        -1
    else
        -1

# Celda (gx, gy) de k×k píxeles.
fn mono_celda(ptr: Int, len: Int, w: Int, h: Int, fmt: Int, k: Int, gx: Int, gy: Int, rgb: Int) -> Int ! alloc
    rellenar_rect(ptr, len, w, h, w, 4, fmt, gx * k, gy * k, gx * k + k, gy * k + k, rgb)

fn mono_celda_alfa(ptr: Int, len: Int, w: Int, h: Int, fmt: Int, k: Int, gx: Int, gy: Int, rgb: Int, alfa: Int) -> Int ! alloc
    rellenar_rect_alfa(ptr, len, w, h, w, 4, fmt, gx * k, gy * k, gx * k + k, gy * k + k, rgb, alfa)

# Una rama de grieta desde la celda (gx, gy): avanza torciendo al azar, con un
# filo claro al lado de cada celda rota. Devuelve la semilla.
fn mono_rama(ptr: Int, len: Int, w: Int, h: Int, fmt: Int, k: Int, gx0: Int, gy0: Int, d0: Int, largo: Int, semilla: Int, hijas: Int) -> Int ! alloc
    sem = semilla
    d = d0
    gx = gx0
    gy = gy0
    i = 0
    while i < largo
        sem = mono_lcg(sem)
        t = mod_pos(sem, 10)
        if t < 2
            d = mod_pos(d + 1, 8)
        elsif t < 4
            d = mod_pos(d + 7, 8)
        gx = gx + mono_dir_dx(d)
        gy = gy + mono_dir_dy(d)
        _l = mono_celda_alfa(ptr, len, w, h, fmt, k, gx - mono_dir_dy(d), gy + mono_dir_dx(d), color_rgb(235, 240, 250), 70)
        _o = mono_celda(ptr, len, w, h, fmt, k, gx, gy, color_rgb(12, 12, 16))
        if t == 9
            if hijas > 0
                sem = mono_rama(ptr, len, w, h, fmt, k, gx, gy, mod_pos(d + 2, 8), largo / 2, sem, hijas - 1)
        i = i + 1
    sem

# Rompe la pantalla en (cx, cy): agujero, grietas y trozos desplazados. Cuanto
# más `fuerza` (1..3), más grande. Devuelve el radio en celdas que pudo tocar.
fn mono_grieta(ptr: Int, len: Int, w: Int, h: Int, fmt: Int, cx: Int, cy: Int, k: Int, semilla: Int, fuerza: Int) -> Int ! alloc
    gx = cx / k
    gy = cy / k
    sem = mono_lcg(semilla + gx * 31 + gy * 17)
    # Trozos sueltos alrededor: celdas que se corren una posición.
    j = 0
    while j < 3 + fuerza * 2
        sem = mono_lcg(sem)
        ox = gx + mod_pos(sem, 7) - 3
        sem = mono_lcg(sem)
        oy = gy + mod_pos(sem, 5) - 3
        # `copiar_rect` no recorta: sólo trozos enteros dentro de la pantalla.
        if ox >= 0
            if oy >= 0
                if ox * k + 2 * k <= w
                    if oy * k + k <= h
                        _c = copiar_rect(ptr, len, w, ptr, len, w, 4, fmt, ox * k + k, oy * k, ox * k, oy * k, k, k)
        _s = mono_celda_alfa(ptr, len, w, h, fmt, k, ox, oy, color_rgb(0, 0, 0), 90)
        j = j + 1
    # Ramas.
    r = 0
    n = 3 + fuerza * 2
    while r < n
        sem = mono_lcg(sem)
        d = mod_pos(sem, 8)
        sem = mono_lcg(sem)
        largo = 3 + mod_pos(sem, 3 + 3 * fuerza)
        sem = mono_rama(ptr, len, w, h, fmt, k, gx, gy, d, largo, sem, 1)
        r = r + 1
    # Agujero del golpe.
    a = 0
    while a < fuerza
        _h1 = mono_celda(ptr, len, w, h, fmt, k, gx - a, gy, color_rgb(6, 6, 8))
        _h2 = mono_celda(ptr, len, w, h, fmt, k, gx + a, gy, color_rgb(6, 6, 8))
        _h3 = mono_celda(ptr, len, w, h, fmt, k, gx, gy - a, color_rgb(6, 6, 8))
        a = a + 1
    6 + 6 * fuerza + 3
