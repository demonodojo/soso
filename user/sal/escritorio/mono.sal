import "mate.sal"
import "superficie.sal"

# Salvapantallas: un mono de pixel art que pasea por el escritorio oscurecido,
# se para, parpadea y saluda. El dibujo es de 32×32 y se escala por un entero
# (cada píxel del dibujo, un bloque k×k). Cada fotograma se pasa una sola vez a
# un sprite de s×s píxeles u32 (alfa << 24 | rgb) y luego sólo se copia. Mira
# hacia la derecha; hacia la izquierda se pinta en espejo.

fn mono_umbral_ms() -> Int
    600000

fn mono_frame_ms() -> Int
    50

fn mono_lcg(seed: Int) -> Int
    mod_pos(seed * 1103515245 + 12345, 2147483647)

fn mono_ocioso(last_ms: Int, now_ms: Int, inited: Int) -> Int
    if inited == 0
        0
    else
        if now_ms - last_ms >= mono_umbral_ms()
            1
        else
            0

# ---- sprite ------------------------------------------------------------------
# Pixel art de 32×32, una cadena por fotograma (fila a fila). Generado y
# retocado con scripts/mono-pixel.py; la paleta está en `mono_color`.
# 0..3 andar, 4 quieto, 5 parpadeo, 6 y 7 saludo, 8 martillo arriba y 9
# martillazo.

fn mono_arte() -> Int
    32

fn mono_n_fotogramas() -> Int
    10

fn mono_f_arriba() -> Int
    8

fn mono_f_golpe() -> Int
    9

# Dónde pega el martillo (píxel del dibujo, mirando a la derecha).
fn mono_impacto_ax() -> Int
    27

fn mono_impacto_ay() -> Int
    30

fn mono_f_quieto() -> Int
    4

fn mono_f_parpadeo() -> Int
    5

fn mono_f_saludo() -> Int
    6

fn mono_f_andar(fase: Int) -> Int
    mod_pos(fase / 2, 4)

# Escala entera: el mono mide un cuarto del alto de la pantalla.
fn mono_escala(alto: Int) -> Int
    max(2, alto / 4 / mono_arte())

fn mono_lado(alto: Int) -> Int
    mono_arte() * mono_escala(alto)

# Píxeles que avanza por tick de andar: un píxel del dibujo.
fn mono_paso_px(s: Int) -> Int
    s / mono_arte()

fn mono_piel() -> Int
    color_rgb(246, 208, 158)

# Color (alfa << 24 | rgb) de un carácter del dibujo; 0 transparente.
fn mono_color(c: Int) -> Int
    if c == 107
        (255 << 24) + color_rgb(44, 26, 18)
    elsif c == 68
        (255 << 24) + color_rgb(96, 54, 30)
    elsif c == 66
        (255 << 24) + color_rgb(140, 84, 44)
    elsif c == 76
        (255 << 24) + color_rgb(178, 116, 66)
    elsif c == 83
        (255 << 24) + color_rgb(246, 208, 158)
    elsif c == 115
        (255 << 24) + color_rgb(214, 166, 116)
    elsif c == 112
        (255 << 24) + color_rgb(230, 140, 124)
    elsif c == 87
        (255 << 24) + color_rgb(255, 255, 255)
    elsif c == 71
        (255 << 24) + color_rgb(168, 176, 190)
    elsif c == 103
        (255 << 24) + color_rgb(104, 110, 124)
    elsif c == 104
        (255 << 24) + color_rgb(196, 138, 76)
    elsif c == 111
        70 << 24
    else
        0

fn mono_datos(f: Int) -> String ! alloc
    if f == 0
        d"................kDk...........................kkDkkk........................kkLLBLLDkk.....................kLLBBBBBBLDk...................kLBBBBBBBBBBDk..................kLBSSBBBSSBBDk.................kLBSSSSBSSSSBBDk..............kkkLBSWWkSSWWkSBDkkk...........kLLLBBSWWkSSWWkSBBLLDk.........kLBBBBBSSSSSSSSSSSBBBBDk........kLBpBBSSSSSkSkSSSSBBpBDk........kDBpBBpSSSSSSSSSSpBBpBDk.........kDDDDSSkSSSSSSkSSDDDDk...........kkkkSSSkkkkkkSSSkkkk.............k.kDSSSSSSSSSSDk..............kkDk.kDDssssssDDk..............kBDkDk.kkLBBBBDkk...............kDkkDkkBBBBBBBDkkk.............kDk.kDDBBBBBBBBBDBDk............kDk..kDBBBBSSSSBDBDk............kDk..kDBBBSSSSSSDBDk............kDk..kBBBBSSSSSSDBDk.............kDk.kDBBBSSSSSSDBDk.............kDkkkDBBBSSSSSSDBDk..............kDDDsDBBSSSSSSDSSSk..............kkkkkDDBSSBBDkSSSk...................kkBBDBDk.kkk.....................kDDkBDk.........................kDDkBDkk.......................kssssSSSSk.......................kkkkkkkk....................oooooooooooooo........."
    elsif f == 1
        d"..............kkDkkk........................kkLLBLLDkk.....................kLLBBBBBBLDk...................kLBBBBBBBBBBDk..................kLBSSBBBSSBBDk.................kLBSSSSBSSSSBBDk..............kkkLBSWWkSSWWkSBDkkk...........kLLLBBSWWkSSWWkSBBLLDk.........kLBBBBBSSSSSSSSSSSBBBBDk........kLBpBBSSSSSkSkSSSSBBpBDk........kDBpBBpSSSSSSSSSSpBBpBDk.........kDDDDSSkSSSSSSkSSDDDDk...........kkkkSSSkkkkkkSSSkkkk...............kDSSSSSSSSSSDk...................kDDssssssDDk................kk...kkLBBBBDkk................kDDk.kBBBBBBBDk................kDkkDkBBBBBBBBBDkk.............kDk.kBDBBBBSSSSBDBDk............kDk.kDDBBBSSSSSSDBDk............kDk..kDBBBSSSSSsBBDk............kDk...kBBBSSSSSsBDk..............kDk..kBBBSSSSSsBDk..............kDkkkDDBBSSSSSsBDk...............kDDDkkDDBSSSSDSSSk...............kkk..kkBBDBDkSSSk....................kDDDkDBDkkk.....................kDDk.kBDk......................kDDDk.kDBDkk...................kssssk..kSSSSk...................kkkk....kkkk..................oooooooooooooo........."
    elsif f == 2
        d"................kDk...........................kkDkkk........................kkLLBLLDkk.....................kLLBBBBBBLDk...................kLBBBBBBBBBBDk..................kLBSSBBBSSBBDk.................kLBSSSSBSSSSBBDk..............kkkLBSWWkSSWWkSBDkkk...........kLLLBBSWWkSSWWkSBBLLDk.........kLBBBBBSSSSSSSSSSSBBBBDk........kLBpBBSSSSSkSkSSSSBBpBDk........kDBpBBpSSSSSSSSSSpBBpBDk.........kDDDDSSkSSSSSSkSSDDDDk...........kkkkSSSkkkkkkSSSkkkk.............k.kDSSSSSSSSSSDk..............kkDk.kDDssssssDDk..............kBDkDk.kkLBBBBDkk...............kDkkDkkBBBBBBBDkkk.............kDk.kDDBBBBBBBBBDBDk............kDk..kDBBBBSSSSBDBDk............kDk..kDBBBSSSSSSDBDk............kDk..kBBBBSSSSSSDBDk.............kDk.kDBBBSSSSSSDBDk.............kDkkkDBBBSSSSSSDBDk..............kDDDsDBBSSSSSSDSSSk..............kkkkkDDBSSBBDkSSSk...................kkBBDBDk.kkk.....................kDDkBDk.........................kDDkBDkk.......................kssssSSSSk.......................kkkkkkkk....................oooooooooooooo........."
    elsif f == 3
        d"..............kkDkkk........................kkLLBLLDkk.....................kLLBBBBBBLDk...................kLBBBBBBBBBBDk..................kLBSSBBBSSBBDk.................kLBSSSSBSSSSBBDk..............kkkLBSWWkSSWWkSBDkkk...........kLLLBBSWWkSSWWkSBBLLDk.........kLBBBBBSSSSSSSSSSSBBBBDk........kLBpBBSSSSSkSkSSSSBBpBDk........kDBpBBpSSSSSSSSSSpBBpBDk.........kDDDDSSkSSSSSSkSSDDDDk...........kkkkSSSkkkkkkSSSkkkk............kk.kDSSSSSSSSSSDk..............kDDk.kDDssssssDDk..............kDkkDk.kkLBBBBDkk...............kDkkDkkBBBBBBBDk...............kDk.kDkBBBBBBBBBDkk.............kDk..kDBBBBSSSSBDBDk............kDk.kDDBBBSSSSSSDBBDk...........kDk.kDBBBBSSSSSSBDDBDk..........kDkkDDDBBBSSSSSSDkkDBDk..........kDkDDkBBBSSSSSSDk.kBDk..........kDkssDDBBSSSSSSDk.kSSSk..........kDDDkkDDBSSSSDk..kSSSk...........kkk..kkBBBBDk....kkk..................kDDBBDk..........................kDBDk...........................kBBDk...........................kSSSSk...........................kkkk......................oooooooooooooo........."
    elsif f == 4
        d"................kDk...........................kkDkkk........................kkLLBLLDkk.....................kLLBBBBBBLDk...................kLBBBBBBBBBBDk..................kLBSSBBBSSBBDk.................kLBSSSSBSSSSBBDk..............kkkLBSWWkSSWWkSBDkkk...........kLLLBBSWWkSSWWkSBBLLDk.........kLBBBBBSSSSSSSSSSSBBBBDk........kLBpBBSSSSSkSkSSSSBBpBDk........kDBpBBpSSSSSSSSSSpBBpBDk.........kDDDDSSkSSSSSSkSSDDDDk...........kkkkSSSkkkkkkSSSkkkk.............k.kDSSSSSSSSSSDk..............kkDk.kDDssssssDDk..............kBDkDk.kkLBBBBDkk...............kDkkDkkBBBBBBBDkkk.............kDk.kDDBBBBBBBBBDBDk............kDk..kDBBBBSSSSBDBDk............kDk..kDBBBSSSSSSDBDk............kDk..kBBBBSSSSSSDBDk.............kDk.kDBBBSSSSSSDBDk.............kDkkkDBBBSSSSSSDBDk..............kDDDsDBBSSSSSSDSSSk..............kkkkkDDBSSBBDkSSSk...................kkBBDBDk.kkk.....................kDDkBDk.........................kDDkBDkk.......................kssssSSSSk.......................kkkkkkkk....................oooooooooooooo........."
    elsif f == 5
        d"................kDk...........................kkDkkk........................kkLLBLLDkk.....................kLLBBBBBBLDk...................kLBBBBBBBBBBDk..................kLBSSBBBSSBBDk.................kLBSSSSBSSSSBBDk..............kkkLBSSSSSSSSSSBDkkk...........kLLLBBkkkSSSkkkSBBLLDk.........kLBBBBBSSSSSSSSSSSBBBBDk........kLBpBBSSSSSkSkSSSSBBpBDk........kDBpBBpSSSSSSSSSSpBBpBDk.........kDDDDSSkSSSSSSkSSDDDDk...........kkkkSSSkkkkkkSSSkkkk.............k.kDSSSSSSSSSSDk..............kkDk.kDDssssssDDk..............kBDkDk.kkLBBBBDkk...............kDkkDkkBBBBBBBDkkk.............kDk.kDDBBBBBBBBBDBDk............kDk..kDBBBBSSSSBDBDk............kDk..kDBBBSSSSSSDBDk............kDk..kBBBBSSSSSSDBDk.............kDk.kDBBBSSSSSSDBDk.............kDkkkDBBBSSSSSSDBDk..............kDDDsDBBSSSSSSDSSSk..............kkkkkDDBSSBBDkSSSk...................kkBBDBDk.kkk.....................kDDkBDk.........................kDDkBDkk.......................kssssSSSSk.......................kkkkkkkk....................oooooooooooooo........."
    elsif f == 6
        d"................kDk...........................kkDkkk........................kkLLBLLDkk.....................kLLBBBBBBLDk...................kLBBBBBBBBBBDk..................kLBSSBBBSSBBDk.................kLBSSSSBSSSSBBDk..............kkkLBSWWkSSWWkSBDkkk...........kLLLBBSWWkSSWWkSBBLLDk.........kLBBBBBSSSSSSSSSSSBBBBDk........kLBpBBSSSSSkSkSSSSBBpBDkk.......kDBpBBpSSSSSSSSSSpBBpDSSSk.......kDDDDSSkSSSSSSkSSDDDDSSSk........kkkkSSSkkkkkkSSSkkkkBDk..........k.kDSSSSSSSSSSDk.kBBDk........kkDk.kDDssssssDDk.kkBDk........kBDkDk.kkLBBBBDkk.kBBBDk........kDkkDkkBBBBBBBDkkkBBDDk........kDk.kDDBBBBBBBBBDBBBDkk.........kDk..kDBBBBSSSSBDDDDk...........kDk..kDBBBSSSSSSDkkk............kDk..kBBBBSSSSSSBDk..............kDk.kDBBBSSSSSSDk...............kDkkkDBBBSSSSSSDk................kDDDsDBBSSSSSSDk.................kkkkkDDBSSBBDk.......................kkBBDBDk.........................kDDkBDk.........................kDDkBDkk.......................kssssSSSSk.......................kkkkkkkk....................oooooooooooooo........."
    elsif f == 7
        d"................kDk...........................kkDkkk........................kkLLBLLDkk.....................kLLBBBBBBLDk...................kLBBBBBBBBBBDk..................kLBSSBBBSSBBDk.................kLBSSSSBSSSSBBDk..............kkkLBSWWkSSWWkSBDkkk...........kLLLBBSWWkSSWWkSBBLLDk.........kLBBBBBSSSSSSSSSSSBBDDDk........kLBpBBSSSSSkSkSSSSBDSSSk........kDBpBBpSSSSSSSSSSpBDSSSk.........kDDDDSSkSSSSSSkSSDDBDk...........kkkkSSSkkkkkkSSSkkBDk............k.kDSSSSSSSSSSDkBBDk..........kkDk.kDDssssssDDkkBDk..........kBDkDk.kkLBBBBDkkkBBDk..........kDkkDkkBBBBBBBDkkBBDk..........kDk.kDDBBBBBBBBBDBBDk...........kDk..kDBBBBSSSSBDDDk............kDk..kDBBBSSSSSSDkk.............kDk..kBBBBSSSSSSBDk..............kDk.kDBBBSSSSSSDk...............kDkkkDBBBSSSSSSDk................kDDDsDBBSSSSSSDk.................kkkkkDDBSSBBDk.......................kkBBDBDk.........................kDDkBDk.........................kDDkBDkk.......................kssssSSSSk.......................kkkkkkkk....................oooooooooooooo........."
    elsif f == 8
        d"................kDk.....kkkkkkk...............kkDkkk...kGGGGGGGk............kkLLBLLDkk.kGGGGGGGk...........kLLBBBBBBLDkkgggggggk..........kLBBBBBBBBBBDkkkkhkkk...........kLBSSBBBSSBBDk..khk............kLBSSSSBSSSSBBDk.khk..........kkkLBSWWkSSWWkSBDkkkhk.........kLLLBBSWWkSSWWkSBBLLDhk........kLBBBBBSSSSSSSSSSSBBDSSSk.......kLBpBBSSSSSkSkSSSSBBpSSSk.......kDBpBBpSSSSSSSSSSpBBpBDk.........kDDDDSSkSSSSSSkSSDDDBDk..........kkkkSSSkkkkkkSSSkkkBDk...........k.kDSSSSSSSSSSDkkBBDk.........kkDk.kDDssssssDDkkkBDk.........kBDkDk.kkLBBBBDkkkBBBDk.........kDkkDkkBBBBBBBDkkBBDDk.........kDk.kDDBBBBBBBBBDBBDkk..........kDk..kDBBBBSSSSBDDDk............kDk.kDDBBBSSSSSSDkk.............kDk.kDBBBBSSSSSSBDk..............kDkkDDBBBSSSSSSDk...............kDkkssBBBSSSSSSDk................kDDDkDBBSSSSSSDk.................kkk.kDDBSSBBDk.......................kkBBDBDk.........................kDDkBDk.........................kDDkBDkk.......................kssssSSSSk.......................kkkkkkkk....................oooooooooooooo........."
    else
