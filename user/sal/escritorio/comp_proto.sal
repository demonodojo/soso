    0

fn msg_encode_comp_commit(ptr: Int, x: Int, y: Int, w: Int, h: Int, flags: Int) -> Int ! alloc
    _o = msg_set_op(ptr, op_comp_commit())
    _x = msg_set_u32(ptr, 4, x)
    _y = msg_set_u32(ptr, 8, y)
    _w = msg_set_u32(ptr, 12, w)
    _h = msg_set_u32(ptr, 16, h)
    _f = msg_set_u32(ptr, 20, flags)
    0

fn msg_encode_comp_frame(ptr: Int, x: Int, y: Int, w: Int, h: Int) -> Int ! alloc
    _o = msg_set_op(ptr, op_comp_frame())
    _a = msg_set_u32(ptr, 4, x)
    _b = msg_set_u32(ptr, 8, y)
    _c = msg_set_u32(ptr, 12, w)
    _d = msg_set_u32(ptr, 16, h)
    0

fn msg_encode_comp_prims(ptr: Int, len: Int, x: Int, y: Int, w: Int, h: Int, flags: Int) -> Int ! alloc
    _o = msg_set_op(ptr, op_comp_prims())
    _l = msg_set_u32(ptr, 4, len)
    _x = msg_set_u32(ptr, 8, x)
    _y = msg_set_u32(ptr, 12, y)
    _w = msg_set_u32(ptr, 16, w)
    _h = msg_set_u32(ptr, 20, h)
    _f = msg_set_u32(ptr, 24, flags)
    0

fn msg_encode_comp_prims_ack(ptr: Int, ok: Int) -> Int ! alloc
    _o = msg_set_op(ptr, op_comp_prims_ack())
    _k = msg_set_u32(ptr, 4, ok)
    0
