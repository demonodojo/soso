fn wm_cursor_pixel(lx: Int, ly: Int) -> Int
    ok = 0
    if ly >= 0
        if ly < 11
            if lx >= 0
                if lx <= ly
                    ok = 1
        if ly >= 11
            if ly < 16
                if lx >= 0
                    if lx <= 1
                        ok = 1
    ok

