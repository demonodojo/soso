    0

fn st_nuevo(evt_buf: Int, msg_buf: Int) -> Int ! alloc
    p = bytes_ptr(bytes_new(st_alloc_bytes()))
    tab = bytes_ptr(bytes_new(tab_cap() * tab_slot_bytes()))
    z = bytes_ptr(bytes_new(tab_zorder_size()))
    _z = st_set(p, st_cli_fd(), 0)
    _f = st_set(p, st_fase(), 0)
    _s = st_set(p, st_salir(), 0)
    _e = st_set(p, st_evt_buf(), evt_buf)
    _m = st_set(p, st_msg_buf(), msg_buf)
    _t = st_set(p, st_tab(), tab)
    _z0 = st_set(p, st_z(), z)
    _n = st_set(p, st_nz(), 0)
    _fo = st_set(p, st_focus(), -1)
    _mo = st_set(p, st_mosaic(), 0)
    _ft = fuente_tab_nuevo()
    _ftb = st_set(p, st_fuente_tab(), _ft)
    _te = st_set(p, st_tema(), tema_oscuro())
    _ew = st_set(p, st_escala_wm(), -1)
    _ea = st_set(p, st_escala_apps(), -1)
    _dr = st_set(p, st_drag_ix(), -1)
    _dk = st_set(p, st_drag_kind(), 0)
    _mx = st_set(p, st_mx(), 0)
    _my = st_set(p, st_my(), 0)
    _mxp = st_set(p, st_mx_prev(), 0)
    _myp = st_set(p, st_my_prev(), 0)
    _fo = st_set(p, st_fondo(), 0)
    _gx = st_set(p, st_grab_x(), 0)
    _gy = st_set(p, st_grab_y(), 0)
    _mn = st_set(p, st_menu(), 0)
    _rp = st_set(p, st_repintar(), 1)
    _bk = st_set(p, st_bak_ok(), 0)
    _cf = st_set(p, st_comp_fd(), -1)
    _gk = st_set(p, st_comp_gpu_ok(), 0)
    _nc = st_set(p, st_comp_need_clear(), 0)
    wtab = bytes_ptr(bytes_new(wm_surf_tab_bytes()))
    _wt = st_set(p, st_wsurf_tab(), wtab)
    _sl = st_set(p, st_ss_last(), 0)
    _si = st_set(p, st_ss_inited(), 0)
    _sp = st_set(p, st_ss_pid(), -1)
    _ss = st_set(p, st_ss_slot(), -1)
    _sc = st_set(p, st_ss_cap(), 0)
    _es = st_set(p, st_escena(), esc_nueva(wm_escena_cap()))
    _pp = st_set(p, st_pend_pid(), -1)
    _pa = st_set(p, st_pend_app(), 0)
    _pg = st_set(p, st_pend_grupo(), 0)
    _hp = st_set(p, st_hover_pest(), 0)
    _dp = st_set(p, st_drop(), -1)
    _cx0 = st_set(p, st_ctx(), -1)
    _cb = bytes_ptr(bytes_new(wm_cursor_bak_len()))
    _cp = st_set(p, st_cursor_bak(), _cb)
    p

fn wm_es_ss(st: Int, i: Int) -> Int ! alloc
    if i < 0
        0
    else
        if st_get(st, st_ss_slot()) == i
            1
        else
            0

fn wm_ss_reset(st: Int) -> Int ! alloc
    _p = st_set(st, st_ss_pid(), -1)
    _s = st_set(st, st_ss_slot(), -1)
    _c = st_set(st, st_ss_cap(), 0)
    0

fn wm_ss_capturar_gpu(st: Int, cap: Int, cap_len: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    ws = st_get(st, st_wsurf_tab())
    bh = wm_bar_h(st)
    gw = wm_gw_wm(st)
    gh = wm_gh_wm(st)
    tema = wm_tema_id(st)
    fondo = wm_surf_get(ws, wm_surf_fondo(), wm_surf_ptr())
    fw = wm_surf_get(ws, wm_surf_fondo(), wm_surf_w())
    fh = wm_surf_get(ws, wm_surf_fondo(), wm_surf_h())
    if fondo > 0
        _f = copiar_rect(cap, cap_len, sw, fondo, fw * fh * 4, fw, bpp, fmt, 0, 0, 0, 0, sw, sh)
    k = 0
    while k < nz
        i = z_get(z, k)
        if tab_slot_activo(tab, i) != 0
            if wm_es_ss(st, i) == 0
                wx = tab_get(tab, i, tab_wx())
                wy = tab_get(tab, i, tab_wy())
                ww = tab_get(tab, i, tab_ww())
                wh = tab_get(tab, i, tab_wh())
                sid = wm_surf_win(i)
                sp = wm_surf_get(ws, sid, wm_surf_ptr())
                if sp > 0
                    _w = copiar_rect(cap, cap_len, sw, sp, ww * wh * 4, ww, bpp, fmt, wx, wy, 0, 0, ww, wh)
        k = k + 1
    bar = wm_surf_get(ws, wm_surf_bar(), wm_surf_ptr())
    if bar > 0
        _b = copiar_rect(cap, cap_len, sw, bar, sw * bh * 4, sw, bpp, fmt, 0, 0, 0, 0, sw, bh)
    if st_get(st, st_menu()) != 0
        mw = lanz_menu_ancho(gw, gh, tema)
        mh = lanz_menu_alto(gh)
        mx0 = lanz_menu_x0(gw)
        my0 = lanz_menu_y0(gh)
        men = wm_surf_get(ws, wm_surf_menu(), wm_surf_ptr())
        if men > 0
            _m = copiar_rect(cap, cap_len, sw, men, mw * mh * 4, mw, bpp, fmt, mx0, my0, 0, 0, mw, mh)
    0

fn wm_ss_capturar(st: Int, compos: Int, clen: Int, cap: Int, cap_len: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc
    if wm_comp_gpu_mode(st) == 0
        copiar_rect(cap, cap_len, stride, compos, clen, stride, bpp, fmt, 0, 0, 0, 0, sw, sh)
    else
        wm_ss_capturar_gpu(st, cap, cap_len, sw, sh, stride, bpp, fmt)
    0

fn wm_ss_armar(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    if st_get(st, st_ss_cap()) > 0
        0
    else
        _ic = wm_iniciar_cursor(st, sw, sh)
        _ps = wm_cargar_psf(st, sw)
        _p = wm_compose(st, compos, clen, sw, sh, stride, bpp, fmt)
        _f = wm_flush_dirty(st, compos, clen)
        _cap = st_set(st, st_ss_cap(), compos)
        1

fn wm_ss_iniciar(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    if st_get(st, st_ss_cap()) > 0
        if st_get(st, st_ss_pid()) >= 0
            0
        else
            wm_ss_armar(st, compos, clen, sw, sh, stride, bpp, fmt)
    else
        ok = wm_ss_armar(st, compos, clen, sw, sh, stride, bpp, fmt)
        if ok == 0
            0
        else
            pid = spawn_io_full(d"/bin/soso-mono", fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
            if pid < 0
                _r = st_set(st, st_ss_cap(), 0)
                _t = st_set(st, st_ss_last(), uptime_ms())
                0
            else
                _pid = st_set(st, st_ss_pid(), pid)
                1

fn wm_ss_cerrar(st: Int) -> Int ! io, alloc
    si = st_get(st, st_ss_slot())
    if si >= 0
        _c = wm_cerrar_indice(st, si)
    _r = wm_ss_reset(st)
    _t = st_set(st, st_ss_last(), uptime_ms())
    _rp = wm_pedir_repintar(st)
    0

fn wm_ss_idle(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    now = uptime_ms()
    if st_get(st, st_ss_inited()) == 0
        _i = st_set(st, st_ss_inited(), 1)
        _l = st_set(st, st_ss_last(), now)
        0
    else
        if st_get(st, st_ss_slot()) >= 0
            0
        else
            if st_get(st, st_ss_pid()) >= 0
                0
            else
                if mono_ocioso(st_get(st, st_ss_last()), now, 1) != 0
                    wm_ss_iniciar(st, compos, clen, sw, sh, stride, bpp, fmt)
                else
                    0

fn wm_on_crear_ss(st: Int, fd: Int, tab: Int, i: Int, fmt: Int, sw: Int, sh: Int, stride: Int) -> Int ! io, alloc
    cw = sw
    ch = sh
    ok = 0
    if cw > 0
        if ch > 0
            slen = cw * ch * 4
            sid = shm_create(slen)
            if sid >= 0
                peer = tcp_peer_pid(fd)
                if peer >= 0
                    _g = shm_grant(sid, peer)
                sptr = shm_map(sid)
                if sptr >= 0
                    cap = st_get(st, st_ss_cap())
                    if cap > 0
                        cap_len = stride * sh * 4
                        _cp = copiar_rect(sptr, slen, cw, cap, cap_len, stride, 4, fmt, 0, 0, 0, 0, sw, sh)
                        _z = st_set(st, st_ss_cap(), 0)
                    _v = wm_enviar_ventana(st, fd, 1, sid, cw, ch, fmt)
                    _a = st_set(st, st_shm_id(), sid)
                    _b = st_set(st, st_shm_ptr(), sptr)
                    _c = st_set(st, st_cw(), cw)
                    _d = st_set(st, st_ch(), ch)
                    _e = st_set(st, st_wx(), 0)
                    _f = st_set(st, st_wy(), 0)
                    _g = st_set(st, st_ww(), sw)
                    _h = st_set(st, st_wh(), sh)
                    _i = st_set(st, st_fase(), 2)
                    _x = tab_set(tab, i, tab_wx(), 0)
                    _y = tab_set(tab, i, tab_wy(), 0)
                    _w = tab_set(tab, i, tab_ww(), sw)
                    _h2 = tab_set(tab, i, tab_wh(), sh)
                    _sid = tab_set(tab, i, tab_shm_id(), sid)
                    _sp = tab_set(tab, i, tab_shm_ptr(), sptr)
                    _cw = tab_set(tab, i, tab_cw(), cw)
                    _ch = tab_set(tab, i, tab_ch(), ch)
                    ok = 1
    ok

fn wm_init_escala(st: Int, sw: Int) -> Int ! io, alloc
    if st_get(st, st_escala_wm()) < 0
        _z = st_set(st, st_escala_wm(), fuente_inicial_por_ancho(sw))
    if st_get(st, st_escala_apps()) < 0
        _a = st_set(st, st_escala_apps(), st_get(st, st_escala_wm()))
    _c0 = fuente_cargar(wm_fuente_tab(st), wm_escala_wm(st))
    _c1 = fuente_cargar(wm_fuente_tab(st), wm_escala_apps(st))
    0

fn wm_cargar_psf(st: Int, sw: Int) -> Int ! io, alloc
    wm_init_escala(st, sw)

fn wm_fondo_rgb_fila(st: Int, y: Int, sh: Int) -> Int ! alloc
    t = wm_tema_id(st)
    ar = tema_fondo_arriba(t)
    ab = tema_fondo_abajo(t)
    bh = wm_bar_h(st)
    yf = y
    if yf < bh
        yf = bh
    denom = sh - bh
    if denom <= 0
        ab
    else
        color_interp(ar, ab, yf - bh, denom)

fn wm_barra_rgb_fila(st: Int, y: Int, sh: Int) -> Int ! alloc
    fg = tema_barra(wm_tema_id(st))
    bg = wm_fondo_rgb_fila(st, y, sh)
    mezclar_rgb(fg, bg, tema_barra_alfa(wm_tema_id(st)))

fn wm_menu_rgb_fila(st: Int, y: Int, sh: Int, my: Int) -> Int ! alloc
    fg = tema_menu(wm_tema_id(st))
    bg = wm_fondo_rgb_fila(st, my + y, sh)
    mezclar_rgb(fg, bg, tema_menu_alfa(wm_tema_id(st)))

fn wm_pintar_fondo(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc
    bh = wm_bar_h(st)
    _g = degradado_vertical(compos, clen, sw, sh, stride, bpp, fmt, 0, bh, sw, sh, tema_fondo_arriba(wm_tema_id(st)), tema_fondo_abajo(wm_tema_id(st)))
    0

fn wm_pintar_fondo_gpu(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc
    wm_pintar_fondo(st, compos, clen, sw, sh, stride, bpp, fmt)

fn wm_broadcast_tema(st: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    i = 0
    while i < tab_cap()
        if tab_slot_activo(tab, i) != 0
            if tab_get(tab, i, tab_tipo()) == tab_tipo_cli()
                if tab_get(tab, i, tab_fase()) == 2
                    fd = tab_get(tab, i, tab_fd())
                    msg = st_get(st, st_msg_buf())
                    _e = msg_encode_tema(msg, wm_tema_id(st))
                    _w = write_fd(fd, msg, msg_len())
        i = i + 1
    0

fn wm_cambiar_tema(st: Int) -> Int ! io, alloc
    t = wm_tema_id(st)
    if t == tema_oscuro()
        _n = st_set(st, st_tema(), tema_claro())
    else
        _n = st_set(st, st_tema(), tema_oscuro())
    tab = st_get(st, st_tab())
    i = 0
    while i < tab_cap()
        if tab_slot_activo(tab, i) != 0
            if tab_get(tab, i, tab_tipo()) == tab_tipo_term()
                tst = tab_get(tab, i, tab_term_st())
                _d = term_st_set(tst, st_dirty(), -1)
        i = i + 1
    _bt = wm_broadcast_tema(st)
    _sf = st_set(st, st_fondo(), 0)
    _rp = wm_pedir_repintar(st)
    0

fn wm_enviar_escala_slot(st: Int, tab: Int, i: Int) -> Int ! io, alloc
    if tab_get(tab, i, tab_tipo()) == tab_tipo_cli()
        if tab_get(tab, i, tab_fase()) == 2
            fd = tab_get(tab, i, tab_fd())
            nv = wm_tab_escala(tab, i)
            msg = st_get(st, st_msg_buf())
            _e = msg_encode_escala(msg, nv, fuente_gw(nv), fuente_gh(nv))
            _w = write_fd(fd, msg, msg_len())
    0

fn wm_redim_todos_por_barra(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    i = 0
    while i < tab_cap()
        if tab_slot_activo(tab, i) != 0
            _r = wm_redim_slot(st, tab, i, fmt, compos, clen, sw, sh, stride, bpp)
            _t = wm_term_redimensionar_si(st, tab, i)
        i = i + 1
    0

fn wm_zoom_aplicar(st: Int, zv: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    dest = zoom_dest(zv)
    sent = zoom_sentido(zv)
    delta = 0
    if sent == zoom_sentido_mas()
        delta = 1
    if sent == zoom_sentido_menos()
        delta = -1
    if delta == 0
        0
    else
        if dest == zoom_dest_app()
            fi = st_get(st, st_focus())
            if fi < 0
                0
            else
                tab = st_get(st, st_tab())
                if tab_slot_activo(tab, fi) == 0
                    0
                else
                    old = wm_tab_escala(tab, fi)
                    nv = zoom_clamp(old, delta)
                    if nv == old
                        0
                    else
                        _a = st_set(st, st_escala_apps(), nv)
                        _s = tab_set(tab, fi, tab_escala(), nv)
                        _c = fuente_cargar(wm_fuente_tab(st), nv)
                        if tab_get(tab, fi, tab_tipo()) == tab_tipo_term()
                            _t = wm_term_redimensionar_si(st, tab, fi)
                            tst = tab_get(tab, fi, tab_term_st())
                            _d = term_st_set(tst, st_dirty(), -1)
                        if tab_get(tab, fi, tab_tipo()) == tab_tipo_cli()
                            _e = wm_enviar_escala_slot(st, tab, fi)
                        _rp = wm_pedir_repintar(st)
                        0
        else
            old = wm_escala_wm(st)
            nv = zoom_clamp(old, delta)
            if nv == old
                0
            else
                _w = st_set(st, st_escala_wm(), nv)
                _c = fuente_cargar(wm_fuente_tab(st), nv)
                _rd = wm_redim_todos_por_barra(st, compos, clen, sw, sh, stride, bpp, fmt)
                _sf = st_set(st, st_fondo(), 0)
                _rp = wm_pedir_repintar(st)
                0

fn pty_max() -> Int
    8

fn wm_term_cols(ww: Int, gw: Int) -> Int
    c = (ww - 8) / gw
    if c < 1
        1
    else
        c

fn wm_term_rows(wh: Int, gh: Int, bar_h: Int) -> Int
    r = (wh - bar_h - 8) / gh
    if r < 1
        1
    else
        r

fn wm_lanzar_web() -> Int ! io, alloc
    spawn_io_4(d"/var/paquetes/soso-web/bin/soso-web", d"--grafico", d"--local", d"/var/paquetes/soso-web/share/ejemplo/web-prueba.html", fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())

fn wm_lanzar_ficheros() -> Int ! io, alloc
    spawn_io_full(d"/bin/soso-files", fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())

# Colores del chrome de soso-web (tema oscuro y claro): shell, fila de pestañas y botón.
fn prueba_web_color(b0: Int, b1: Int, b2: Int, r: Int, g: Int, b: Int) -> Int
    if b1 != g
        0
    elsif b0 == b
        if b2 == r
            1
        else
            0
    elsif b0 == r
        if b2 == b
            1
        else
            0
    else
        0

fn prueba_web_color_chrome(b0: Int, b1: Int, b2: Int) -> Int
    if prueba_web_color(b0, b1, b2, 40, 44, 56) != 0
        1
    elsif prueba_web_color(b0, b1, b2, 32, 34, 40) != 0
        1
    elsif prueba_web_color(b0, b1, b2, 64, 72, 88) != 0
        1
    elsif prueba_web_color(b0, b1, b2, 243, 244, 246) != 0
        1
    elsif prueba_web_color(b0, b1, b2, 232, 234, 239) != 0
        1
    elsif prueba_web_color(b0, b1, b2, 216, 220, 228) != 0
        1
    else
        0

fn prueba_web_pixel_ok(tab: Int, i: Int) -> Int ! alloc
    if tab_get(tab, i, tab_fase()) != 2
        0
    else
        cw = tab_get(tab, i, tab_cw())
        ch = tab_get(tab, i, tab_ch())
        shm = tab_get(tab, i, tab_shm_ptr())
        if cw < 20
            0
        elsif ch < 20
            0
        else
            slen = cw * ch * 4
            b = bytes_view_mem(shm, slen)
            off = (10 + 10 * cw) * 4
            prueba_web_color_chrome(bytes_get_u8(b, off), bytes_get_u8(b, off + 1), bytes_get_u8(b, off + 2))

fn wm_color_texto_barra(st: Int) -> Int ! alloc
    tema_texto(wm_tema_id(st))

fn wm_color_boton(st: Int) -> Int ! alloc
    tema_marco(wm_tema_id(st), 0)

fn wm_color_boton_activo(st: Int) -> Int ! alloc
    tema_acento(wm_tema_id(st))

fn wm_color_menu(st: Int) -> Int ! alloc
    tema_menu(wm_tema_id(st))

fn wm_color_menu_sel(st: Int) -> Int ! alloc
    tema_menu_sel(wm_tema_id(st))

fn wm_texto(st: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, s: String, x: Int, y: Int, fg: Int, bg: Int) -> Int ! io, alloc
    psf = wm_psf_wm(st)
    plen = wm_psf_len_wm(st)
    gw = wm_gw_wm(st)
    if psf > 0
        n = str_len(s)
        j = 0
        while j < n
            _d = fuente_dibujar(psf, plen, compos, clen, stride, bpp, fmt, str_char(s, j), fg, bg, x + j * gw, y)
            j = j + 1
    0

# Un rectángulo redondeado suelto, como escena de una primitiva (barra, menú, lista de ventanas).
fn wm_esc_rr(st: Int, compos: Int, clen: Int, w: Int, h: Int, stride: Int, bpp: Int, fmt: Int, x0: Int, y0: Int, x1: Int, y1: Int, rs: Int, rgb: Int) -> Int ! alloc
    e = st_get(st, st_escena())
    cap = wm_escena_cap()
    n = esc_rrect(e, cap, 0, x0, y0, x1, y1, rs, rgb, 255, 0, 0)
    esc_cpu_ejecutar(compos, clen, w, h, stride, bpp, fmt, e, cap, n)

fn wm_pintar_barra(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    gw = wm_gw_wm(st)
    gh = wm_gh_wm(st)
    bh = wm_bar_h(st)
    gmode = wm_comp_gpu_mode(st)
    y = 0
    while y < bh
        col = wm_barra_rgb_fila(st, y, sh)
        _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, y, sw, y + 1, col)
        y = y + 1
    radio = metrica_radio(gh)
    i = 0
    while i < lanz_n_botones()
        x0 = lanz_boton_x0(i, gw)
        bw = lanz_boton_ancho(i, gw)
        activo = 0
        bg = wm_color_boton(st)
        if i == 0
            if st_get(st, st_menu()) != 0
                activo = 1
        if activo != 0
            bg = wm_color_boton_activo(st)
        ty = (bh - gh) / 2
        if ty < 2
            ty = 2
        _b = wm_esc_rr(st, compos, clen, sw, sh, stride, bpp, fmt, x0, ty, x0 + bw, ty + gh + 4, esc_radios(radio, radio, 0, 0), bg)
        if gmode != 0
            ly = 0
            while ly < gh + 4
                col = wm_barra_rgb_fila(st, ty + ly, sh)
                _m = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, x0, ty + ly, x0 + bw, ty + ly + 1, col)
                ly = ly + 1
            _b2 = wm_esc_rr(st, compos, clen, sw, sh, stride, bpp, fmt, x0, ty, x0 + bw, ty + gh + 4, esc_radios(radio, radio, 0, 0), bg)
        txt = lanz_boton_texto(i)
        tx = x0 + lanz_margen(gw)
        _t = wm_texto(st, compos, clen, stride, bpp, fmt, txt, tx, ty + 2, wm_color_texto_barra(st), bg)
        i = i + 1
    _lv = wm_pintar_lista_ventanas(st, compos, clen, sw, sh, stride, bpp, fmt)
    _d = wm_marcar_dirty(st, 0, 0, sw, bh)
    0

fn wm_pintar_menu_cuerpo(st: Int, compos: Int, clen: Int, buf_w: Int, buf_h: Int, stride: Int, bpp: Int, fmt: Int, ox: Int, oy: Int, sw: Int, sh: Int, gmode: Int) -> Int ! io, alloc
    gw = wm_gw_wm(st)
    gh = wm_gh_wm(st)
    tema = wm_tema_id(st)
    mw = lanz_menu_ancho(gw, gh, tema)
    mh = lanz_menu_alto(gh)
    alto = lanz_menu_item_alto(gh)
    radio = metrica_radio(gh)
    sel = lanz_menu_item(st_get(st, st_mx()), st_get(st, st_my()), gw, gh, tema)
    y = 0
    while y < mh
        col = wm_menu_rgb_fila(st, oy + y, sh, oy)
        if gmode != 0
            col = wm_menu_rgb_fila(st, y, sh, oy)
        _f = rellenar_rect(compos, clen, buf_w, buf_h, stride, bpp, fmt, ox, oy + y, ox + mw, oy + y + 1, col)
        y = y + 1
    _r = wm_esc_rr(st, compos, clen, buf_w, buf_h, stride, bpp, fmt, ox, oy, ox + mw, oy + mh, esc_radios(radio, radio, 0, 0), wm_color_menu(st))
    k = 0
    while k < lanz_menu_n()
        iy = oy + k * alto + 2
        bg = wm_color_menu(st)
        if k == sel
            cap_x0 = ox + lanz_margen(gw) / 2
            cap_x1 = ox + mw - lanz_margen(gw) / 2
            cap_y0 = iy
            cap_y1 = iy + alto - 4
            _c = wm_esc_rr(st, compos, clen, buf_w, buf_h, stride, bpp, fmt, cap_x0, cap_y0, cap_x1, cap_y1, esc_radios(radio, radio, radio, radio), wm_color_menu_sel(st))
            bg = wm_color_menu_sel(st)
        _t = wm_texto(st, compos, clen, stride, bpp, fmt, lanz_menu_texto(k, tema), ox + lanz_margen(gw), iy + 2, wm_color_texto_barra(st), bg)
        k = k + 1
    0

fn wm_pintar_menu(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    if st_get(st, st_menu()) != 0
        gw = wm_gw_wm(st)
        gh = wm_gh_wm(st)
        tema = wm_tema_id(st)
        x0 = lanz_menu_x0(gw)
        y0 = lanz_menu_y0(gh)
        x1 = x0 + lanz_menu_ancho(gw, gh, tema)
        y1 = y0 + lanz_menu_alto(gh)
        _p = wm_pintar_menu_cuerpo(st, compos, clen, sw, sh, stride, bpp, fmt, x0, y0, sw, sh, 0)
        _d = wm_marcar_dirty(st, x0, y0, x1, y1)
    0

fn wm_pintar_menu_local(st: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, sw: Int, sh: Int) -> Int ! io, alloc
    if st_get(st, st_menu()) != 0
        gw = wm_gw_wm(st)
        gh = wm_gh_wm(st)
        tema = wm_tema_id(st)
        mw = lanz_menu_ancho(gw, gh, tema)
        mh = lanz_menu_alto(gh)
        x0 = lanz_menu_x0(gw)
        y0 = lanz_menu_y0(gh)
        _p = wm_pintar_menu_cuerpo(st, compos, clen, mw, mh, stride, bpp, fmt, 0, 0, sw, sh, 1)
        _d = wm_marcar_dirty(st, x0, y0, x0 + mw, y0 + mh)
    0

fn wm_menu_poner(st: Int, abierto: Int) -> Int ! alloc
    _s = st_set(st, st_menu(), abierto)
    _rp = wm_pedir_repintar(st)
    gw = wm_gw_wm(st)
    gh = wm_gh_wm(st)
    tema = wm_tema_id(st)
    x0 = lanz_menu_x0(gw)
    y0 = lanz_menu_y0(gh)
    _d = wm_marcar_dirty(st, x0, y0, x0 + lanz_menu_ancho(gw, gh, tema), y0 + lanz_menu_alto(gh))
    0

fn wm_ejecutar(st: Int, accion: Int, sw: Int, sh: Int) -> Int ! io, alloc
    if accion == lanz_menu()
        _m = wm_menu_poner(st, 1 - st_get(st, st_menu()))
    else
        _c = wm_menu_poner(st, 0)
        if accion == lanz_terminal()
            _t = wm_abrir_terminal(st, sw, sh)
        if accion == lanz_web()
            _w = wm_abrir_app(st, app_web(), 0)
        if accion == lanz_ficheros()
            _f = wm_abrir_app(st, app_ficheros(), 0)
        if accion == lanz_tema()
            _tm = wm_cambiar_tema(st)
        if accion == lanz_salir()
            _s = st_set(st, st_salir(), 1)
    0

fn wm_hit_test(st: Int, x: Int, y: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    k = nz - 1
    found = -1
    while k >= 0
        if found < 0
            i = z_get(z, k)
            if tab_slot_activo(tab, i) != 0
                if wm_oculta(tab, i) == 0
                    wx = tab_get(tab, i, tab_wx())
                    wy = tab_get(tab, i, tab_wy())
                    ww = tab_get(tab, i, tab_ww())
                    wh = tab_get(tab, i, tab_wh())
                    if ventana_contiene(x, y, wx, wy, ww, wh) != 0
                        found = i
        k = k - 1
    found

fn wm_foco_a(st: Int, i: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    if tab_slot_activo(tab, i) != 0
        _q = wm_quitar_min(tab, i)
        _f = st_set(st, st_focus(), i)
        _u = z_subir(z, nz, i)
        _rp = wm_pedir_repintar(st)
    0

fn wm_oculta(tab: Int, i: Int) -> Int ! alloc
    if (tab_get(tab, i, tab_estado()) & estado_min()) != 0
        1
    else
        0

fn wm_maximizada(tab: Int, i: Int) -> Int ! alloc
    if (tab_get(tab, i, tab_estado()) & estado_max()) != 0
        1
    else
        0

fn wm_quitar_min(tab: Int, i: Int) -> Int ! alloc
    if wm_oculta(tab, i) != 0
        _e = tab_set(tab, i, tab_estado(), tab_get(tab, i, tab_estado()) - estado_min())
    0

fn wm_cerrar_indice(st: Int, i: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    fi = st_get(st, st_focus())
    # Si cierra la cabecera de una ventana con más pestañas, otra pasa a ser la cabecera
    # y ocupa su sitio en el orden de ventanas.
    h = grupo_cab(tab, i)
    if h == i
        if grupo_n(tab, h) > 1
            m0 = grupo_miembro(tab, h, 0)
            if m0 == i
                m0 = grupo_miembro(tab, h, 1)
            _sp = grupo_separar(tab, i)
            nh = grupo_cab(tab, m0)
            _rz = z_reemplazar(z, nz, i, nh)
            if fi == i
                _nf = st_set(st, st_focus(), nh)
                fi = nh
    if tab_cerrar_slot(tab, i) != 0
        nn = z_quitar(z, nz, i)
        _n = st_set(st, st_nz(), nn)
        nfi = fi
        if fi == i
            nfi = -1
            if nn > 0
                nfi = z_get(z, nn - 1)
        _fo = st_set(st, st_focus(), nfi)
        _rp = wm_pedir_repintar(st)
        if i == st_get(st, st_ss_slot())
            _sr = wm_ss_reset(st)
            _tl = st_set(st, st_ss_last(), uptime_ms())
    0

# Cierra una pestaña: avisa al cliente y libera el panel.
fn wm_cerrar_pestana(st: Int, tab: Int, m: Int) -> Int ! io, alloc
    if tab_get(tab, m, tab_tipo()) == tab_tipo_cli()
        fd = tab_get(tab, m, tab_fd())
        msg = st_get(st, st_msg_buf())
        _e = msg_set_op(msg, op_cerrar_wm())
        _w = write_fd(fd, msg, msg_len())
    wm_cerrar_indice(st, m)

# Cierra la ventana entera: primero las pestañas no cabecera, al final la cabecera.
fn wm_cerrar_grupo(st: Int, h: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    cab = grupo_cab(tab, h)
    while grupo_n(tab, cab) > 1
        m = grupo_miembro(tab, cab, 0)
        if m == cab
            m = grupo_miembro(tab, cab, 1)
        _c = wm_cerrar_pestana(st, tab, m)
    wm_cerrar_pestana(st, tab, cab)

# Integra el panel `i` (o su ventana entera) como pestaña de la ventana de `dest`.
fn wm_integrar(st: Int, i: Int, dest: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    d = grupo_cab(tab, dest)
    if grupo_cab(tab, i) == grupo_cab(tab, dest)
        0
    else
        h = grupo_cab(tab, i)
        fi = st_get(st, st_focus())
        _g = grupo_integrar(tab, i, dest)
        nn = z_quitar(z, nz, h)
        if grupo_cab(tab, i) == d
            nn = z_quitar(z, nn, i)
        _n = st_set(st, st_nz(), nn)
        _f = st_set(st, st_focus(), d)
        _rp = wm_pedir_repintar(st)
        1

fn wm_aplicar_mosaic(st: Int, sw: Int, sh: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    mos = st_get(st, st_mosaic())
    # Las minimizadas no ocupan hueco.
    nv = 0
    c = 0
    while c < nz
        ic = z_get(z, c)
        if tab_slot_activo(tab, ic) != 0
            if wm_oculta(tab, ic) == 0
                nv = nv + 1
        c = c + 1
    vis = 0
    k = 0
    while k < nz
        i = z_get(z, k)
        if tab_slot_activo(tab, i) != 0
            # Una ventana maximizada deja de estarlo: la geometría la decide el mosaico.
            if wm_maximizada(tab, i) != 0
                _qm = tab_set(tab, i, tab_estado(), tab_get(tab, i, tab_estado()) - estado_max())
            if mos == 0
                _r = tab_restaurar_float(tab, i)
                _tr = wm_term_redimensionar_si(st, tab, i)
            if mos != 0
                if wm_oculta(tab, i) == 0
                    _g = tab_guardar_float(tab, i)
                    bh = wm_bar_h(st)
                    gh = wm_gh_wm(st)
                    wx = ventana_mosaico_wx(vis, nv, sw, sh)
                    wy = ventana_mosaico_wy(vis, nv, sw, sh, bh)
                    ww = ventana_mosaico_ww(vis, nv, sw, sh)
                    wh = ventana_mosaico_wh(vis, nv, sw, sh, bh)
                    nx = ventana_recortar_nx(wx)
                    ny = ventana_recortar_ny(wy, bh)
                    nw = ventana_recortar_nw(wx, ww, sw, nx)
                    nh = ventana_recortar_nh(wh, sh, ny, gh)
                    _x = tab_set(tab, i, tab_wx(), nx)
                    _y = tab_set(tab, i, tab_wy(), ny)
                    _w = tab_set(tab, i, tab_ww(), nw)
                    _h = tab_set(tab, i, tab_wh(), nh)
                    _tr2 = wm_term_redimensionar_si(st, tab, i)
                    vis = vis + 1
        k = k + 1
    _d = wm_marcar_dirty(st, 0, wm_bar_h(st), sw, sh)
    _rp = wm_pedir_repintar(st)
    0

fn wm_repintar_slot(st: Int, tab: Int, i: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int, completo: Int, zix: Int) -> Int ! io, alloc
    if tab_slot_activo(tab, i) != 0
        if wm_oculta(tab, i) != 0
            if wm_comp_gpu_mode(st) != 0
                _oc = wm_comp_send_geom(st, st_get(st, st_comp_fd()), wm_surf_win(i), 0, 0, 0, 0, comp_geom_hidden(), 50)
            0
        else
            wm_repintar_slot_vis(st, tab, i, compos, clen, sw, sh, stride, bpp, fmt, completo, zix)
    else
        0

fn wm_repintar_slot_vis(st: Int, tab: Int, i: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int, completo: Int, zix: Int) -> Int ! io, alloc
    if tab_slot_activo(tab, i) != 0
        a = grupo_panel_activo(tab, i)
        wx = tab_get(tab, i, tab_wx())
        wy = tab_get(tab, i, tab_wy())
        ww = tab_get(tab, i, tab_ww())
        wh = tab_get(tab, i, tab_wh())
        c = compos
        cl = clen
        px = wx
        py = wy
        fd = st_get(st, st_comp_fd())
        gmode = wm_comp_gpu_mode(st)
        if gmode != 0
            _we = wm_comp_win_ensure(st, fd, tab, i, stride)
            _wg = wm_comp_sync_win_geom(st, fd, tab, i, zix)
            c = wm_comp_tgt(st, compos, wm_surf_win(i))
            cl = ww * wh * 4
            px = 0
            py = 0
        if completo != 0
            if wm_es_ss(st, i) == 0
                _m = wm_pintar_marco(c, cl, sw, sh, stride, bpp, fmt, px, py, ww, wh, st, tab, i)
        if tab_get(tab, a, tab_tipo()) == tab_tipo_term()
            nv = wm_tab_escala(tab, a)
            psf = wm_psf_slot(st, nv)
            plen = wm_psf_len_slot(st, nv)
            gw = wm_tab_gw(tab, a)
            gh = wm_tab_gh(tab, a)
            bh = wm_bar_h(st)
            tema = wm_tema_id(st)
            if psf > 0
                grid = tab_get(tab, a, tab_shm_ptr())
                tst = tab_get(tab, a, tab_term_st())
                if completo != 0
                    _df = term_st_set(tst, st_dirty(), -1)
                dr = term_st_get(tst, st_dirty())
                cols = wm_term_cols(ww, gw)
                rows = wm_term_rows(wh, gh, bh)
                _t = term_pintar(tst, grid, cols * rows * celda_bytes(), cols, rows, psf, plen, gw, gh, tema, c, cl, sw, sh, stride, bpp, fmt, px + 4, py + bh + 4)
                if dr == -1
                    _d = wm_marcar_dirty(st, wx, wy, wx + ww, wy + wh)
                    if gmode != 0
                        _dm = wm_comp_dmap_surf(st, fd, wm_surf_win(i), 0, 0, ww, wh, wx, wy)
                if dr >= 0
                    ry = wy + bh + 4 + dr * gh
                    _d2 = wm_marcar_dirty(st, wx, ry, wx + ww, ry + gh)
                    if gmode != 0
                        lry = bh + 4 + dr * gh
                        _dm2 = wm_comp_dmap_surf(st, fd, wm_surf_win(i), 0, lry, ww, lry + gh, wx, wy)
        if tab_get(tab, a, tab_tipo()) == tab_tipo_cli()
            if completo != 0
                if tab_get(tab, a, tab_fase()) == 2
                    cw = tab_get(tab, a, tab_cw())
                    ch = tab_get(tab, a, tab_ch())
                    shm = tab_get(tab, a, tab_shm_ptr())
                    slen = cw * ch * 4
                    if wm_es_ss(st, i) == 0
                        _b = wm_blit_cliente(st, c, cl, stride, bpp, fmt, px, py, cw, ch, shm, slen, 0, 0, cw, ch)
                    else
                        _b = wm_blit_cliente_pantalla(c, cl, stride, bpp, fmt, px, py, cw, ch, shm, slen, 0, 0, cw, ch)
                    _d3 = wm_marcar_dirty(st, wx, wy, wx + ww, wy + wh)
                    if gmode != 0
                        _dm3 = wm_comp_dmap_surf(st, fd, wm_surf_win(i), 0, 0, ww, wh, wx, wy)
        if completo != 0
            if tab_get(tab, a, tab_tipo()) != tab_tipo_term()
                if tab_get(tab, a, tab_tipo()) != tab_tipo_cli()
                    _d4 = wm_marcar_dirty(st, wx, wy, wx + ww, wy + wh)
    0

fn wm_compose(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    fd = st_get(st, st_comp_fd())
    gmode = wm_comp_gpu_mode(st)
    gw = wm_gw_wm(st)
    gh = wm_gh_wm(st)
    tema = wm_tema_id(st)
    completo = 0
    if st_get(st, st_fondo()) == 0
        completo = 1
    if st_get(st, st_repintar()) != 0
        completo = 1
    if completo != 0
        bh = wm_bar_h(st)
        if gmode != 0
            _nc = st_set(st, st_comp_need_clear(), 1)
            fondo_tgt = wm_comp_tgt(st, compos, wm_surf_fondo())
            fondo_cl = sw * sh * 4
            _fe = wm_surf_ensure(st, fd, wm_surf_fondo(), sw, sh, stride)
            _pf = wm_pintar_fondo_gpu(st, fondo_tgt, fondo_cl, sw, sh, stride, bpp, fmt)
            _gf = wm_comp_send_geom(st, fd, wm_surf_fondo(), 0, 0, sw, sh, comp_geom_opaque(), 0)
            _df = wm_comp_dmap_surf(st, fd, wm_surf_fondo(), 0, 0, sw, sh, 0, 0)
            _db = wm_marcar_dirty(st, 0, 0, sw, sh)
        else
            _bg = wm_pintar_fondo(st, compos, clen, sw, sh, stride, bpp, fmt)
            _db = wm_marcar_dirty(st, 0, 0, sw, sh)
        bar_tgt = wm_comp_tgt(st, compos, wm_surf_bar())
        bar_cl = clen
        if gmode != 0
            bar_cl = sw * bh * 4
        _bar = wm_pintar_barra(st, bar_tgt, bar_cl, sw, sh, stride, bpp, fmt)
        if gmode != 0
            _bd = wm_comp_dmap_surf(st, fd, wm_surf_bar(), 0, 0, sw, bh, 0, 0)
            _gb = wm_comp_send_geom(st, fd, wm_surf_bar(), 0, 0, sw, bh, comp_geom_opaque(), 5)
        _sf = st_set(st, st_fondo(), 1)
        _rp = st_set(st, st_repintar(), 0)
    if completo == 0
        if gmode == 0
            if st_get(st, st_ss_slot()) < 0
                _re = wm_cursor_restaurar(st, compos, clen, stride, bpp, fmt)
    k = 0
    while k < nz
        i = z_get(z, k)
        _r = wm_repintar_slot(st, tab, i, compos, clen, sw, sh, stride, bpp, fmt, completo, k)
        k = k + 1
    if completo != 0
        if gmode == 0
            _men = wm_pintar_menu(st, compos, clen, sw, sh, stride, bpp, fmt)
        else
            if st_get(st, st_menu()) != 0
                mw = lanz_menu_ancho(gw, gh, tema)
                mh = lanz_menu_alto(gh)
                mcl = mw * mh * 4
                mt = wm_comp_tgt(st, compos, wm_surf_menu())
                _ml = wm_pintar_menu_local(st, mt, mcl, stride, bpp, fmt, sw, sh)
                mx0 = lanz_menu_x0(gw)
                my0 = lanz_menu_y0(gh)
                _mg = wm_comp_send_geom(st, fd, wm_surf_menu(), mx0, my0, mw, mh, comp_geom_opaque(), 50)
                _md = wm_comp_dmap_surf(st, fd, wm_surf_menu(), 0, 0, mw, mh, mx0, my0)
            else
                _mh = wm_comp_send_geom(st, fd, wm_surf_menu(), 0, 0, 0, 0, comp_geom_hidden(), 50)
    if completo == 0
        if st_get(st, st_menu()) != 0
            if gmode == 0
                _men2 = wm_pintar_menu(st, compos, clen, sw, sh, stride, bpp, fmt)
            else
                mw2 = lanz_menu_ancho(gw, gh, tema)
                mh2 = lanz_menu_alto(gh)
                mcl = mw2 * mh2 * 4
                mt = wm_comp_tgt(st, compos, wm_surf_menu())
                _ml2 = wm_pintar_menu_local(st, mt, mcl, stride, bpp, fmt, sw, sh)
                mx02 = lanz_menu_x0(gw)
                my02 = lanz_menu_y0(gh)
                _mg2 = wm_comp_send_geom(st, fd, wm_surf_menu(), mx02, my02, mw2, mh2, comp_geom_opaque(), 50)
                _md2 = wm_comp_dmap_surf(st, fd, wm_surf_menu(), 0, 0, mw2, mh2, mx02, my02)
    if gmode == 0
        _cxm = wm_pintar_ctx(st, compos, clen, sw, sh, stride, bpp, fmt)
    if gmode == 0
        _cap = wm_cursor_capturar(st, compos, clen, stride, bpp, fmt)
        _cur = wm_pintar_cursor(st, compos, clen, sw, sh, stride, bpp, fmt)
    else
        cur_tgt = wm_comp_tgt(st, compos, wm_surf_cursor())
        cur_cl = wm_cursor_w() * wm_cursor_h() * 4
        mx = st_get(st, st_mx())
        my = st_get(st, st_my())
        _cg = wm_comp_send_geom(st, fd, wm_surf_cursor(), mx, my, wm_cursor_w(), wm_cursor_h(), 0, 60)
        _cur = wm_pintar_cursor_buf(st, cur_tgt, cur_cl, wm_cursor_w() * 4, bpp, fmt, 0, 0)
        _cd = wm_comp_dmap_surf(st, fd, wm_surf_cursor(), 0, 0, wm_cursor_w(), wm_cursor_h(), mx, my)
    _cm = wm_cursor_marcar(st, st_get(st, st_mx()), st_get(st, st_my()))
    0

fn wm_marcar_dirty(st: Int, x0: Int, y0: Int, x1: Int, y1: Int) -> Int ! alloc
    if st_get(st, st_dx1()) <= st_get(st, st_dx0())
        _a = st_set(st, st_dx0(), x0)
        _b = st_set(st, st_dy0(), y0)
        _c = st_set(st, st_dx1(), x1)
        _d = st_set(st, st_dy1(), y1)
    if st_get(st, st_dx1()) > st_get(st, st_dx0())
        ox0 = st_get(st, st_dx0())
        oy0 = st_get(st, st_dy0())
        ox1 = st_get(st, st_dx1())
        oy1 = st_get(st, st_dy1())
        _a = st_set(st, st_dx0(), min(ox0, x0))
        _b = st_set(st, st_dy0(), min(oy0, y0))
        _c = st_set(st, st_dx1(), max(ox1, x1))
        _d = st_set(st, st_dy1(), max(oy1, y1))
    0

fn wm_color_fondo(st: Int) -> Int ! alloc
    tema_fondo_abajo(wm_tema_id(st))

fn wm_color_barra(st: Int) -> Int ! alloc
    tema_barra(wm_tema_id(st))

fn wm_color_barra_foco(st: Int) -> Int ! alloc
    tema_acento(wm_tema_id(st))

# Redimensiona los terminales de todos los paneles de la ventana de `i`.
fn wm_term_redimensionar_si(st: Int, tab: Int, i: Int) -> Int ! alloc
    cab = grupo_cab(tab, i)
    n = grupo_n(tab, cab)
    r = 0
    k = 0
    while k < n
        m = grupo_miembro(tab, cab, k)
        r = r + wm_term_redimensionar_uno(st, tab, m)
        k = k + 1
    r

fn wm_term_redimensionar_uno(st: Int, tab: Int, i: Int) -> Int ! alloc
    if tab_get(tab, i, tab_tipo()) != tab_tipo_term()
        0
    else
        ww = tab_get(tab, i, tab_ww())
        wh = tab_get(tab, i, tab_wh())
        gw = wm_tab_gw(tab, i)
        gh = wm_tab_gh(tab, i)
        bh = wm_bar_h(st)
        cols = wm_term_cols(ww, gw)
        rows = wm_term_rows(wh, gh, bh)
        grid = tab_get(tab, i, tab_shm_ptr())
        tst = tab_get(tab, i, tab_term_st())
        ow = term_st_get(tst, st_cols())
        oh = term_st_get(tst, st_rows())
        if cols == ow
            if rows == oh
                0
            else
                glen = ow * oh * celda_bytes()
                newg = term_redimensionar(tst, grid, glen, ow, oh, cols, rows)
                _g = tab_set(tab, i, tab_shm_ptr(), newg)
                _c = tab_set(tab, i, tab_cw(), cols * gw)
                _r = tab_set(tab, i, tab_ch(), rows * gh)
                _d = term_st_set(tst, st_dirty(), -1)
                1
        else
            glen = ow * oh * celda_bytes()
            newg = term_redimensionar(tst, grid, glen, ow, oh, cols, rows)
            _g = tab_set(tab, i, tab_shm_ptr(), newg)
            _c = tab_set(tab, i, tab_cw(), cols * gw)
            _r = tab_set(tab, i, tab_ch(), rows * gh)
            _d = term_st_set(tst, st_dirty(), -1)
            1

fn wm_repintar_ventana(st: Int, tab: Int, i: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc, io
    if grupo_panel_activo(tab, i) == i
        wm_repintar_ventana_vis(st, tab, i, compos, clen, sw, sh, stride, bpp, fmt)
    else
        wm_pedir_repintar(st)

fn wm_repintar_ventana_vis(st: Int, tab: Int, i: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc, io
    wx = st_get(st, st_wx())
    wy = st_get(st, st_wy())
    ww = st_get(st, st_ww())
    wh = st_get(st, st_wh())
    cw = st_get(st, st_cw())
    ch = st_get(st, st_ch())
    shm = st_get(st, st_shm_ptr())
    slen = cw * ch * 4
    if wm_es_ss(st, i) == 0
        _m = wm_pintar_marco(compos, clen, sw, sh, stride, bpp, fmt, wx, wy, ww, wh, st, tab, i)
        _b = wm_blit_cliente(st, compos, clen, stride, bpp, fmt, wx, wy, cw, ch, shm, slen, 0, 0, cw, ch)
    else
        _b = wm_blit_cliente_pantalla(compos, clen, stride, bpp, fmt, wx, wy, cw, ch, shm, slen, 0, 0, cw, ch)
    _d = wm_marcar_dirty(st, wx, wy, wx + ww, wy + wh)
    0

fn wm_titulo_largo(tab: Int, i: Int) -> Int ! alloc
    tit = bytes_view_mem(tab + tab_slot_off(i) + tab_titulo_off(), 32)
    n = 0
    j = 0
    while j < 16
        c = bytes_get_u8(tit, j)
        if c == 0
            j = 16
        else
            if c != 32
                n = j + 1
            j = j + 1
    n

# Título del panel `m` en (x, y), como mucho `maxc` caracteres; si no cabe, termina en «...».
fn wm_texto_titulo(st: Int, tab: Int, m: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, x: Int, y: Int, maxc: Int, col: Int, bg: Int) -> Int ! io, alloc
    psf = wm_psf_wm(st)
    plen = wm_psf_len_wm(st)
    gw = wm_gw_wm(st)
    if psf > 0
        tit = bytes_view_mem(tab + tab_slot_off(m) + tab_titulo_off(), 32)
        n = wm_titulo_largo(tab, m)
        corta = 0
        if n > maxc
            corta = 1
            n = maxc
        j = 0
        while j < n
            ch = bytes_get_u8(tit, j)
            if corta != 0
                if j >= n - 3
                    ch = 46
            if ch != 32
                _d = fuente_dibujar(psf, plen, compos, clen, stride, bpp, fmt, ch, col, bg, x + j * gw, y)
            j = j + 1
    0

# Botón «+» de la barra de título.
# "+" de la tira de pestañas, como primitivas.
fn wm_esc_mas(st: Int, e: Int, cap: Int, n0: Int, wx: Int, wy: Int, ww: Int, gh: Int, foco: Int, i: Int) -> Int ! alloc
    tema = wm_tema_id(st)
    d = ventana_btn_d(gh)
    cx = pest_mas_x(wx, ww, gh)
    cy = ventana_btn_cy(wy, gh)
    col = tema_boton_inactivo(tema)
    if st_get(st, st_hover_pest()) == i * 1000 + 200
        col = mezclar_rgb(color_rgb(255, 255, 255), col, 56)
    n = esc_rrect(e, cap, n0, cx, cy, cx + d, cy + d, esc_radios(d / 2, d / 2, d / 2, d / 2), col, 255, 0, 0)
    m = d / 4
    mid = d / 2
    gl = tema_glifo_boton(tema)
    n = esc_solido(e, cap, n, cx + m, cy + mid, cx + d - m, cy + mid + 1, gl, 255)
    n = esc_solido(e, cap, n, cx + mid, cy + m, cx + mid + 1, cy + d - m, gl, 255)
    n

# 1 si el puntero está sobre la pestaña `k` (o su aspa) del grupo `i`.
fn wm_pest_hov(st: Int, i: Int, k: Int) -> Int ! alloc
    h = st_get(st, st_hover_pest())
    if h == i * 1000 + k + 1
        1
    elsif h == i * 1000 + 100 + k + 1
        1
    else
        0

fn wm_pest_bgt(st: Int, m: Int, act: Int, k: Int, i: Int, bg: Int) -> Int ! alloc
    tema = wm_tema_id(st)
    if m == act
        tema_cliente_bg(tema)
    else
        bgt = mezclar_rgb(bg, color_rgb(0, 0, 0), 190)
        if wm_pest_hov(st, i, k) != 0
            bgt = mezclar_rgb(color_rgb(255, 255, 255), bgt, 24)
        bgt

fn wm_pest_col(st: Int, m: Int, act: Int, k: Int, i: Int, foco: Int) -> Int ! alloc
    tema = wm_tema_id(st)
    col = tema_texto_tenue(tema)
    if wm_pest_hov(st, i, k) != 0
        col = tema_texto(tema)
    if m == act
        col = tema_texto(tema)
        if foco == 0
            col = tema_texto_tenue(tema)
    col

# Glifo de un botón como primitivas: 0 cerrar (aspa), 1 maximizar (cuadrado), 2 minimizar (raya).
fn wm_esc_glifo(e: Int, cap: Int, n0: Int, cx: Int, cy: Int, d: Int, k: Int, col: Int) -> Int ! alloc
    m = d / 4
    a = d - 2 * m
    n = n0
    if k == 0
        j = 0
        while j < a
            n = esc_solido(e, cap, n, cx + m + j, cy + m + j, cx + m + j + 1, cy + m + j + 1, col, 255)
            n = esc_solido(e, cap, n, cx + d - m - 1 - j, cy + m + j, cx + d - m - j, cy + m + j + 1, col, 255)
            j = j + 1
    if k == 1
        n = esc_solido(e, cap, n, cx + m, cy + m, cx + m + a, cy + m + 1, col, 255)
        n = esc_solido(e, cap, n, cx + m, cy + m + a - 1, cx + m + a, cy + m + a, col, 255)
        n = esc_solido(e, cap, n, cx + m, cy + m, cx + m + 1, cy + m + a, col, 255)
        n = esc_solido(e, cap, n, cx + m + a - 1, cy + m, cx + m + a, cy + m + a, col, 255)
    if k == 2
        n = esc_solido(e, cap, n, cx + m, cy + d / 2, cx + m + a, cy + d / 2 + 1, col, 255)
    n

# Icono de 10 px por tipo de aplicación (terminal, web, archivos) como primitivas.
fn wm_esc_icono(st: Int, tab: Int, m: Int, e: Int, cap: Int, n0: Int, x: Int, y: Int, col: Int, bgt: Int) -> Int ! alloc
    n = n0
    app = tab_get(tab, m, tab_app())
    if tab_get(tab, m, tab_tipo()) == tab_tipo_term()
        n = esc_rrect(e, cap, n, x, y + 1, x + 10, y + 9, esc_radios(2, 2, 2, 2), col, 255, 0, 0)
        n = esc_solido(e, cap, n, x + 1, y + 2, x + 9, y + 8, bgt, 255)
        n = esc_solido(e, cap, n, x + 2, y + 3, x + 4, y + 4, col, 255)
        n = esc_solido(e, cap, n, x + 3, y + 4, x + 5, y + 5, col, 255)
        n = esc_solido(e, cap, n, x + 2, y + 5, x + 4, y + 6, col, 255)
        n = esc_solido(e, cap, n, x + 6, y + 6, x + 8, y + 7, col, 255)
    elsif app == app_ficheros()
        n = esc_solido(e, cap, n, x, y + 1, x + 4, y + 3, col, 255)
        n = esc_rrect(e, cap, n, x, y + 2, x + 10, y + 9, esc_radios(1, 1, 1, 1), col, 255, 0, 0)
        n = esc_solido(e, cap, n, x + 1, y + 4, x + 9, y + 8, bgt, 255)
    else
        n = esc_rrect(e, cap, n, x, y, x + 10, y + 10, esc_radios(5, 5, 5, 5), col, 255, 0, 0)
        n = esc_rrect(e, cap, n, x + 1, y + 1, x + 9, y + 9, esc_radios(4, 4, 4, 4), bgt, 255, 0, 0)
        n = esc_solido(e, cap, n, x + 1, y + 5, x + 9, y + 6, col, 255)
        n = esc_solido(e, cap, n, x + 5, y + 1, x + 6, y + 9, col, 255)
    n

# Fondos de la tira de pestañas (2 o más paneles); el texto va después, encima.
fn wm_esc_pestanas(st: Int, tab: Int, i: Int, e: Int, cap: Int, n0: Int, wx: Int, wy: Int, ww: Int, bg: Int, gw: Int, gh: Int, bh: Int, foco: Int) -> Int ! alloc
    tema = wm_tema_id(st)
    n = n0
    cnt = grupo_n(tab, i)
    if cnt > 1
        act = grupo_panel_activo(tab, i)
        tw = pest_ancho(wx, ww, gh, cnt)
        radio = 6
        k = 0
        while k < cnt
            m = grupo_miembro(tab, i, k)
            tx = pest_pos_x(wx, ww, gh, cnt, k)
            x1 = tx + tw - 2
            y0 = wy + 4
            y1 = wy + bh - 1
            esact = 0
            if m == act
                esact = 1
                y1 = wy + bh
            bgt = wm_pest_bgt(st, m, act, k, i, bg)
            col = wm_pest_col(st, m, act, k, i, foco)
            n = esc_rrect(e, cap, n, tx, y0, x1, y1, esc_radios(radio, radio, 0, 0), bgt, 255, 0, 0)
            if esact != 0
                if foco != 0
                    n = esc_solido(e, cap, n, tx + radio, y0, x1 - radio, y0 + 2, tema_acento(tema), 255)
            n = wm_esc_icono(st, tab, m, e, cap, n, tx + 9, wy + (bh - 10) / 2 + 1, col, bgt)
            if esact == 0
                if tab_get(tab, m, tab_pend()) != 0
                    # Actividad pendiente: punto de acento en la pestaña.
                    n = esc_rrect(e, cap, n, x1 - 14, wy + bh / 2 - 3, x1 - 8, wy + bh / 2 + 3, esc_radios(3, 3, 3, 3), tema_acento(tema), 255, 0, 0)
            if esact != 0
                n = wm_esc_glifo(e, cap, n, x1 - 18, wy + (bh - 10) / 2 + 1, 10, 0, col)
            elsif wm_pest_hov(st, i, k) != 0
                n = wm_esc_glifo(e, cap, n, x1 - 18, wy + (bh - 10) / 2 + 1, 10, 0, col)
            k = k + 1
    n

# Texto de las pestañas (o título centrado con un solo panel), sobre los fondos ya pintados.
fn wm_pintar_marco_titulo(st: Int, tab: Int, i: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int, wx: Int, wy: Int, ww: Int, bg: Int, gw: Int, gh: Int, bh: Int, foco: Int) -> Int ! io, alloc
    tema = wm_tema_id(st)
    cnt = grupo_n(tab, i)
    act = grupo_panel_activo(tab, i)
    if cnt <= 1
        nn = wm_titulo_largo(tab, act)
        cx = wx + (ww - nn * gw) / 2
        izq = wx + 14
        if cx < izq
            cx = izq
        cy = wy + (bh - gh) / 2
        col = tema_texto(tema)
        if foco == 0
            col = tema_texto_tenue(tema)
        _t = wm_texto_titulo(st, tab, act, compos, clen, stride, bpp, fmt, cx, cy, 16, col, bg)
    else
        tw = pest_ancho(wx, ww, gh, cnt)
        k = 0
        while k < cnt
            m = grupo_miembro(tab, i, k)
            tx = pest_pos_x(wx, ww, gh, cnt, k)
            bgt = wm_pest_bgt(st, m, act, k, i, bg)
            col = wm_pest_col(st, m, act, k, i, foco)
            maxc = (tw - 2 - 26 - pest_cierre_ancho()) / gw
            _tt = wm_texto_titulo(st, tab, m, compos, clen, stride, bpp, fmt, tx + 24, wy + (bh - gh) / 2 + 1, maxc, col, bgt)
            k = k + 1
    0

# Botones de la ventana (cerrar, maximizar, minimizar) como primitivas.
fn wm_esc_botones(st: Int, e: Int, cap: Int, n0: Int, wx: Int, wy: Int, ww: Int, gh: Int, foco: Int, i: Int) -> Int ! alloc
    tema = wm_tema_id(st)
    d = ventana_btn_d(gh)
    cy = ventana_btn_cy(wy, gh)
    hov = st_get(st, st_hover())
    n = n0
    k = 0
    while k < 3
        cx = ventana_btn_cx(wx, ww, gh, k)
        sobre = 0
        if hov == i * 8 + k + 1
            sobre = 1
        col = tema_boton_inactivo(tema)
        if foco != 0
            if k == 0
                col = tema_boton_cerrar(tema)
            if k == 1
                col = tema_boton_max(tema)
            if k == 2
                col = tema_boton_min(tema)
        if sobre != 0
            # Con el puntero encima, el botón se enciende aunque la ventana no tenga el foco.
            if k == 0
                col = tema_boton_cerrar(tema)
            if k == 1
                col = tema_boton_max(tema)
            if k == 2
                col = tema_boton_min(tema)
            col = mezclar_rgb(color_rgb(255, 255, 255), col, 56)
        n = esc_rrect(e, cap, n, cx, cy, cx + d, cy + d, esc_radios(d / 2, d / 2, d / 2, d / 2), col, 255, 0, 0)
        if foco != 0
            n = wm_esc_glifo(e, cap, n, cx, cy, d, k, tema_glifo_boton(tema))
        if foco == 0
            if sobre != 0
                n = wm_esc_glifo(e, cap, n, cx, cy, d, k, tema_glifo_boton(tema))
        k = k + 1
    n

fn wm_pintar_marco(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int, wx: Int, wy: Int, ww: Int, wh: Int, st: Int, tab: Int, i0: Int) -> Int ! io, alloc
    i = grupo_cab(tab, i0)
    gw = wm_gw_wm(st)
    gh = wm_gh_wm(st)
    bh = wm_bar_h(st)
    tema = wm_tema_id(st)
    radio = metrica_radio(gh)
    foco = 0
    if st_get(st, st_focus()) == i
        foco = 1
    col_m = tema_marco(tema, foco)
    col_b = tema_borde(tema, foco)
    gmode = wm_comp_gpu_mode(st)
    maxim = wm_maximizada(tab, i)
    # El marco se describe como escena de primitivas y se ejecuta con el backend CPU.
    e = st_get(st, st_escena())
    cap = wm_escena_cap()
    n = 0
    if gmode == 0
        # Sombra suave: tres capas cada vez más anchas y tenues, algo desplazadas hacia abajo.
        if maxim == 0
            sa = tema_sombra_alfa(tema) / 3
            neg = color_rgb(0, 0, 0)
            n = esc_anillo(e, cap, n, wx - 1, wy + 1, wx + ww + 1, wy + wh + 5, wx, wy, wx + ww, wy + wh, neg, sa)
            n = esc_anillo(e, cap, n, wx - 3, wy + 1, wx + ww + 3, wy + wh + 8, wx, wy, wx + ww, wy + wh, neg, sa)
            n = esc_anillo(e, cap, n, wx - 5, wy + 2, wx + ww + 5, wy + wh + 11, wx, wy, wx + ww, wy + wh, neg, sa)
            # Bajo las esquinas redondeadas también debe haber sombra.
            n = esc_solido(e, cap, n, wx, wy + wh - radio, wx + radio, wy + wh, neg, sa * 2)
            n = esc_solido(e, cap, n, wx + ww - radio, wy + wh - radio, wx + ww, wy + wh, neg, sa * 2)
        if maxim != 0
            radio = 0
        # Borde de 1 px y cuerpo: las cuatro esquinas redondeadas (abajo y a la derecha hay
        # un margen de 8 px que el contenido nunca pisa).
        n = esc_rrect(e, cap, n, wx, wy, wx + ww, wy + wh, esc_radios(radio, radio, radio, radio), col_b, 255, 0, 0)
        ri = max(0, radio - 1)
        n = esc_rrect(e, cap, n, wx + 1, wy + 1, wx + ww - 1, wy + wh - 1, esc_radios(ri, ri, ri, ri), tema_cliente_bg(tema), 255, 0, 0)
        n = esc_rrect(e, cap, n, wx + 1, wy + 1, wx + ww - 1, wy + bh, esc_radios(ri, ri, 0, 0), col_m, 255, 0, 0)
    if gmode != 0
        n = esc_solido(e, cap, n, wx, wy, wx + ww, wy + wh, col_b, 255)
        n = esc_solido(e, cap, n, wx + 1, wy + 1, wx + ww - 1, wy + wh - 1, tema_cliente_bg(tema), 255)
        ri2 = max(0, radio - 1)
        n = esc_rrect(e, cap, n, wx + 1, wy + 1, wx + ww - 1, wy + bh, esc_radios(ri2, ri2, 0, 0), col_m, 255, 0, 0)
    # Línea bajo la barra: acento si la ventana tiene el foco.
    lin = col_b
    if foco != 0
        lin = tema_acento(tema)
    n = esc_solido(e, cap, n, wx + 1, wy + bh - 1, wx + ww - 1, wy + bh, lin, 255)
    n = wm_esc_pestanas(st, tab, i, e, cap, n, wx, wy, ww, col_m, gw, gh, bh, foco)
    n = wm_esc_mas(st, e, cap, n, wx, wy, ww, gh, foco, i)
    n = wm_esc_botones(st, e, cap, n, wx, wy, ww, gh, foco, i)
    if st_get(st, st_drop()) == i
        # Destino de un arrastre: barra de inserción tras la última pestaña.
        cnt = grupo_n(tab, i)
        ix = pest_pos_x(wx, ww, gh, cnt, cnt) - 2
        n = esc_solido(e, cap, n, ix, wy + 4, ix + 3, wy + bh, tema_acento(tema), 255)
    _ej = esc_cpu_ejecutar(compos, clen, sw, sh, stride, bpp, fmt, e, cap, n)
    _ti = wm_pintar_marco_titulo(st, tab, i, compos, clen, sw, sh, stride, bpp, fmt, wx, wy, ww, col_m, gw, gh, bh, foco)
    0

fn wm_blit_cliente(st: Int, compos: Int, clen: Int, cstride: Int, bpp: Int, fmt: Int, wx: Int, wy: Int, cw: Int, ch: Int, shm: Int, slen: Int, sx: Int, sy: Int, w: Int, h: Int) -> Int ! alloc
    bh = wm_bar_h(st)
    copiar_rect(compos, clen, cstride, shm, slen, cw, bpp, fmt, wx + 4 + sx, wy + bh + sy, sx, sy, w, h)

fn wm_blit_cliente_pantalla(compos: Int, clen: Int, cstride: Int, bpp: Int, fmt: Int, wx: Int, wy: Int, cw: Int, ch: Int, shm: Int, slen: Int, sx: Int, sy: Int, w: Int, h: Int) -> Int ! alloc
    copiar_rect(compos, clen, cstride, shm, slen, cw, bpp, fmt, wx + sx, wy + sy, sx, sy, w, h)

fn wm_comp_gpu_mode(st: Int) -> Int ! alloc
    if st_get(st, st_comp_fd()) < 0
        0
    else
        if st_get(st, st_comp_gpu_ok()) == 0
            0
        else
            1

fn wm_comp_tgt(st: Int, compos: Int, surf_id: Int) -> Int ! alloc
    if wm_comp_gpu_mode(st) == 0
        compos
    else
        tab = st_get(st, st_wsurf_tab())
        ptr = wm_surf_get(tab, surf_id, wm_surf_ptr())
        if ptr > 0
            ptr
        else
            compos

fn wm_comp_send_bind(st: Int, fd: Int, id: Int, sid: Int, w: Int, h: Int, stride: Int) -> Int ! io, alloc
    m = st_get(st, st_msg_buf())
    _e = msg_encode_comp_bind(m, id, sid, w, h, stride)
    _w = write_fd(fd, m, msg_len())
    0

fn wm_comp_send_geom(st: Int, fd: Int, id: Int, x: Int, y: Int, w: Int, h: Int, flags: Int, z: Int) -> Int ! io, alloc
    m = st_get(st, st_msg_buf())
    _e = msg_encode_comp_geom(m, id, x, y, w, h, flags, z)
    _w = write_fd(fd, m, msg_len())
    0

fn wm_comp_send_dmap(st: Int, fd: Int, id: Int, x: Int, y: Int, w: Int, h: Int) -> Int ! io, alloc
    m = st_get(st, st_msg_buf())
    _e = msg_encode_comp_dmap(m, id, x, y, w, h)
    _w = write_fd(fd, m, msg_len())
    0

fn wm_comp_send_commit(st: Int, fd: Int, x: Int, y: Int, w: Int, h: Int, flags: Int) -> Int ! io, alloc
    m = st_get(st, st_msg_buf())
    _e = msg_encode_comp_commit(m, x, y, w, h, flags)
    _w = write_fd(fd, m, msg_len())
    0

fn wm_surf_ensure(st: Int, fd: Int, surf_id: Int, w: Int, h: Int, stride: Int) -> Int ! io, alloc
    tab = st_get(st, st_wsurf_tab())
    sid = wm_surf_get(tab, surf_id, wm_surf_sid())
    if sid > 0
        wm_surf_get(tab, surf_id, wm_surf_ptr())
    else
        clen = stride * h
        nsid = shm_create(clen)
        if nsid < 0
            0
        else
            ptr = shm_map(nsid)
            if ptr < 0
                0
            else
                _s = wm_surf_set(tab, surf_id, wm_surf_sid(), nsid)
                _p = wm_surf_set(tab, surf_id, wm_surf_ptr(), ptr)
                _w = wm_surf_set(tab, surf_id, wm_surf_w(), w)
                _h = wm_surf_set(tab, surf_id, wm_surf_h(), h)
                _t = wm_surf_set(tab, surf_id, wm_surf_stride(), stride)
                _b = wm_comp_send_bind(st, fd, surf_id, nsid, w, h, stride)
                ptr

fn wm_comp_gpu_init(st: Int, fd: Int, sw: Int, sh: Int, stride: Int) -> Int ! io, alloc
    if wm_comp_gpu_mode(st) == 0
        0
    else
        gw = wm_gw_wm(st)
        gh = wm_gh_wm(st)
        tema = wm_tema_id(st)
        bh = wm_bar_h(st)
        _fon = wm_surf_ensure(st, fd, wm_surf_fondo(), sw, sh, stride)
        _bar = wm_surf_ensure(st, fd, wm_surf_bar(), sw, bh, stride)
        mw = lanz_menu_ancho(gw, gh, tema)
        mh = lanz_menu_alto(gh)
        _men = wm_surf_ensure(st, fd, wm_surf_menu(), mw, mh, stride)
        cw = wm_cursor_w()
        ch = wm_cursor_h()
        cstride = cw * 4
        _cur = wm_surf_ensure(st, fd, wm_surf_cursor(), cw, ch, cstride)
        _gf = wm_comp_send_geom(st, fd, wm_surf_fondo(), 0, 0, sw, sh, comp_geom_opaque(), 0)
        _g0 = wm_comp_send_geom(st, fd, wm_surf_bar(), 0, 0, sw, bh, comp_geom_opaque(), 5)
        _g1 = wm_comp_send_geom(st, fd, wm_surf_menu(), 0, 0, 0, 0, comp_geom_hidden(), 50)
        _g2 = wm_comp_send_geom(st, fd, wm_surf_cursor(), 0, 0, cw, ch, 0, 60)
        _c = st_set(st, st_comp_need_clear(), 1)
        1

fn wm_comp_dmap_surf(st: Int, fd: Int, surf_id: Int, x0: Int, y0: Int, x1: Int, y1: Int, gx: Int, gy: Int) -> Int ! io, alloc
    if x1 > x0
        if y1 > y0
            _d = wm_comp_send_dmap(st, fd, surf_id, x0, y0, x1 - x0, y1 - y0)
            _m = wm_marcar_dirty(st, gx + x0, gy + y0, gx + x1, gy + y1)
    0

fn wm_comp_win_ensure(st: Int, fd: Int, tab: Int, i: Int, stride: Int) -> Int ! io, alloc
    ww = tab_get(tab, i, tab_ww())
    wh = tab_get(tab, i, tab_wh())
    sid = wm_surf_win(i)
    wm_surf_ensure(st, fd, sid, ww, wh, stride)

fn wm_comp_sync_win_geom(st: Int, fd: Int, tab: Int, i: Int, z: Int) -> Int ! io, alloc
    wx = tab_get(tab, i, tab_wx())
    wy = tab_get(tab, i, tab_wy())
    ww = tab_get(tab, i, tab_ww())
    wh = tab_get(tab, i, tab_wh())
    sid = wm_surf_win(i)
    _g = wm_comp_send_geom(st, fd, sid, wx, wy, ww, wh, comp_geom_opaque(), 10 + z)
    0

fn wm_comp_flush_scene(st: Int) -> Int ! io, alloc
    fd = st_get(st, st_comp_fd())
    if wm_comp_gpu_mode(st) == 0
        0
    else
        x0 = st_get(st, st_dx0())
        y0 = st_get(st, st_dy0())
        x1 = st_get(st, st_dx1())
        y1 = st_get(st, st_dy1())
        if x1 > x0
            if y1 > y0
                fl = 0
                if st_get(st, st_comp_need_clear()) != 0
                    fl = comp_commit_clear_rt()
                    _nc = st_set(st, st_comp_need_clear(), 0)
                _c = wm_comp_send_commit(st, fd, x0, y0, x1 - x0, y1 - y0, fl)
                _r = st_set(st, st_dx0(), 0)
                _s = st_set(st, st_dy0(), 0)
                _t = st_set(st, st_dx1(), 0)
                _u = st_set(st, st_dy1(), 0)
                0
        0
    0

fn wm_comp_attach(st: Int, plen: Int) -> Int ! io, alloc
    fd = tcp_connect(comp_puerto(), 200)
    if fd < 0
        -1
    else
        buf = bytes_ptr(bytes_new(msg_len()))
        n = read_fd(fd, buf, msg_len())
        if n != msg_len()
            close_fd(fd)
            -1
        else
            if msg_get_op(buf) != op_comp_escena()
                close_fd(fd)
                -1
            else
                sid = msg_get_u32(buf, 4)
                gok = msg_get_u32(buf, comp_escena_gpu_ok_off())
                ptr = shm_map(sid)
                if ptr < 0
                    close_fd(fd)
                    -1
                else
                    _f = st_set(st, st_comp_fd(), fd)
                    _g = st_set(st, st_comp_gpu_ok(), gok)
                    ptr

fn wm_comp_ensure(st: Int, sw: Int, sh: Int, stride: Int, sin_comp: Int) -> Int ! io, alloc
    if sin_comp != 0
        -1
    else
        ptr = wm_comp_attach(st, sw * sh * 4)
        if ptr >= 0
            fd = st_get(st, st_comp_fd())
            _i = wm_comp_gpu_init(st, fd, sw, sh, stride)
            ptr
        else
            _sp = spawn_io_full(d"/bin/soso-comp", fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
            t0 = uptime_ms()
            res = -1
            done = 0
            while done == 0
                if uptime_ms() - t0 > 5000
                    done = 1
                if done == 0
                    ptr = wm_comp_attach(st, sw * sh * 4)
                    if ptr >= 0
                        fd = st_get(st, st_comp_fd())
                        _i = wm_comp_gpu_init(st, fd, sw, sh, stride)
                        res = ptr
                        done = 1
            res

fn wm_comp_flush(st: Int, compos: Int, clen: Int) -> Int ! io, alloc
    if wm_comp_gpu_mode(st) != 0
        wm_comp_flush_scene(st)
    fd = st_get(st, st_comp_fd())
    if fd < 0
        x0 = st_get(st, st_dx0())
        y0 = st_get(st, st_dy0())
        x1 = st_get(st, st_dx1())
        y1 = st_get(st, st_dy1())
        if x1 > x0
            if y1 > y0
                _p = fb_present_rect(compos, clen, x0, y0, x1 - x0, y1 - y0)
                _r = st_set(st, st_dx0(), 0)
                _s = st_set(st, st_dy0(), 0)
                _t = st_set(st, st_dx1(), 0)
                _u = st_set(st, st_dy1(), 0)
    else
        if wm_comp_gpu_mode(st) == 0
            x0 = st_get(st, st_dx0())
            y0 = st_get(st, st_dy0())
            x1 = st_get(st, st_dx1())
            y1 = st_get(st, st_dy1())
            if x1 > x0
                if y1 > y0
                    m = st_get(st, st_msg_buf())
                    _e = msg_encode_comp_frame(m, x0, y0, x1 - x0, y1 - y0)
                    _w = write_fd(fd, m, msg_len())
                    _r = st_set(st, st_dx0(), 0)
                    _s = st_set(st, st_dy0(), 0)
                    _t = st_set(st, st_dx1(), 0)
                    _u = st_set(st, st_dy1(), 0)
    0

fn wm_flush_dirty(st: Int, compos: Int, clen: Int) -> Int ! io, alloc
    wm_comp_flush(st, compos, clen)

fn wm_cerrar_cliente(st: Int) -> Int ! io, alloc
    fd = st_get(st, st_cli_fd())
    if fd > 0
        _c = close_fd(fd)
    sid = st_get(st, st_shm_id())
    if sid > 0
        _f = shm_free(sid)
    _a = st_set(st, st_cli_fd(), 0)
    _b = st_set(st, st_fase(), 0)
    _c = st_set(st, st_shm_id(), 0)
    0

fn wm_enviar_ventana(st: Int, fd: Int, id: Int, shm: Int, cw: Int, ch: Int, fmt: Int) -> Int ! io, alloc
    m = msg_nuevo()
    _e = msg_encode_ventana(m, id, shm, cw, ch, fmt, wm_tema_id(st), wm_escala_apps(st))
    write_fd(fd, m, msg_len())

fn wm_enviar_foco(fd: Int) -> Int ! io, alloc
    m = msg_nuevo()
    _e = msg_set_op(m, op_foco())
    write_fd(fd, m, msg_len())

fn wm_cliente_cw(ww: Int) -> Int
    c = ww - 8
    if c < 1
        1
    else
        c

fn wm_cliente_ch(st: Int, wh: Int) -> Int ! alloc
    c = wh - wm_bar_h(st) - 8
    if c < 1
        1
    else
        c

fn wm_redim_slot(st: Int, tab: Int, i: Int, fmt: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int) -> Int ! io, alloc
    cab = grupo_cab(tab, i)
    n = grupo_n(tab, cab)
    r = 0
    k = 0
    while k < n
        m = grupo_miembro(tab, cab, k)
        r = r + wm_redim_slot_uno(st, tab, m, fmt, compos, clen, sw, sh, stride, bpp)
        k = k + 1
    r

fn wm_redim_slot_uno(st: Int, tab: Int, i: Int, fmt: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int) -> Int ! io, alloc
    if tab_get(tab, i, tab_tipo()) != tab_tipo_cli()
        0
    else
        if tab_get(tab, i, tab_fase()) != 2
            0
        else
            ww = tab_get(tab, i, tab_ww())
            wh = tab_get(tab, i, tab_wh())
            cw = wm_cliente_cw(ww)
            ch = wm_cliente_ch(st, wh)
            slen = cw * ch * 4
            sid = shm_create(slen)
            ok = 0
            if sid >= 0
                fd = tab_get(tab, i, tab_fd())
                peer = tcp_peer_pid(fd)
                if peer >= 0
                    _g = shm_grant(sid, peer)
                sptr = shm_map(sid)
                if sptr >= 0
                    old = tab_get(tab, i, tab_shm_id())
                    msg = st_get(st, st_msg_buf())
                    _e = msg_encode_redim(msg, cw, ch, sid)
                    _w = write_fd(fd, msg, msg_len())
                    if old > 0
                        _f = shm_free(old)
                    _a = tab_set(tab, i, tab_shm_id(), sid)
                    _b = tab_set(tab, i, tab_shm_ptr(), sptr)
                    _c = tab_set(tab, i, tab_cw(), cw)
                    _d = tab_set(tab, i, tab_ch(), ch)
                    _s = wm_st_desde_tab(st, tab, i)
                    _r = wm_repintar_ventana(st, tab, i, compos, clen, sw, sh, stride, bpp, fmt)
                    _t = wm_tab_desde_st(st, tab, i)
                    ok = 1
            ok

fn wm_on_crear(st: Int, fd: Int, msg: Int, fmt: Int, sw: Int, sh: Int) -> Int ! io, alloc
    cw = msg_get_u32(msg, 4)
    ch = msg_get_u32(msg, 8)
    ok = 0
    if cw > 0
        if ch > 0
            slen = cw * ch * 4
            sid = shm_create(slen)
            if sid >= 0
                peer = tcp_peer_pid(fd)
                if peer >= 0
                    _g = shm_grant(sid, peer)
                sptr = shm_map(sid)
                if sptr >= 0
                    wx = max(0, (sw - cw) / 2)
                    wy = max(0, (sh - ch - wm_bar_h(st)) / 2)
                    ww = cw
                    wh = ch + wm_bar_h(st)
                    _v = wm_enviar_ventana(st, fd, 1, sid, cw, ch, fmt)
                    _a = st_set(st, st_shm_id(), sid)
                    _b = st_set(st, st_shm_ptr(), sptr)
                    _c = st_set(st, st_cw(), cw)
                    _d = st_set(st, st_ch(), ch)
                    _e = st_set(st, st_wx(), wx)
                    _f = st_set(st, st_wy(), wy)
                    _g = st_set(st, st_ww(), ww)
                    _h = st_set(st, st_wh(), wh)
                    _i = st_set(st, st_fase(), 2)
                    ok = 1
    ok

fn wm_on_crear_repintar(st: Int, tab: Int, i: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    fd = st_get(st, st_cli_fd())
    _r = wm_repintar_ventana(st, tab, i, compos, clen, sw, sh, stride, bpp, fmt)
    _f = wm_enviar_foco(fd)
    0

fn wm_on_danio(st: Int, tab: Int, i: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, msg: Int) -> Int ! io, alloc
    if grupo_panel_activo(tab, i) == i
        wm_on_danio_vis(st, tab, i, compos, clen, stride, bpp, fmt, msg)
    else
        0

fn wm_on_danio_vis(st: Int, tab: Int, i: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, msg: Int) -> Int ! io, alloc
    if st_get(st, st_fase()) == 2
        dx = msg_get_u32(msg, 4)
        dy = msg_get_u32(msg, 8)
        dw = msg_get_u32(msg, 12)
        dh = msg_get_u32(msg, 16)
        wx = st_get(st, st_wx())
        wy = st_get(st, st_wy())
        cw = st_get(st, st_cw())
        ch = st_get(st, st_ch())
        shm = st_get(st, st_shm_ptr())
        slen = cw * ch * 4
        if wm_es_ss(st, i) == 0
            _b = wm_blit_cliente(st, compos, clen, stride, bpp, fmt, wx, wy, cw, ch, shm, slen, dx, dy, dw, dh)
            _d = wm_marcar_dirty(st, wx + dx, wy + wm_bar_h(st) + dy, wx + dx + dw, wy + wm_bar_h(st) + dy + dh)
        else
            _b = wm_blit_cliente_pantalla(compos, clen, stride, bpp, fmt, wx, wy, cw, ch, shm, slen, dx, dy, dw, dh)
            _d = wm_marcar_dirty(st, wx + dx, wy + dy, wx + dx + dw, wy + dy + dh)
    0

fn wm_leer_msg(fd: Int, buf: Int) -> Int ! io, alloc
    read_timeout_fd(fd, buf, msg_len(), 1)

fn wm_dispatch_msg(st: Int, tab: Int, i: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, sw: Int, sh: Int, m: Int) -> Int ! io, alloc
    fd = tab_get(tab, i, tab_fd())
    op = msg_get_op(m)
    if op == op_hola()
        if st_get(st, st_ss_pid()) >= 0
            if st_get(st, st_ss_slot()) < 0
                peer = tcp_peer_pid(fd)
                if peer == st_get(st, st_ss_pid())
                    _ss = st_set(st, st_ss_slot(), i)
        _f = tab_set(tab, i, tab_fase(), 1)
        # app_id: el cliente que se conecta solo dice qué es, para poder repetirlo con «+».
        aid = msg_get_u32(m, 8)
        if aid == app_web()
            _aa = tab_set(tab, i, tab_app(), aid)
        if aid == app_ficheros()
            _ab = tab_set(tab, i, tab_app(), aid)
    if op == op_crear()
        if tab_get(tab, i, tab_fase()) == 1
            tg = -1
            peer = tcp_peer_pid(fd)
            if peer >= 0
                if peer == st_get(st, st_pend_pid())
                    _pa = tab_set(tab, i, tab_app(), st_get(st, st_pend_app()))
                    pg = st_get(st, st_pend_grupo())
                    if pg > 0
                        if tab_slot_activo(tab, pg - 1) != 0
                            tg = grupo_cab(tab, pg - 1)
                    _pp = st_set(st, st_pend_pid(), -1)
                    _pq = st_set(st, st_pend_grupo(), 0)
            _s = wm_st_desde_tab(st, tab, i)
            ok = 0
            if wm_es_ss(st, i) != 0
                ok = wm_on_crear_ss(st, fd, tab, i, fmt, sw, sh, stride)
            else
                ok = wm_on_crear(st, fd, m, fmt, sw, sh)
            _t = wm_tab_desde_st(st, tab, i)
            if ok != 0
                _tt = tab_titulo_desde_msg(tab, i, m)
                if tg >= 0
                    # Entra como pestaña: toma el tamaño de la ventana, no el que pidió.
                    _ig = wm_integrar(st, i, tg)
                    _rs = wm_redim_slot_uno(st, tab, i, fmt, compos, clen, sw, sh, stride, bpp)
                    _fo = wm_enviar_foco(fd)
                elsif wm_es_ss(st, i) == 0
                    _r = wm_on_crear_repintar(st, tab, i, compos, clen, sw, sh, stride, bpp, fmt)
                if wm_es_ss(st, i) != 0
                    z = st_get(st, st_z())
                    nz = st_get(st, st_nz())
                    _u = z_subir(z, nz, i)
                _t2 = wm_tab_desde_st(st, tab, i)
    if op == op_titulo()
        _tt = tab_titulo_desde_msg(tab, i, m)
        if tab_get(tab, i, tab_fase()) == 2
            _s = wm_st_desde_tab(st, tab, i)
            _r = wm_repintar_ventana(st, tab, i, compos, clen, sw, sh, stride, bpp, fmt)
            _t = wm_tab_desde_st(st, tab, i)
    if op == op_danio()
        _s = wm_st_desde_tab(st, tab, i)
        _d = wm_on_danio(st, tab, i, compos, clen, stride, bpp, fmt, m)
        _t = wm_tab_desde_st(st, tab, i)
    if op == op_cerrar_cli()
        _s = wm_st_desde_tab(st, tab, i)
        _x = wm_cerrar_cliente(st)
        _t = wm_tab_desde_st(st, tab, i)
        _c = wm_cerrar_indice(st, i)
    if op == op_cerrar_wm()
        _q = st_set(st, st_salir(), 1)
    0

fn wm_atender_cliente_tab(st: Int, tab: Int, i: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, sw: Int, sh: Int) -> Int ! io, alloc
    fd = tab_get(tab, i, tab_fd())
    if fd > 0
        m = st_get(st, st_msg_buf())
        n = read_timeout_fd(fd, m, msg_len(), 1)
        if n == 0
            _c = wm_cerrar_indice(st, i)
        if n > 0
            j = 0
            while j < n
                bb = bytes_view_mem(m, msg_len())
                ch = bytes_get_u8(bb, j)
                al = tab_acc_push_byte(tab, i, ch)
                if al == 32
                    _cp = tab_acc_copiar_msg(tab, i, m)
                    _d = wm_dispatch_msg(st, tab, i, compos, clen, stride, bpp, fmt, sw, sh, m)
                j = j + 1
    0

fn wm_reenviar_raton_slot(st: Int, tab: Int, i0: Int, x: Int, y: Int, botones: Int) -> Int ! io, alloc
    i = grupo_panel_activo(tab, i0)
    if tab_get(tab, i, tab_fase()) == 2
        wx = tab_get(tab, i, tab_wx())
        wy = tab_get(tab, i, tab_wy())
        ww = tab_get(tab, i, tab_ww())
        wh = tab_get(tab, i, tab_wh())
        cw = tab_get(tab, i, tab_cw())
        ch = tab_get(tab, i, tab_ch())
        if ventana_contiene(x, y, wx, wy, ww, wh) != 0
            lx = x - wx - 4
            ly = y - wy - wm_bar_h(st)
            if lx >= 0
                if ly >= 0
                    if lx < cw
                        if ly < ch
                            fd = tab_get(tab, i, tab_fd())
                            msg = st_get(st, st_msg_buf())
                            _e = msg_encode_raton(msg, lx, ly, botones)
                            _w = write_fd(fd, msg, msg_len())
    0

# Maximiza o restaura. Maximizada ocupa todo salvo la barra superior; la geometría
# anterior se guarda en la propia ranura para poder volver.
fn wm_alternar_max(st: Int, tab: Int, i: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    est = tab_get(tab, i, tab_estado())
    wx0 = tab_get(tab, i, tab_wx())
    wy0 = tab_get(tab, i, tab_wy())
    ww0 = tab_get(tab, i, tab_ww())
    wh0 = tab_get(tab, i, tab_wh())
    if (est & estado_max()) != 0
        _a = tab_set(tab, i, tab_wx(), tab_get(tab, i, tab_sx()))
        _b = tab_set(tab, i, tab_wy(), tab_get(tab, i, tab_sy()))
        _c = tab_set(tab, i, tab_ww(), tab_get(tab, i, tab_sw()))
        _d = tab_set(tab, i, tab_wh(), tab_get(tab, i, tab_sh()))
        _e = tab_set(tab, i, tab_estado(), est - estado_max())
    else
        _sa = tab_set(tab, i, tab_sx(), wx0)
        _sb = tab_set(tab, i, tab_sy(), wy0)
        _sc = tab_set(tab, i, tab_sw(), ww0)
        _sd = tab_set(tab, i, tab_sh(), wh0)
        _a2 = tab_set(tab, i, tab_wx(), 0)
        _b2 = tab_set(tab, i, tab_wy(), wm_bar_h(st))
        _c2 = tab_set(tab, i, tab_ww(), sw)
        _d2 = tab_set(tab, i, tab_wh(), sh - wm_bar_h(st))
        _e2 = tab_set(tab, i, tab_estado(), est + estado_max())
    _r = wm_redim_slot(st, tab, i, fmt, compos, clen, sw, sh, stride, bpp)
    _tr = wm_term_redimensionar_si(st, tab, i)
    _dd = wm_marcar_dirty(st, 0, 0, sw, sh)
    _rp = wm_pedir_repintar(st)
    0

# La ventana con foco pasa a ser la más alta de las visibles (o ninguna).
fn wm_foco_visible(st: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    k = nz - 1
    r = -1
    while k >= 0
        i = z_get(z, k)
        if r < 0
            if tab_slot_activo(tab, i) != 0
                if wm_oculta(tab, i) == 0
                    r = i
        k = k - 1
    r

fn wm_minimizar(st: Int, tab: Int, i: Int) -> Int ! alloc
    est = tab_get(tab, i, tab_estado())
    if (est & estado_min()) == 0
        _e = tab_set(tab, i, tab_estado(), est + estado_min())
    if st_get(st, st_focus()) == i
        _f = st_set(st, st_focus(), wm_foco_visible(st))
    _rp = wm_pedir_repintar(st)
    0

# Lista de ventanas en la barra superior, a la derecha de los lanzadores.
fn wm_barra_lista_x0(st: Int) -> Int ! alloc
    gw = wm_gw_wm(st)
    lanz_boton_x0(lanz_n_botones() - 1, gw) + lanz_boton_ancho(lanz_n_botones() - 1, gw) + 24

fn wm_barra_ent_ancho(st: Int) -> Int ! alloc
    wm_gw_wm(st) * 14 + 2 * lanz_margen(wm_gw_wm(st))

fn wm_barra_ent_x0(st: Int, n: Int) -> Int ! alloc
    wm_barra_lista_x0(st) + n * (wm_barra_ent_ancho(st) + 4)

# Ranura de la ventana n-ésima de la lista (o -1).
fn wm_barra_ranura(st: Int, n: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    cuenta = 0
    r = -1
    i = 0
    while i < tab_cap()
        if tab_slot_activo(tab, i) != 0
            if grupo_cab(tab, i) == i
                if cuenta == n
                    r = i
                cuenta = cuenta + 1
        i = i + 1
    r

fn wm_barra_hit_ventana(st: Int, x: Int, y: Int) -> Int ! alloc
    gh = wm_gh_wm(st)
    r = -1
    if y >= 0
        if y < barra_alto(gh)
            n = 0
            while n < tab_cap()
                x0 = wm_barra_ent_x0(st, n)
                if x >= x0
                    if x < x0 + wm_barra_ent_ancho(st)
                        r = wm_barra_ranura(st, n)
                n = n + 1
    r

# Clic en la lista: minimizada -> restaura; con foco -> minimiza; otra -> da el foco.
fn wm_barra_alternar(st: Int, tab: Int, i: Int) -> Int ! alloc
    if wm_oculta(tab, i) != 0
        _f = wm_foco_a(st, i)
    else
        if st_get(st, st_focus()) == i
            _m = wm_minimizar(st, tab, i)
        else
            _f2 = wm_foco_a(st, i)
    0

fn wm_pintar_lista_ventanas(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    gw = wm_gw_wm(st)
    gh = wm_gh_wm(st)
    bh = wm_bar_h(st)
    radio = metrica_radio(gh)
    tema = wm_tema_id(st)
    ty = (bh - gh) / 2
    if ty < 2
        ty = 2
    n = 0
    i = 0
    while i < tab_cap()
        if tab_slot_activo(tab, i) != 0
            if grupo_cab(tab, i) == i
                act = grupo_panel_activo(tab, i)
                x0 = wm_barra_ent_x0(st, n)
                ew = wm_barra_ent_ancho(st)
                if x0 + ew <= sw - 8
                    bg = wm_color_boton(st)
                    fg = wm_color_texto_barra(st)
                    if wm_oculta(tab, i) != 0
                        fg = tema_texto_tenue(tema)
                    else
                        if st_get(st, st_focus()) == i
                            bg = wm_color_boton_activo(st)
                    _b = wm_esc_rr(st, compos, clen, sw, sh, stride, bpp, fmt, x0, ty, x0 + ew, ty + gh + 4, esc_radios(radio, radio, radio, radio), bg)
                    np = grupo_n(tab, i)
                    maxc = 14
                    if np > 1
                        maxc = 11
                        _cn = wm_texto_num(st, compos, clen, stride, bpp, fmt, x0 + ew - lanz_margen(gw) - 2 * gw, ty + 2, np, fg, bg)
                    _t = wm_texto_titulo(st, tab, act, compos, clen, stride, bpp, fmt, x0 + lanz_margen(gw), ty + 2, maxc, fg, bg)
                n = n + 1
        i = i + 1
    0

# Número de 1 o 2 cifras (contador de pestañas en la lista de ventanas).
fn wm_texto_num(st: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, x: Int, y: Int, v: Int, fg: Int, bg: Int) -> Int ! io, alloc
    psf = wm_psf_wm(st)
    plen = wm_psf_len_wm(st)
    gw = wm_gw_wm(st)
    if psf > 0
        d1 = (v / 10) % 10
        d0 = v % 10
        if v >= 10
            _a = fuente_dibujar(psf, plen, compos, clen, stride, bpp, fmt, 48 + d1, fg, bg, x, y)
        _b = fuente_dibujar(psf, plen, compos, clen, stride, bpp, fmt, 48 + d0, fg, bg, x + gw, y)
    0

# Pestaña o «+» bajo el puntero: ventana * 1000 + resultado de pest_hit, o 0.
fn wm_hover_pest(st: Int, x: Int, y: Int) -> Int ! alloc
    r = 0
    i = wm_hit_test(st, x, y)
    if i >= 0
        tab = st_get(st, st_tab())
        ph = pest_hit(x, y, tab_get(tab, i, tab_wx()), tab_get(tab, i, tab_wy()), tab_get(tab, i, tab_ww()), wm_gh_wm(st), grupo_n(tab, i))
        if ph != 0
            r = i * 1000 + ph
    r

# Botón de la barra de título bajo el puntero (ranura * 8 + botón), o 0.
fn wm_hover_boton(st: Int, x: Int, y: Int) -> Int ! alloc
    r = 0
    i = wm_hit_test(st, x, y)
    if i >= 0
        tab = st_get(st, st_tab())
        bt = ventana_hit_boton(x, y, tab_get(tab, i, tab_wx()), tab_get(tab, i, tab_wy()), tab_get(tab, i, tab_ww()), wm_gh_wm(st))
        if bt != 0
            r = i * 8 + bt
    r

# Ventana (cabecera) bajo `x,y` ignorando el grupo `excl`, o -1.
fn wm_hit_excluyendo(st: Int, x: Int, y: Int, excl: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    ex = grupo_cab(tab, excl)
    k = nz - 1
    found = -1
    while k >= 0
        if found < 0
            i = z_get(z, k)
            if i != ex
                if tab_slot_activo(tab, i) != 0
                    if wm_oculta(tab, i) == 0
                        if ventana_contiene(x, y, tab_get(tab, i, tab_wx()), tab_get(tab, i, tab_wy()), tab_get(tab, i, tab_ww()), tab_get(tab, i, tab_wh())) != 0
                            found = i
        k = k - 1
    found

# Ventana cuya barra de título está bajo el puntero (sin contar `excl`), o -1: ahí se soltaría.
fn wm_destino_soltar(st: Int, x: Int, y: Int, excl: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    d = wm_hit_excluyendo(st, x, y, excl)
    r = -1
    if d >= 0
        wx = tab_get(tab, d, tab_wx())
        wy = tab_get(tab, d, tab_wy())
        ww = tab_get(tab, d, tab_ww())
        gh = wm_gh_wm(st)
        if y < wy + wm_bar_h(st)
            if x >= pest_x0(wx)
                if x < pest_x1(wx, ww, gh)
                    r = d
    r

fn wm_drop_fijar(st: Int, d: Int) -> Int ! alloc
    if d != st_get(st, st_drop())
        _s = st_set(st, st_drop(), d)
        _r = wm_pedir_repintar(st)
    0

# Despega el panel `m` a ventana propia, bajo el puntero, y pasa a arrastrarla como ventana.
fn wm_pest_despegar(st: Int, m: Int, x: Int, y: Int, sh: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    h = grupo_cab(tab, m)
    if grupo_n(tab, h) <= 1
        0
    else
        gx = x - tab_get(tab, h, tab_wx())
        nh = -1
        if h == m
            m0 = grupo_miembro(tab, h, 0)
            if m0 == m
                m0 = grupo_miembro(tab, h, 1)
            _sp = grupo_separar(tab, m)
            nh = grupo_cab(tab, m0)
            _rz = z_reemplazar(z, nz, m, nh)
            nn = z_anadir(z, nz, m)
            _n = st_set(st, st_nz(), nn)
        else
            _sp2 = grupo_separar(tab, m)
            nn2 = z_anadir(z, nz, m)
            _n2 = st_set(st, st_nz(), nn2)
        _fo = st_set(st, st_focus(), m)
        ny = y - wm_bar_h(st) / 2
        if ny < wm_bar_h(st)
            ny = wm_bar_h(st)
        if ny > sh - 24
            ny = sh - 24
        _x = tab_set(tab, m, tab_wx(), x - gx)
        _y = tab_set(tab, m, tab_wy(), ny)
        _di = st_set(st, st_drag_ix(), m)
        _dk = st_set(st, st_drag_kind(), 1)
        _gx = st_set(st, st_grab_x(), gx)
        _gy = st_set(st, st_grab_y(), y - ny)
        _rp = wm_pedir_repintar(st)
        1

# Arrastre de una pestaña: reordena dentro de la tira o despega al salir de la barra.
fn wm_pest_arrastrar(st: Int, m: Int, x: Int, y: Int, sh: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    h = grupo_cab(tab, m)
    wx = tab_get(tab, h, tab_wx())
    wy = tab_get(tab, h, tab_wy())
    ww = tab_get(tab, h, tab_ww())
    gh = wm_gh_wm(st)
    bh = wm_bar_h(st)
    n = grupo_n(tab, h)
    if y < wy - 6
        _d = wm_pest_despegar(st, m, x, y, sh)
    elsif y >= wy + bh + 10
        _d2 = wm_pest_despegar(st, m, x, y, sh)
    elsif n >= 2
        tw = pest_ancho(wx, ww, gh, n)
        kp = (x - pest_x0(wx)) / tw
        if x < pest_x0(wx)
            kp = 0
        if kp > n - 1
            kp = n - 1
        if grupo_mover(tab, m, kp) != 0
            _rp = wm_pedir_repintar(st)
    0

# ---- Menú contextual de pestaña ------------------------------------------------
fn ctx_n() -> Int
    5

fn ctx_texto(k: Int) -> String ! alloc
    if k == 0
        d"Duplicar pestana"
    elsif k == 1
        d"Sacar a ventana"
    elsif k == 2
        d"Cerrar otras"
    elsif k == 3
        d"Cerrar a la derecha"
    else
        d"Cerrar"

fn ctx_ancho(st: Int) -> Int ! alloc
    gw = wm_gw_wm(st)
    w = 0
    k = 0
    while k < ctx_n()
        w = max(w, str_len(ctx_texto(k)) * gw)
        k = k + 1
    w + 2 * lanz_margen(gw)

fn ctx_item_alto(st: Int) -> Int ! alloc
    lanz_menu_item_alto(wm_gh_wm(st))

fn ctx_alto(st: Int) -> Int ! alloc
    ctx_n() * ctx_item_alto(st)

# Elemento bajo `x,y`, o -1.
fn ctx_item(st: Int, x: Int, y: Int) -> Int ! alloc
    cx = st_get(st, st_ctx_x())
    cy = st_get(st, st_ctx_y())
    if ventana_contiene(x, y, cx, cy, ctx_ancho(st), ctx_alto(st)) == 0
        -1
    else
        (y - cy) / ctx_item_alto(st)

fn wm_ctx_cerrar(st: Int) -> Int ! alloc
    if st_get(st, st_ctx()) >= 0
        _d = wm_marcar_dirty(st, st_get(st, st_ctx_x()), st_get(st, st_ctx_y()), st_get(st, st_ctx_x()) + ctx_ancho(st), st_get(st, st_ctx_y()) + ctx_alto(st))
        _s = st_set(st, st_ctx(), -1)
        _r = wm_pedir_repintar(st)
    0

fn wm_ctx_abrir(st: Int, m: Int, x: Int, y: Int, sw: Int, sh: Int) -> Int ! alloc
    cx = x
    cy = y
    if cx + ctx_ancho(st) > sw
        cx = sw - ctx_ancho(st)
    if cy + ctx_alto(st) > sh
        cy = sh - ctx_alto(st)
    _a = st_set(st, st_ctx(), m)
    _b = st_set(st, st_ctx_x(), cx)
    _c = st_set(st, st_ctx_y(), cy)
    _d = wm_marcar_dirty(st, cx, cy, cx + ctx_ancho(st), cy + ctx_alto(st))
    _r = wm_pedir_repintar(st)
    0

fn wm_pintar_ctx(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    m = st_get(st, st_ctx())
    if m >= 0
        gw = wm_gw_wm(st)
        gh = wm_gh_wm(st)
        tema = wm_tema_id(st)
        radio = metrica_radio(gh)
        cx = st_get(st, st_ctx_x())
        cy = st_get(st, st_ctx_y())
        w = ctx_ancho(st)
        h = ctx_alto(st)
        ia = ctx_item_alto(st)
        sel = ctx_item(st, st_get(st, st_mx()), st_get(st, st_my()))
        _s = wm_esc_rr(st, compos, clen, sw, sh, stride, bpp, fmt, cx - 1, cy - 1, cx + w + 1, cy + h + 1, esc_radios(radio, radio, radio, radio), tema_borde(tema, 0))
        _f = wm_esc_rr(st, compos, clen, sw, sh, stride, bpp, fmt, cx, cy, cx + w, cy + h, esc_radios(radio, radio, radio, radio), wm_color_menu(st))
        k = 0
        while k < ctx_n()
            iy = cy + k * ia
            bg = wm_color_menu(st)
            if k == sel
                bg = wm_color_menu_sel(st)
                _c = wm_esc_rr(st, compos, clen, sw, sh, stride, bpp, fmt, cx + lanz_margen(gw) / 2, iy + 2, cx + w - lanz_margen(gw) / 2, iy + ia - 2, esc_radios(radio, radio, radio, radio), bg)
            _t = wm_texto(st, compos, clen, stride, bpp, fmt, ctx_texto(k), cx + lanz_margen(gw), iy + (ia - gh) / 2, wm_color_texto_barra(st), bg)
            k = k + 1
        _d = wm_marcar_dirty(st, cx - 1, cy - 1, cx + w + 1, cy + h + 1)
    0

# Ejecuta la acción `k` del menú contextual sobre el panel `m`.
fn wm_ctx_ejecutar(st: Int, m: Int, k: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    cab = grupo_cab(tab, m)
    _a = grupo_activar(tab, m)
    if k == 0
        _n = wm_nueva_pestana(st, cab, compos, clen, sw, sh, stride, bpp, fmt)
    if k == 1
        _s = wm_atajo_sacar(st, sh)
    if k == 2
        while grupo_n(tab, grupo_cab(tab, m)) > 1
            c2 = grupo_cab(tab, m)
            o = grupo_miembro(tab, c2, 0)
            if o == m
                o = grupo_miembro(tab, c2, 1)
            _co = wm_cerrar_pestana(st, tab, o)
    if k == 3
        pos = grupo_pos(tab, m)
        while grupo_n(tab, grupo_cab(tab, m)) > pos + 1
            o2 = grupo_miembro(tab, grupo_cab(tab, m), pos + 1)
            _cd = wm_cerrar_pestana(st, tab, o2)
    if k == 4
        _cc = wm_cerrar_pestana(st, tab, m)
    _rp = wm_pedir_repintar(st)
    0

fn wm_raton_mover(st: Int, x: Int, y: Int, botones: Int, sw: Int, sh: Int) -> Int ! io, alloc
    _c = wm_cursor_actualizar(st, x, y, sw, sh)
    tab = st_get(st, st_tab())
    hv = wm_hover_boton(st, st_get(st, st_mx()), st_get(st, st_my()))
    if hv != st_get(st, st_hover())
        _hs = st_set(st, st_hover(), hv)
        _hp = wm_pedir_repintar(st)
    hp = wm_hover_pest(st, st_get(st, st_mx()), st_get(st, st_my()))
    if hp != st_get(st, st_hover_pest())
        _hq = st_set(st, st_hover_pest(), hp)
        _hr = wm_pedir_repintar(st)
    if st_get(st, st_ctx()) >= 0
        _hc = wm_pedir_repintar(st)
    dix = st_get(st, st_drag_ix())
    if dix >= 0
        if botones != 0
            dk = st_get(st, st_drag_kind())
            wx = tab_get(tab, dix, tab_wx())
            wy = tab_get(tab, dix, tab_wy())
            ww = tab_get(tab, dix, tab_ww())
            wh = tab_get(tab, dix, tab_wh())
            if dk == 10
                _pa = wm_pest_arrastrar(st, dix, x, y, sh)
            if dk == 1
                _dr = wm_drop_fijar(st, wm_destino_soltar(st, x, y, dix))
                nx = x - st_get(st, st_grab_x())
                ny = y - st_get(st, st_grab_y())
                if ny < wm_bar_h(st)
                    ny = wm_bar_h(st)
                if ny > sh - 24
                    ny = sh - 24
                if nx < 60 - ww
                    nx = 60 - ww
                if nx > sw - 60
                    nx = sw - 60
                _x = tab_set(tab, dix, tab_wx(), nx)
                _y = tab_set(tab, dix, tab_wy(), ny)
            if dk >= 2
                mw = ventana_min_ancho()
                mh = ventana_min_alto(wm_gh_wm(st)) + wm_bar_h(st)
                nx2 = wx
                nw = ww
                nh = wh
                if dk == 2
                    nw = max(mw, x - wx)
                    nh = max(mh, y - wy)
                if dk == 3
                    nw = max(mw, x - wx)
                if dk == 4
                    nh = max(mh, y - wy)
                if dk == 5
                    nx2 = min(x, wx + ww - mw)
                    nw = wx + ww - nx2
                if dk == 6
                    nx2 = min(x, wx + ww - mw)
                    nw = wx + ww - nx2
                    nh = max(mh, y - wy)
                _xx = tab_set(tab, dix, tab_wx(), nx2)
                _w = tab_set(tab, dix, tab_ww(), nw)
                _h = tab_set(tab, dix, tab_wh(), nh)
            _d = wm_marcar_dirty(st, 0, wm_bar_h(st), sw, sh)
            _rp = wm_pedir_repintar(st)
    if dix < 0
        fi = st_get(st, st_focus())
        if fi >= 0
            _r = wm_reenviar_raton_slot(st, tab, fi, x, y, botones)
    0

fn wm_raton_btn(st: Int, x: Int, y: Int, botones: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    _c = wm_cursor_actualizar(st, x, y, sw, sh)
    tab = st_get(st, st_tab())
    if botones == 0
        dix = st_get(st, st_drag_ix())
        dk = st_get(st, st_drag_kind())
        if dix >= 0
            if dk >= 2
                _r = wm_redim_slot(st, tab, dix, fmt, compos, clen, sw, sh, stride, bpp)
                _tr = wm_term_redimensionar_si(st, tab, dix)
        if dix >= 0
            if dk == 1
                dst = wm_destino_soltar(st, x, y, dix)
                if dst >= 0
                    _ig = wm_integrar(st, dix, dst)
        _dd = wm_drop_fijar(st, -1)
        _d = st_set(st, st_drag_ix(), -1)
        _k = st_set(st, st_drag_kind(), 0)
    if botones != 0
        gw = wm_gw_wm(st)
        gh = wm_gh_wm(st)
        tema = wm_tema_id(st)
        cm = st_get(st, st_ctx())
        if cm >= 0
            ik = ctx_item(st, x, y)
            _cc = wm_ctx_cerrar(st)
            if ik >= 0
                _ce = wm_ctx_ejecutar(st, cm, ik, compos, clen, sw, sh, stride, bpp, fmt)
            return 0
        if st_get(st, st_menu()) != 0
            acc = lanz_hit_menu(x, y, gw, gh, tema)
            if acc == lanz_nada()
                acc = lanz_hit_barra(x, y, gw, gh)
            _em = wm_ejecutar(st, acc, sw, sh)
            return 0
        if y < wm_bar_h(st)
            acc = lanz_hit_barra(x, y, gw, gh)
            if acc != lanz_nada()
                _eb = wm_ejecutar(st, acc, sw, sh)
            else
                kb = wm_barra_hit_ventana(st, x, y)
                if kb >= 0
                    _bw = wm_barra_alternar(st, tab, kb)
            return 0
        i = wm_hit_test(st, x, y)
        if i >= 0
            _f = wm_foco_a(st, i)
            wx = tab_get(tab, i, tab_wx())
            wy = tab_get(tab, i, tab_wy())
            ww = tab_get(tab, i, tab_ww())
            wh = tab_get(tab, i, tab_wh())
            ph = pest_hit(x, y, wx, wy, ww, gh, grupo_n(tab, i))
            if (botones & 2) != 0
                if ph != 0
                    if ph != 200
                        k0 = ph - 1
                        if ph > 100
                            k0 = ph - 101
                        pm0 = grupo_miembro(tab, i, k0)
                        if pm0 >= 0
                            _ca = wm_ctx_abrir(st, pm0, x, y, sw, sh)
                    return 0
            if ph != 0
                _pc = wm_clic_pestana(st, tab, i, ph, compos, clen, sw, sh, stride, bpp, fmt)
                if ph < 100
                    pm = grupo_miembro(tab, i, ph - 1)
                    if pm >= 0
                        _pd = st_set(st, st_drag_ix(), pm)
                        _pk = st_set(st, st_drag_kind(), 10)
                return 0
            bt = ventana_hit_boton(x, y, wx, wy, ww, gh)
            if bt == 1
                _c = wm_cerrar_grupo(st, i)
            elsif bt == 2
                _mx = wm_alternar_max(st, tab, i, compos, clen, sw, sh, stride, bpp, fmt)
            elsif bt == 3
                _mn = wm_minimizar(st, tab, i)
            else
                maxim = wm_maximizada(tab, i)
                borde = 0
                if maxim == 0
                    borde = ventana_hit_borde(x, y, wx, wy, ww, wh, gh)
                if borde != 0
                    _di = st_set(st, st_drag_ix(), i)
                    _dk = st_set(st, st_drag_kind(), borde)
                else
                    if ventana_hit_titulo(x, y, wx, wy, ww, gh) != 0
                        ahora = uptime_ms()
                        doble = 0
                        if st_get(st, st_clic_i()) == i
                            if ahora - st_get(st, st_clic_t()) < 400
                                doble = 1
                        if doble != 0
                            _ct = st_set(st, st_clic_t(), 0)
                            _mx2 = wm_alternar_max(st, tab, i, compos, clen, sw, sh, stride, bpp, fmt)
                        else
                            _ct2 = st_set(st, st_clic_t(), ahora)
                            _ci = st_set(st, st_clic_i(), i)
                            if maxim == 0
                                _di2 = st_set(st, st_drag_ix(), i)
                                _dk2 = st_set(st, st_drag_kind(), 1)
                                _x0 = st_set(st, st_grab_x(), x - wx)
                                _y0 = st_set(st, st_grab_y(), y - wy)
                    else
                        _r = wm_reenviar_raton_slot(st, tab, i, x, y, botones)
    0

fn wm_reenviar_tecla(st: Int, key: Int, mods: Int) -> Int ! io, alloc
    if st_get(st, st_fase()) == 2
        fd = st_get(st, st_cli_fd())
        msg = st_get(st, st_msg_buf())
        _e = msg_encode_tecla(msg, key, mods)
        _w = write_fd(fd, msg, msg_len())
    0

fn wm_tecla_foco(st: Int, key: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    fi = st_get(st, st_focus())
    if fi >= 0
        fi = grupo_panel_activo(tab, fi)
    if fi >= 0
        if tab_get(tab, fi, tab_tipo()) == tab_tipo_term()
            fd = tab_get(tab, fi, tab_fd())
            msg = st_get(st, st_msg_buf())
            b = bytes_view_mem(msg, msg_len())
            bytes_set_u8(b, 0, u8(key))
            _w = write_fd(fd, msg, 1)
        if tab_get(tab, fi, tab_tipo()) != tab_tipo_term()
            _s = wm_st_desde_tab(st, tab, fi)
            msg = st_get(st, st_msg_buf())
            _e = msg_encode_tecla(msg, key, 0)
            _w = write_fd(st_get(st, st_cli_fd()), msg, msg_len())
            _t = wm_tab_desde_st(st, tab, fi)
    0

fn wm_cerrar_foco(st: Int) -> Int ! io, alloc
    fi = st_get(st, st_focus())
    if fi >= 0
        tab = st_get(st, st_tab())
        fi = grupo_panel_activo(tab, fi)
        _s = wm_st_desde_tab(st, tab, fi)
        _c = wm_cerrar_cliente(st)
        _t = wm_tab_desde_st(st, tab, fi)
        _x = wm_cerrar_indice(st, fi)
    0

fn wm_atajo_max(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    fi = st_get(st, st_focus())
    if fi >= 0
        _m = wm_alternar_max(st, st_get(st, st_tab()), fi, compos, clen, sw, sh, stride, bpp, fmt)
    0

fn wm_atajo_min(st: Int) -> Int ! alloc
    fi = st_get(st, st_focus())
    if fi >= 0
        _m = wm_minimizar(st, st_get(st, st_tab()), fi)
    0

fn wm_foco_siguiente(st: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    fi = st_get(st, st_focus())
    nfi = fi
    if nz > 1
        k = 0
        while k < nz
            if z_get(z, k) == fi
                nfi = z_get(z, 0)
                if k + 1 < nz
                    nfi = z_get(z, k + 1)
            k = k + 1
        _q = wm_quitar_min(tab, nfi)
        _f = st_set(st, st_focus(), nfi)
        _u = z_subir(z, nz, nfi)
        _rp = wm_pedir_repintar(st)
    nfi

# Crea un panel de terminal (PTY + sosh) sin colocarlo todavía en ninguna ventana.
fn wm_term_slot(st: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    si = tab_buscar_libre(tab)
    if tab_contar_tipo(tab, tab_tipo_term()) >= pty_max()
        si = -1
    if si >= 0
        pack = pty_open()
        if pack >= 0
            ma = pty_fd_maestro(pack)
            sl = pty_slot(pack)
            pid = spawn_io_full(d"/bin/sosh", fd_pty_stdio(sl), fd_pty_stdio(sl), fd_pty_stdio(sl), fd_kernel_log())
            _t = tab_set(tab, si, tab_tipo(), tab_tipo_term())
            _f = tab_set(tab, si, tab_fd(), ma)
            _p = tab_set(tab, si, tab_pid(), pid)
            _x = tab_set(tab, si, tab_wx(), 40)
            _y = tab_set(tab, si, tab_wy(), 40 + wm_bar_h(st))
            _w = tab_set(tab, si, tab_ww(), 640)
            _h = tab_set(tab, si, tab_wh(), 400 + wm_bar_h(st))
            _co = tab_set_raw(tab, si, tab_cab(), 0)
            _or = tab_set_raw(tab, si, tab_orden(), 0)
            _sc = tab_set(tab, si, tab_escala(), wm_escala_apps(st))
            gw = fuente_gw(wm_escala_apps(st))
            gh = fuente_gh(wm_escala_apps(st))
            bh = wm_bar_h(st)
            wh0 = 400 + bh
            cols = wm_term_cols(640, gw)
            rows = wm_term_rows(wh0, gh, bh)
            grid = term_capa(cols, rows)
            tst = term_st_nuevo(cols, rows)
            _g = tab_set(tab, si, tab_shm_ptr(), grid)
            _ts = tab_set(tab, si, tab_term_st(), tst)
            _ti = tab_titulo_set(tab, si, d"Terminal")
            _c = tab_set(tab, si, tab_cw(), cols * gw)
            _r = tab_set(tab, si, tab_ch(), rows * gh)
            _p = tab_set(tab, si, tab_term_pos(), 0)
            _fw = tab_set(tab, si, tab_fww(), 0)
            _fh = tab_set(tab, si, tab_fwh(), 0)
        else
            si = -1
    else
        si = -1
    si

fn wm_abrir_terminal(st: Int, sw: Int, sh: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    si = wm_term_slot(st)
    ok = 0
    if si >= 0
        nz = st_get(st, st_nz())
        nn = z_anadir(z, nz, si)
        _n = st_set(st, st_nz(), nn)
        _fo = st_set(st, st_focus(), si)
        _rp = wm_pedir_repintar(st)
        ok = 1
    ok

# Lanza una aplicación cliente. Si `grupo1` > 0, el cliente entra como pestaña de esa ventana (cabecera + 1).
fn wm_abrir_app(st: Int, app: Int, grupo1: Int) -> Int ! io, alloc
    pid = -1
    if app == app_web()
        pid = wm_lanzar_web()
    if app == app_ficheros()
        pid = wm_lanzar_ficheros()
    if pid > 0
        _a = st_set(st, st_pend_pid(), pid)
        _b = st_set(st, st_pend_app(), app)
        _c = st_set(st, st_pend_grupo(), grupo1)
    pid

# Nueva pestaña con la misma aplicación que la activa de la ventana `h`.
fn wm_nueva_pestana(st: Int, h: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    cab = grupo_cab(tab, h)
    act = grupo_panel_activo(tab, cab)
    ok = 0
    if tab_get(tab, act, tab_tipo()) == tab_tipo_term()
        si = wm_term_slot(st)
        if si >= 0
            _i = wm_integrar(st, si, cab)
            _t = wm_term_redimensionar_uno(st, tab, si)
            ok = 1
    if tab_get(tab, act, tab_tipo()) == tab_tipo_cli()
        app = tab_get(tab, act, tab_app())
        if app != app_ninguna()
            pid = wm_abrir_app(st, app, cab + 1)
            if pid > 0
                ok = 1
    ok

fn wm_activar_pestana(st: Int, tab: Int, h: Int, k: Int) -> Int ! io, alloc
    cab = grupo_cab(tab, h)
    m = grupo_miembro(tab, cab, k)
    if m >= 0
        _g = grupo_activar(tab, m)
        if tab_get(tab, m, tab_tipo()) == tab_tipo_cli()
            _f = wm_enviar_foco(tab_get(tab, m, tab_fd()))
        _rp = wm_pedir_repintar(st)
    0

# Alt+1..9, Ctrl+Tab: pestaña `k` (o relativa) de la ventana con foco.
fn wm_pestana_relativa(st: Int, delta: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    fi = st_get(st, st_focus())
    if fi >= 0
        cab = grupo_cab(tab, fi)
        n = grupo_n(tab, cab)
        if n > 1
            pos = grupo_pos(tab, grupo_panel_activo(tab, cab))
            np = mod_pos(pos + delta + n, n)
            _a = wm_activar_pestana(st, tab, cab, np)
    0

fn wm_pestana_n(st: Int, k: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    fi = st_get(st, st_focus())
    if fi >= 0
        cab = grupo_cab(tab, fi)
        if k < grupo_n(tab, cab)
            _a = wm_activar_pestana(st, tab, cab, k)
    0

# Clic en la tira de pestañas (resultado de pest_hit).
# Alt+Mayús+D: saca la pestaña activa a ventana propia (algo desplazada para verla).
fn wm_atajo_sacar(st: Int, sh: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    fi = st_get(st, st_focus())
    if fi >= 0
        cab = grupo_cab(tab, fi)
        m = grupo_panel_activo(tab, cab)
        if grupo_n(tab, cab) > 1
            x = tab_get(tab, cab, tab_wx()) + 40
            y = tab_get(tab, cab, tab_wy()) + wm_bar_h(st) / 2 + 30
            _d = wm_pest_despegar(st, m, x + tab_get(tab, cab, tab_ww()) / 2 - 40, y, sh)
            _di = st_set(st, st_drag_ix(), -1)
            _dk = st_set(st, st_drag_kind(), 0)
    0

# Alt+Mayús+H/L: mueve la pestaña activa una posición a izquierda/derecha.
fn wm_atajo_mover_pest(st: Int, delta: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    fi = st_get(st, st_focus())
    if fi >= 0
        cab = grupo_cab(tab, fi)
        m = grupo_panel_activo(tab, cab)
        if grupo_mover(tab, m, grupo_pos(tab, m) + delta) != 0
            _rp = wm_pedir_repintar(st)
    0

fn wm_clic_pestana(st: Int, tab: Int, i: Int, ph: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    if ph == 200
        _n = wm_nueva_pestana(st, i, compos, clen, sw, sh, stride, bpp, fmt)
    elsif ph > 100
        m = grupo_miembro(tab, i, ph - 101)
        if m >= 0
            _c = wm_cerrar_pestana(st, tab, m)
    else
        _a = wm_activar_pestana(st, tab, i, ph - 1)
    0

fn wm_slot_atender_term(st: Int, tab: Int, i: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    fd = tab_get(tab, i, tab_fd())
    pid = tab_get(tab, i, tab_pid())
    if pid > 0
        vivo = kill_pid(pid, sig_probe())
        if vivo < 0
            _c = wm_cerrar_indice(st, i)
        if vivo >= 0
            buf = st_get(st, st_msg_buf())
            n = read_timeout_fd(fd, buf, msg_len(), 1)
            if n > 0
                grid = tab_get(tab, i, tab_shm_ptr())
                tst = tab_get(tab, i, tab_term_st())
                ww = tab_get(tab, i, tab_ww())
                wh = tab_get(tab, i, tab_wh())
                gw = wm_tab_gw(tab, i)
                gh = wm_tab_gh(tab, i)
                bh = wm_bar_h(st)
                cols = wm_term_cols(ww, gw)
                rows = wm_term_rows(wh, gh, bh)
                glen = cols * rows * celda_bytes()
                j = 0
                while j < n
                    b = bytes_view_mem(buf, msg_len())
                    ch = bytes_get_u8(b, j)
                    _f = term_feed_byte(tst, grid, glen, cols, rows, ch)
                    j = j + 1
                pos = term_st_get(tst, st_cursor())
                _p = tab_set(tab, i, tab_term_pos(), pos)
                if grupo_panel_activo(tab, i) != i
                    if tab_get(tab, i, tab_pend()) == 0
                        _pe = tab_set(tab, i, tab_pend(), 1)
                        _rp = wm_pedir_repintar(st)
                wx = tab_get(tab, i, tab_wx())
                wy = tab_get(tab, i, tab_wy())
                ww = tab_get(tab, i, tab_ww())
                wh = tab_get(tab, i, tab_wh())
                if grupo_panel_activo(tab, i) == i
                    _d = wm_marcar_dirty(st, wx, wy, wx + ww, wy + wh)
    0

# La «q» llega como 113, o 81 con Mayús.
fn wm_tecla_es_q(key: Int) -> Int
    if key == 113
        1
    elsif key == 81
        1
    else
        0

# La «t» llega como 116, 84 (con Mayús) o 20 (código de control con Ctrl).
fn wm_tecla_es_t(key: Int) -> Int
    if key == 116
        1
    elsif key == 84
        1
    elsif key == 20
        1
    else
        0

fn wm_input(st: Int, evt: Int, evt_len: Int, n: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    i = 0
    while i < n
        k = input_event_kind(evt, evt_len, i)
        if k == input_mouse_move()
            _r = wm_raton_mover(st, input_event_x(evt, evt_len, i), input_event_y(evt, evt_len, i), input_event_button(evt, evt_len, i), sw, sh)
        if k == input_mouse_btn()
            _r = wm_raton_btn(st, input_event_x(evt, evt_len, i), input_event_y(evt, evt_len, i), input_event_button(evt, evt_len, i), compos, clen, sw, sh, stride, bpp, fmt)
        if k == input_key()
            if input_event_pressed(evt, evt_len, i) != 0
                key = input_event_key(evt, evt_len, i)
                mods = input_event_button(evt, evt_len, i)
                if (mods & mod_ctrl()) != 0
                    if key == 3
                        _x = st_set(st, st_salir(), 1)
                if (mods & mod_alt()) != 0
                    if (mods & mod_shift()) != 0
                        if key == 101
                            _x = st_set(st, st_salir(), 1)
                        if wm_tecla_es_q(key) != 0
                            if st_get(st, st_focus()) >= 0
                                _qg = wm_cerrar_grupo(st, st_get(st, st_focus()))
                        if key == 100
                            _sd = wm_atajo_sacar(st, sh)
                        if key == 68
                            _sd2 = wm_atajo_sacar(st, sh)
                        if key == 104
                            _ml = wm_atajo_mover_pest(st, -1)
                        if key == 72
                            _ml2 = wm_atajo_mover_pest(st, -1)
                        if key == 108
                            _mr = wm_atajo_mover_pest(st, 1)
                        if key == 76
                            _mr2 = wm_atajo_mover_pest(st, 1)
                    if (mods & mod_shift()) == 0
                        if key == 10
                            _term = wm_abrir_terminal(st, 1024, 768)
                        if key == 113
                            _q = wm_cerrar_foco(st)
                        if key >= 49
                            if key <= 57
                                _pn = wm_pestana_n(st, key - 49)
                        if key == 9
                            _f = wm_foco_siguiente(st)
                        if key == 116
                            _m = st_set(st, st_mosaic(), 1 - st_get(st, st_mosaic()))
                            _a = wm_aplicar_mosaic(st, sw, sh)
                        if key == 102
                            _fm = wm_atajo_max(st, compos, clen, sw, sh, stride, bpp, fmt)
                        if key == 110
                            _fn = wm_atajo_min(st)
                        if key == 119
                            _lw = wm_abrir_app(st, app_web(), 0)
                        if key == 109
                            _ss = wm_ss_iniciar(st, compos, clen, sw, sh, stride, bpp, fmt)
                if (mods & mod_alt()) == 0
                    if (mods & mod_ctrl()) != 0
                        if key == 9
                            if (mods & mod_shift()) != 0
                                _pr = wm_pestana_relativa(st, -1)
                            else
                                _pr = wm_pestana_relativa(st, 1)
                        if wm_tecla_es_t(key) != 0
                            if (mods & mod_shift()) != 0
                                if st_get(st, st_focus()) >= 0
                                    _np = wm_nueva_pestana(st, st_get(st, st_focus()), compos, clen, sw, sh, stride, bpp, fmt)
                        zv = zoom_tecla(key, mods)
                        if zoom_sentido(zv) != zoom_sentido_nada()
                            _z = wm_zoom_aplicar(st, zv, compos, clen, sw, sh, stride, bpp, fmt)
                    else
                        _t = wm_tecla_foco(st, key)
                if (mods & mod_alt()) != 0
                    if (mods & mod_shift()) == 0
                        if key == 100
                            _tm = wm_cambiar_tema(st)
        i = i + 1
    0

fn wm_slot_atender(st: Int, tab: Int, i: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, sw: Int, sh: Int) -> Int ! io, alloc
    if tab_slot_activo(tab, i) != 0
        if tab_get(tab, i, tab_tipo()) == tab_tipo_term()
            _t = wm_slot_atender_term(st, tab, i, compos, clen, stride, bpp, fmt)
        if tab_get(tab, i, tab_tipo()) == tab_tipo_cli()
            _a = wm_atender_cliente_tab(st, tab, i, compos, clen, stride, bpp, fmt, sw, sh)
            if tab_get(tab, i, tab_fase()) == 0
                if tab_get(tab, i, tab_fd()) <= 0
                    _c = wm_cerrar_indice(st, i)
    0

fn wm_aceptar_cliente(st: Int, acc: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    si = tab_buscar_libre(tab)
    ok = 0
    if si < 0
        _x = close_fd(acc)
    if si >= 0
        _t = tab_set(tab, si, tab_tipo(), tab_tipo_cli())
        _f = tab_set(tab, si, tab_fd(), acc)
        _p = tab_set(tab, si, tab_fase(), 0)
        nz = st_get(st, st_nz())
        nn = z_anadir(z, nz, si)
        _n = st_set(st, st_nz(), nn)
        _fo = st_set(st, st_focus(), si)
        _sc = tab_set(tab, si, tab_escala(), wm_escala_apps(st))
        if st_get(st, st_ss_slot()) < 0
            if st_get(st, st_ss_cap()) > 0
                _ss = st_set(st, st_ss_slot(), si)
            if st_get(st, st_ss_pid()) >= 0
                _ss = st_set(st, st_ss_slot(), si)
        if st_get(st, st_ss_slot()) >= 0
            if st_get(st, st_ss_pid()) >= 0
                peer = tcp_peer_pid(acc)
                if peer == st_get(st, st_ss_pid())
                    if st_get(st, st_ss_slot()) != si
                        _ss = st_set(st, st_ss_slot(), si)
        ok = 1
    ok

fn wm_atender_todos(st: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, sw: Int, sh: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    i = 0
    while i < tab_cap()
        _a = wm_slot_atender(st, tab, i, compos, clen, stride, bpp, fmt, sw, sh)
        i = i + 1
    0

fn wm_prueba_anadir_terminal(st: Int, sw: Int, sh: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    si = tab_buscar_libre(tab)
    ok = 0
    if si >= 0
        _t = tab_set(tab, si, tab_tipo(), tab_tipo_term())
        _f = tab_set(tab, si, tab_fd(), 0)
        _p = tab_set(tab, si, tab_pid(), 0)
        _x = tab_set(tab, si, tab_wx(), 40)
        _y = tab_set(tab, si, tab_wy(), 40 + wm_bar_h(st))
        _w = tab_set(tab, si, tab_ww(), 640)
        _h = tab_set(tab, si, tab_wh(), 400 + wm_bar_h(st))
        nz = st_get(st, st_nz())
        nn = z_anadir(z, nz, si)
        _n = st_set(st, st_nz(), nn)
        _fo = st_set(st, st_focus(), si)
        _sc = tab_set(tab, si, tab_escala(), wm_escala_apps(st))
        gw = fuente_gw(wm_escala_apps(st))
        gh = fuente_gh(wm_escala_apps(st))
        bh = wm_bar_h(st)
        cols = wm_term_cols(640, gw)
        rows = wm_term_rows(400 + bh, gh, bh)
        grid = term_capa(cols, rows)
        tst = term_st_nuevo(cols, rows)
        _g = tab_set(tab, si, tab_shm_ptr(), grid)
        _ts = tab_set(tab, si, tab_term_st(), tst)
        _ti = tab_titulo_set(tab, si, d"Terminal")
        _fw = tab_set(tab, si, tab_fww(), 0)
        _fh = tab_set(tab, si, tab_fwh(), 0)
        ok = 1
    ok

fn wm_drenar_input(st: Int, evt: Int, evt_len: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    lotes = 0
    en = input_poll(evt, evt_len, 8)
    while en > 0
        if st_get(st, st_ss_slot()) >= 0
            _x = wm_ss_cerrar(st)
            lotes = lotes + 1
            if lotes >= 8
                en = 0
            else
                en = input_poll(evt, evt_len, 8)
        else
            _touch = st_set(st, st_ss_last(), uptime_ms())
            fi = st_get(st, st_focus())
            if fi >= 0
                _ld = wm_st_desde_tab(st, st_get(st, st_tab()), grupo_panel_activo(st_get(st, st_tab()), fi))
            _i = wm_input(st, evt, evt_len, en, compos, clen, sw, sh, stride, bpp, fmt)
            # No se vuelca `st` a la tabla: la entrada (arrastre, redimensión,
            # cierre) cambia la tabla directamente, y devolver la copia vieja
            # deshacía cada movimiento y escribía en huecos ya liberados.
            lotes = lotes + 1
            if lotes >= 8
                en = 0
            else
                en = input_poll(evt, evt_len, 8)
    0

# Visibilidad de cada cliente: sólo el panel activo de una ventana no minimizada se ve.
# Se avisa al cliente cuando cambia (no al conectar si ya se ve); de paso se apaga el punto
# de actividad del panel que pasa a verse.
fn wm_sync_visibilidad(st: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    i = 0
    while i < tab_cap()
        if tab_slot_activo(tab, i) != 0
            if tab_get(tab, i, tab_tipo()) == tab_tipo_cli()
                if tab_get(tab, i, tab_fase()) == 2
                    cab = grupo_cab(tab, i)
                    vis = 0
                    if grupo_panel_activo(tab, cab) == i
                        if wm_oculta(tab, cab) == 0
                            vis = 1
                    prev = tab_get(tab, i, tab_vis())
                    want = 2 - vis
                    if prev != want
                        _v = tab_set(tab, i, tab_vis(), want)
                        enviar = prev
                        if vis == 0
                            enviar = 1
                        if enviar != 0
                            m = msg_nuevo()
                            _e = msg_encode_visible(m, vis)
                            _w = write_fd(tab_get(tab, i, tab_fd()), m, msg_len())
            if grupo_panel_activo(tab, grupo_cab(tab, i)) == i
                if tab_get(tab, i, tab_pend()) != 0
                    _p = tab_set(tab, i, tab_pend(), 0)
                    _r = wm_pedir_repintar(st)
        i = i + 1
    0

fn wm_tick(st: Int, listener: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    _ps = wm_cargar_psf(st, sw)
    evt = st_get(st, st_evt_buf())
    _in = wm_drenar_input(st, evt, 24 * 8, compos, clen, sw, sh, stride, bpp, fmt)
    _ss = wm_ss_idle(st, compos, clen, sw, sh, stride, bpp, fmt)
    acc = tcp_accept(listener, 1)
    if acc > 0
        if acc != listener
            _ac = wm_aceptar_cliente(st, acc)
    _c = wm_atender_todos(st, compos, clen, stride, bpp, fmt, sw, sh)
    _sv = wm_sync_visibilidad(st)
    _p = wm_compose(st, compos, clen, sw, sh, stride, bpp, fmt)
    _f = wm_flush_dirty(st, compos, clen)
    sleep_ms(10)
    0
