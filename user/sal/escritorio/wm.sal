fn wm_st_desde_tab(st: Int, tab: Int, i: Int) -> Int ! alloc
    _a = st_set(st, st_cli_fd(), tab_get(tab, i, tab_fd()))
    _b = st_set(st, st_fase(), tab_get(tab, i, tab_fase()))
    _c = st_set(st, st_shm_id(), tab_get(tab, i, tab_shm_id()))
    _d = st_set(st, st_shm_ptr(), tab_get(tab, i, tab_shm_ptr()))
    _e = st_set(st, st_cw(), tab_get(tab, i, tab_cw()))
    _f = st_set(st, st_ch(), tab_get(tab, i, tab_ch()))
    _g = st_set(st, st_wx(), tab_get(tab, i, tab_wx()))
    _h = st_set(st, st_wy(), tab_get(tab, i, tab_wy()))
    _i = st_set(st, st_ww(), tab_get(tab, i, tab_ww()))
    _j = st_set(st, st_wh(), tab_get(tab, i, tab_wh()))
    0

fn wm_tab_desde_st(st: Int, tab: Int, i: Int) -> Int ! alloc
