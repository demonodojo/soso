    16

fn wm_color_cursor(st: Int) -> Int ! alloc
    tema_texto(wm_tema_id(st))

fn wm_color_cursor_borde(st: Int) -> Int ! alloc
    tema_fondo_abajo(wm_tema_id(st))

fn wm_cursor_pixel(lx: Int, ly: Int) -> Int
    ok = 0
    if ly >= 0
        if ly < 11
            if lx >= 0
                if lx <= ly
                    ok = 1
        if ly >= 11
            if ly < 16
                if lx >= 0
                    if lx <= 1
                        ok = 1
    ok

fn wm_pedir_repintar(st: Int) -> Int ! alloc
    _r = st_set(st, st_repintar(), 1)
    _b = st_set(st, st_bak_ok(), 0)
    0

fn wm_cursor_bak(st: Int) -> Int ! alloc
    st_get(st, st_cursor_bak())

fn wm_cursor_bak_len() -> Int
    wm_cursor_w() * wm_cursor_h() * 4

fn wm_cursor_ancho_visible(x: Int, stride: Int) -> Int
    min(wm_cursor_w(), stride - x)

fn wm_cursor_alto_visible(y: Int, stride: Int, bpp: Int, clen: Int) -> Int
    min(wm_cursor_h(), clen / (stride * bpp) - y)

fn wm_cursor_restaurar(st: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc
    if st_get(st, st_bak_ok()) != 0
        ox = st_get(st, st_mx_prev())
        oy = st_get(st, st_my_prev())
        bak = wm_cursor_bak(st)
        cw = wm_cursor_ancho_visible(ox, stride)
        ch = wm_cursor_alto_visible(oy, stride, bpp, clen)
        _c = copiar_rect(compos, clen, stride, bak, wm_cursor_bak_len(), wm_cursor_w(), bpp, fmt, ox, oy, 0, 0, cw, ch)
        _d = wm_cursor_marcar(st, ox, oy)
        _k = st_set(st, st_bak_ok(), 0)
    0

fn wm_cursor_capturar(st: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc
    mx = st_get(st, st_mx())
    my = st_get(st, st_my())
    cw = wm_cursor_ancho_visible(mx, stride)
    ch = wm_cursor_alto_visible(my, stride, bpp, clen)
    _g = copiar_rect(wm_cursor_bak(st), wm_cursor_bak_len(), wm_cursor_w(), compos, clen, stride, bpp, fmt, 0, 0, mx, my, cw, ch)
    _a = st_set(st, st_mx_prev(), mx)
    _b = st_set(st, st_my_prev(), my)
    _k = st_set(st, st_bak_ok(), 1)
    0

fn wm_cursor_marcar(st: Int, mx: Int, my: Int) -> Int ! alloc
    w = wm_cursor_w()
    h = wm_cursor_h()
    _d = wm_marcar_dirty(st, mx, my, mx + w, my + h)
    0

fn wm_cursor_actualizar(st: Int, x: Int, y: Int, sw: Int, sh: Int) -> Int ! alloc
    nx = x
    if nx < 0
        nx = 0
    if nx > sw - 1
        nx = sw - 1
    ny = y
    if ny < 0
        ny = 0
    if ny > sh - 1
        ny = sh - 1
    ox = st_get(st, st_mx())
    oy = st_get(st, st_my())
    if ox != nx
        _p = wm_cursor_marcar(st, ox, oy)
    if oy != ny
        _p2 = wm_cursor_marcar(st, ox, oy)
    if nx != ox
        _n = wm_cursor_marcar(st, nx, ny)
    if ny != oy
        _n2 = wm_cursor_marcar(st, nx, ny)
    _c = st_set(st, st_mx(), nx)
    _d = st_set(st, st_my(), ny)
    0

fn wm_pintar_cursor_buf(st: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, ox: Int, oy: Int) -> Int ! alloc
    ly = 0
    while ly < wm_cursor_h()
        lx = 0
        while lx < wm_cursor_w()
            if wm_cursor_pixel(lx, ly) != 0
                px = ox + lx
                py = oy + ly
                col = wm_color_cursor(st)
                if lx == ly
                    col = wm_color_cursor_borde(st)
                if ly == 0
                    col = wm_color_cursor_borde(st)
                if ly >= 11
                    if lx == 1
                        col = wm_color_cursor_borde(st)
                _p = pixel_escribir(compos, clen, stride, bpp, fmt, px, py, col)
            lx = lx + 1
        ly = ly + 1
    0

fn wm_pintar_cursor(st: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc
    mx = st_get(st, st_mx())
    my = st_get(st, st_my())
    _b = wm_pintar_cursor_buf(st, compos, clen, stride, bpp, fmt, mx, my)
    _d = wm_cursor_marcar(st, mx, my)
    0

fn wm_iniciar_cursor(st: Int, sw: Int, sh: Int) -> Int ! alloc
    cx = sw / 2
    cy = sh / 2
    _a = st_set(st, st_mx(), cx)
    _b = st_set(st, st_my(), cy)
    _c = st_set(st, st_mx_prev(), cx)
    _d = st_set(st, st_my_prev(), cy)
    0

