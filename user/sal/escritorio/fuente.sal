import "mate.sal"
import "superficie.sal"

fn psf2_magic() -> Int
    2253043058

fn psf2_magic_ok(ptr: Int, len: Int) -> Int ! alloc
    if len < 32
        0
    else
        b = bytes_view_mem(ptr, len)
        if bytes_get_u32(b, 0) != psf2_magic()
            0
        else
            1

fn psf2_flags(ptr: Int, len: Int) -> Int ! alloc
    bytes_get_u32(bytes_view_mem(ptr, len), 12)

fn psf2_alto(ptr: Int, len: Int) -> Int ! alloc
    bytes_get_u32(bytes_view_mem(ptr, len), 16)

fn psf2_ancho(ptr: Int, len: Int) -> Int ! alloc
    bytes_get_u32(bytes_view_mem(ptr, len), 20)

fn psf2_bytes_glifo(ptr: Int, len: Int) -> Int ! alloc
    bytes_get_u32(bytes_view_mem(ptr, len), 24)

fn psf2_num(ptr: Int, len: Int) -> Int ! alloc
    bytes_get_u32(bytes_view_mem(ptr, len), 28)

fn psf2_headersize(ptr: Int, len: Int) -> Int ! alloc
    hs = bytes_get_u32(bytes_view_mem(ptr, len), 8)
    if hs < 32
        32
    else
        hs

fn psf2_tabla_off() -> Int
    32

# Puntuación tipográfica que la fuente no trae -> su equivalente ASCII.
fn fuente_cp_ascii(cp: Int) -> Int
    if cp == 8211
        45
    elsif cp == 8212
        45
    elsif cp == 8722
        45
    elsif cp == 8216
        39
    elsif cp == 8217
        39
    elsif cp == 8220
        34
    elsif cp == 8221
        34
    elsif cp == 8230
        46
    elsif cp == 8226
        42
    elsif cp == 160
        32
    else
        cp

# Índice de `cp` en la tabla Unicode de la fuente, o -1.
fn psf2_buscar(ptr: Int, len: Int, cp: Int) -> Int ! alloc
    b = bytes_view_mem(ptr, len)
    n = psf2_num(ptr, len)
    base = psf2_tabla_off()
    ix = -1
    # Camino rápido: en las fuentes habituales los 128 primeros glifos son ASCII en orden.
    if cp >= 0
        if cp < n
            if bytes_get_u32(b, base + cp * 4) == cp
                ix = cp
    if ix < 0
        i = 0
        while i < n
            if bytes_get_u32(b, base + i * 4) == cp
                ix = i
                i = n
            i = i + 1
    ix

fn psf2_glyph_index(ptr: Int, len: Int, cp: Int) -> Int ! alloc
    fl = psf2_flags(ptr, len)
    if (fl & 1) == 0
        cp
    else
        ix = psf2_buscar(ptr, len, cp)
        if ix < 0
            alt = fuente_cp_ascii(cp)
            if alt != cp
                ix = psf2_buscar(ptr, len, alt)
        if ix < 0
            ix = psf2_buscar(ptr, len, 63)
        if ix < 0
            0
        else
            ix

fn psf2_offset_glifo(ptr: Int, len: Int, cp: Int) -> Int ! alloc
    if cp < 0
        -1
    else
        ix = psf2_glyph_index(ptr, len, cp)
        if ix < 0
            psf2_offset_glifo(ptr, len, 63)
        else
            base = psf2_headersize(ptr, len)
            base + ix * psf2_bytes_glifo(ptr, len)

fn psf2_bit_mask(bit: Int) -> Int
    if bit == 0
        1
    elsif bit == 1
        2
    elsif bit == 2
        4
    elsif bit == 3
        8
    elsif bit == 4
        16
    elsif bit == 5
        32
    elsif bit == 6
        64
    else
        128

fn psf2_glifo_byte(ptr: Int, len: Int, cp: Int, row: Int, col: Int) -> Int ! alloc
    off = psf2_offset_glifo(ptr, len, cp)
    if off < 0
        0
    else
        gw = psf2_ancho(ptr, len)
        gh = psf2_alto(ptr, len)
        if row < 0
            0
        elsif row >= gh
            0
        elsif col < 0
            0
        elsif col >= gw
            0
        else
            psf = bytes_view_mem(ptr, len)
            byte_i = row * ((gw + 7) / 8) + col / 8
            bit = 7 - mod_pos(col, 8)
            v = bytes_get_u8(psf, off + byte_i)
            mask = psf2_bit_mask(bit)
            if mod_pos(v, mask * 2) >= mask
                1
            else
                0

fn fuente_dibujar(psf_ptr: Int, psf_len: Int, pix_ptr: Int, pix_len: Int, stride: Int, bpp: Int, fmt: Int, cp: Int, fg: Int, bg: Int, cx: Int, cy: Int) -> Int ! alloc
    if psf2_magic_ok(psf_ptr, psf_len) == 0
        1
    else
        gw = psf2_ancho(psf_ptr, psf_len)
        gh = psf2_alto(psf_ptr, psf_len)
        alto = pix_len / (stride * bpp)
        # Fondo de la celda de una vez; después sólo los píxeles de tinta.
        _f = rellenar_rect(pix_ptr, pix_len, stride, alto, stride, bpp, fmt, cx, cy, cx + gw, cy + gh, bg)
        if cp != 32
            if cp != 0
                off = psf2_offset_glifo(psf_ptr, psf_len, cp)
                if off >= 0
                    psf = bytes_view_mem(psf_ptr, psf_len)
                    bpr = (gw + 7) / 8
                    row = 0
                    while row < gh
                        py = cy + row
                        if py >= 0
                            if py < alto
                                col = 0
                                while col < gw
                                    px = cx + col
                                    if px >= 0
                                        if px < stride
                                            v = bytes_get_u8(psf, off + row * bpr + col / 8)
                                            if ((v >> (7 - (col & 7))) & 1) != 0
                                                _p = pixel_escribir(pix_ptr, pix_len, stride, bpp, fmt, px, py, fg)
                                    col = col + 1
                        row = row + 1
        0
