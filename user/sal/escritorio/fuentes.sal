import "mate.sal"

fn fuente_niveles() -> Int
    5

fn fuente_gw(nivel: Int) -> Int
    if nivel == 0
        6
    elsif nivel == 1
        8
    elsif nivel == 2
        12
    elsif nivel == 3
        16
    else
        32

fn fuente_gh(nivel: Int) -> Int
    if nivel == 0
        12
    elsif nivel == 1
        16
    elsif nivel == 2
        24
    elsif nivel == 3
        32
    else
        64

fn fuente_ruta(nivel: Int) -> String ! alloc
    if nivel == 0
        d"/lib/fonts/spleen-6x12.psf2"
    elsif nivel == 1
        d"/lib/fonts/spleen-8x16.psf2"
    elsif nivel == 2
        d"/lib/fonts/spleen-12x24.psf2"
    elsif nivel == 3
        d"/lib/fonts/spleen-16x32.psf2"
    else
        d"/lib/fonts/spleen-32x64.psf2"

fn fuente_inicial_por_ancho(sw: Int) -> Int
    if sw >= 1920
        2
    else
        1

fn fuente_nivel_ok(nivel: Int) -> Int
    if nivel < 0
        0
    elsif nivel >= fuente_niveles()
        0
    else
        1

# Glifo PSF2 cargado para un nivel de escala. `ptr` es el búfer crudo que
# vive hasta el fin del proceso.
struct Fuente
    ptr: Int
    len: Int

struct Fuentes
    niveles: List[Fuente]

init Fuentes() ! alloc
    xs = list_new[Fuente]()
    i = 0
    while i < fuente_niveles()
        _f = list_push(&mut xs, Fuente(0, 0))
        i = i + 1
    Fuentes(xs)

method Fuentes.ptr(&self, nivel: Int) -> Int
    if fuente_nivel_ok(nivel) == 0
        0
    else
        f = list_get(&self.niveles, nivel)
        f.ptr

method Fuentes.len(&self, nivel: Int) -> Int
    if fuente_nivel_ok(nivel) == 0
        0
    else
        f = list_get(&self.niveles, nivel)
        if f.len < 0
            0
        else
            f.len

method Fuentes.set(&mut self, nivel: Int, ptr: Int, len: Int) -> Int
    f = list_get(&mut self.niveles, nivel)
    f.ptr = ptr
    f.len = len
    0

method Fuentes.cargar(&mut self, nivel: Int) -> Int ! io, alloc
    if fuente_nivel_ok(nivel) == 0
        -1
    elsif self.len(nivel) > 0
        0
    else
        s = read_file(fuente_ruta(nivel))
        n = str_len(s)
        if n < 32
            -1
        else
            # Fuga intencional: la tabla guarda el ptr hasta el fin del proceso.
            ptr = bytes_ptr(bytes_new(n + 1))
            v = bytes_view_mem(ptr, n + 1)
            str_bytes_copy(v, 0, s)
            _t = self.set(nivel, ptr, n)
            0

method Fuentes.psf(&mut self, nivel: Int) -> Int ! io, alloc
    _c = self.cargar(nivel)
    self.ptr(nivel)

method Fuentes.psf_len(&mut self, nivel: Int) -> Int ! io, alloc
    _c = self.cargar(nivel)
    self.len(nivel)

fn metrica_barra_alto(gh: Int) -> Int
    gh + 8

fn metrica_menu_item_alto(gh: Int) -> Int
    gh + 6

fn metrica_margen(gw: Int) -> Int
    gw

fn metrica_radio(gh: Int) -> Int
    if gh / 2 < 4
        4
    else
        if gh / 2 > 12
            12
        else
            gh / 2
