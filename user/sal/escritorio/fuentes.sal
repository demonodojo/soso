import "mate.sal"
import "ttf.sal"

fn fuente_niveles() -> Int
    5

fn fuente_gw(nivel: Int) -> Int
    if nivel == 0
        6
    elsif nivel == 1
        8
    elsif nivel == 2
        12
    elsif nivel == 3
        16
    else
        32

fn fuente_gh(nivel: Int) -> Int
    if nivel == 0
        12
    elsif nivel == 1
        16
    elsif nivel == 2
        24
    elsif nivel == 3
        32
    else
        64

# Letra del escritorio: TrueType rasterizada en tiempo de ejecución (ttf.sal), con
# DejaVu Sans Mono en celdas para el terminal y DejaVu Sans proporcional para la
# interfaz. Si no están, el terminal cae a las Spleen de mapa de bits.
fn fuente_ruta_mono() -> String ! alloc
    d"/lib/fonts/DejaVuSansMono.ttf"

fn fuente_ruta_sans() -> String ! alloc
    d"/lib/fonts/DejaVuSans.ttf"

fn fuente_ruta_bitmap(nivel: Int) -> String ! alloc
    if nivel == 0
        d"/lib/fonts/spleen-6x12.psf2"
    elsif nivel == 1
        d"/lib/fonts/spleen-8x16.psf2"
    elsif nivel == 2
        d"/lib/fonts/spleen-12x24.psf2"
    elsif nivel == 3
        d"/lib/fonts/spleen-16x32.psf2"
    else
        d"/lib/fonts/spleen-32x64.psf2"

# Píxeles por em de la letra de la interfaz para un nivel (13 px con celdas de 16).
fn fuente_ui_px(nivel: Int) -> Int
    fuente_gh(nivel) * 13 / 16

fn fuente_inicial_por_ancho(sw: Int) -> Int
    if sw >= 1920
        2
    else
        1

fn fuente_nivel_ok(nivel: Int) -> Int
    if nivel < 0
        0
    elsif nivel >= fuente_niveles()
        0
    else
        1

# Fuente cargada para un nivel de escala: una caché TTF en modo celda (ttf.sal) o, si
# no hay TrueType, una .psf2. `ptr` vive hasta el fin del proceso.
struct Fuente
    ptr: Int
    len: Int

# `mono` y `sans` son los .ttf leídos (0 = sin intentar, -1 = no están).
struct Fuentes
    niveles: List[Fuente]
    ui: List[Fuente]
    mono: Int
    sans: Int

init Fuentes() ! alloc
    xs = list_new[Fuente]()
    us = list_new[Fuente]()
    i = 0
    while i < fuente_niveles()
        _f = list_push(&mut xs, Fuente(0, 0))
        _u = list_push(&mut us, Fuente(0, 0))
        i = i + 1
    Fuentes(xs, us, 0, 0)

method Fuentes.ptr(&self, nivel: Int) -> Int
    if fuente_nivel_ok(nivel) == 0
        0
    else
        f = list_get(&self.niveles, nivel)
        f.ptr

method Fuentes.len(&self, nivel: Int) -> Int
    if fuente_nivel_ok(nivel) == 0
        0
    else
        f = list_get(&self.niveles, nivel)
        if f.len < 0
            0
        else
            f.len

method Fuentes.set(&mut self, nivel: Int, ptr: Int, len: Int) -> Int
    f = list_get(&mut self.niveles, nivel)
    f.ptr = ptr
    f.len = len
    0

method Fuentes.ttf_mono(&mut self) -> Int ! io, alloc
    if self.mono == 0
        p = ttf_cargar_fichero(fuente_ruta_mono())
        if p == 0
            p = -1
        self.mono = p
    self.mono

method Fuentes.ttf_sans(&mut self) -> Int ! io, alloc
    if self.sans == 0
        p = ttf_cargar_fichero(fuente_ruta_sans())
        if p == 0
            p = -1
        self.sans = p
    self.sans

method Fuentes.cargar(&mut self, nivel: Int) -> Int ! io, alloc
    if fuente_nivel_ok(nivel) == 0
        -1
    elsif self.len(nivel) > 0
        0
    else
        h = 0
        fp = self.ttf_mono()
        if fp > 0
            h = ttf_cache_celda(fp, ttf_fichero_len(fp), fuente_gw(nivel), fuente_gh(nivel))
        if h != 0
            _t = self.set(nivel, h, ttf_h_len())
            0
        else
            s = read_file(fuente_ruta_bitmap(nivel))
            n = str_len(s)
            if n < 32
                -1
            else
                # Fuga intencional: la tabla guarda el ptr hasta el fin del proceso.
                ptr = bytes_ptr(bytes_new(n + 1))
                v = bytes_view_mem(ptr, n + 1)
                str_bytes_copy(v, 0, s)
                _t2 = self.set(nivel, ptr, n)
                0

method Fuentes.psf(&mut self, nivel: Int) -> Int ! io, alloc
    _c = self.cargar(nivel)
    self.ptr(nivel)

method Fuentes.psf_len(&mut self, nivel: Int) -> Int ! io, alloc
    _c = self.cargar(nivel)
    self.len(nivel)

# Caché TTF proporcional de la interfaz para el nivel, o 0 si no hay DejaVu Sans.
method Fuentes.ui(&mut self, nivel: Int) -> Int ! io, alloc
    if fuente_nivel_ok(nivel) == 0
        0
    else
        f = list_get(&self.ui, nivel)
        h = f.ptr
        if h == 0
            fp = self.ttf_sans()
            if fp > 0
                h = ttf_cache_libre(fp, ttf_fichero_len(fp), fuente_ui_px(nivel))
            if h == 0
                h = -1
            g = list_get(&mut self.ui, nivel)
            g.ptr = h
        if h < 0
            0
        else
            h

fn metrica_barra_alto(gh: Int) -> Int
    gh + 8

fn metrica_menu_item_alto(gh: Int) -> Int
    gh + 6

fn metrica_margen(gw: Int) -> Int
    gw

fn metrica_radio(gh: Int) -> Int
    if gh / 2 < 4
        4
    else
        if gh / 2 > 12
            12
        else
            gh / 2
