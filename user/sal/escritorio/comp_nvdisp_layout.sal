import "mate.sal"

fn nvdisp_head_w() -> Int
    640

fn nvdisp_head_h() -> Int
    480

fn nvdisp_head_pitch() -> Int
    2560

fn nvdisp_head_fb_vram() -> Int
    25165824

fn nvdisp_clip_w(x: Int, w: Int, max_w: Int) -> Int
    if x >= max_w
        -1
    else
        if x + w > max_w
            max_w - x
        else
            w

fn nvdisp_clip_h(y: Int, h: Int, max_h: Int) -> Int
    if y >= max_h
        -1
    else
        if y + h > max_h
            max_h - y
        else
            h
