import "mate.sal"

fn utf8_reempl() -> Int
    65533

fn utf8_inicio() -> Int
    0

# Estados pendientes: todos >= utf8_pend() (2^30); un resultado menor es un punto
# de código terminado (o U+FFFD). Así un cp >= 256 no se confunde con un estado.
fn utf8_pend() -> Int
    1073741824

fn utf8_pendiente(x: Int) -> Int
    if x >= utf8_pend()
        1
    else
        0

# Estado: pend + (restantes << 24) + (primero << 23) + dato (lead, o cp parcial).
fn utf8_feed(st: Int, c: Int) -> Int
    b = u8(c)
    if st < utf8_pend()
        if b < 128
            b
        elsif b < 194
            utf8_reempl()
        elsif b <= 223
            utf8_pend() + (1 << 24) + (1 << 23) + (b & 31)
        elsif b <= 239
            utf8_pend() + (2 << 24) + (1 << 23) + b
        elsif b <= 244
            utf8_pend() + (3 << 24) + (1 << 23) + b
        else
            utf8_reempl()
    else
        rest = (st >> 24) & 7
        primero = (st >> 23) & 1
        dato = st & 8388607
        if b < 128
            utf8_reempl()
        elsif b > 191
            utf8_reempl()
        else
            bad = 0
            if primero != 0
                if dato == 224
                    if b < 160
                        bad = 1
                if dato == 237
                    if b >= 160
                        bad = 1
                if dato == 240
                    if b < 144
                        bad = 1
                if dato == 244
                    if b > 143
                        bad = 1
            if bad != 0
                utf8_reempl()
            else
                acc = (dato << 6) | (b & 63)
                if primero != 0
                    if rest == 1
                        acc = (dato << 6) | (b & 63)
                    else
                        if dato >= 240
                            acc = ((dato & 7) << 6) | (b & 63)
                        else
                            acc = ((dato & 15) << 6) | (b & 63)
                if rest == 1
                    acc
                else
                    utf8_pend() + ((rest - 1) << 24) + acc

fn utf8_final(st: Int) -> Int
    if st < 0
        -1
    else
        if st < 128
            st
        else
            -1
