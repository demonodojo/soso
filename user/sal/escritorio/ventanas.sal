import "mate.sal"
import "fuentes.sal"

fn tipo_terminal() -> Int
    1

fn tipo_cliente() -> Int
    2

fn barra_alto(gh: Int) -> Int
    metrica_barra_alto(gh)

fn ventana_min_ancho() -> Int
    120

fn ventana_min_alto(gh: Int) -> Int
    metrica_barra_alto(gh) + 56

fn ventana_contiene(x: Int, y: Int, wx: Int, wy: Int, ww: Int, wh: Int) -> Int
    if x < wx
        0
    elsif y < wy
        0
    elsif x >= wx + ww
        0
    elsif y >= wy + wh
        0
    else
        1

fn ventana_hit_titulo(x: Int, y: Int, wx: Int, wy: Int, ww: Int, gh: Int) -> Int
    bh = barra_alto(gh)
    if ventana_contiene(x, y, wx, wy, ww, bh) == 0
        0
    else
        1

fn ventana_hit_cerrar(x: Int, y: Int, wx: Int, wy: Int, ww: Int, gh: Int) -> Int
    bh = barra_alto(gh)
    btn = gh + 4
    cx = wx + ww - btn - 4
    if x < cx
        0
    elsif x >= cx + btn
        0
    elsif y < wy
        0
    elsif y >= wy + bh
        0
    else
        1

fn ventana_hit_resize(x: Int, y: Int, wx: Int, wy: Int, ww: Int, wh: Int) -> Int
    if x < wx + ww - 12
        0
    elsif y < wy + wh - 12
        0
    elsif x >= wx + ww
        0
    elsif y >= wy + wh
        0
    else
        1

fn ventana_mosaico_cols(total: Int) -> Int
    if total <= 1
        1
    else
        if total <= 4
            2
        else
            4

fn ventana_mosaico_filas(total: Int, cols: Int) -> Int
    if cols <= 0
        1
    else
        (total + cols - 1) / cols

fn ventana_mosaico_wx(i: Int, total: Int, pantalla_w: Int, pantalla_h: Int) -> Int
    cols = ventana_mosaico_cols(total)
    col = mod_pos(i, cols)
    base_w = pantalla_w / cols
    col * base_w

fn ventana_mosaico_wy(i: Int, total: Int, pantalla_w: Int, pantalla_h: Int, bar_h: Int) -> Int
    cols = ventana_mosaico_cols(total)
    filas = ventana_mosaico_filas(total, cols)
    row = i / cols
    area_h = pantalla_h - bar_h
    base_h = area_h / filas
    bar_h + row * base_h

fn ventana_mosaico_ww(i: Int, total: Int, pantalla_w: Int, pantalla_h: Int) -> Int
    cols = ventana_mosaico_cols(total)
    col = mod_pos(i, cols)
    base_w = pantalla_w / cols
    wx = ventana_mosaico_wx(i, total, pantalla_w, pantalla_h)
    if col == cols - 1
        pantalla_w - wx
    else
        base_w

fn ventana_mosaico_wh(i: Int, total: Int, pantalla_w: Int, pantalla_h: Int, bar_h: Int) -> Int
    cols = ventana_mosaico_cols(total)
    filas = ventana_mosaico_filas(total, cols)
    row = i / cols
    wy = ventana_mosaico_wy(i, total, pantalla_w, pantalla_h, bar_h)
    if row == filas - 1
        pantalla_h - wy
    else
        area_h = pantalla_h - bar_h
        area_h / filas

fn ventana_recortar_nx(wx: Int) -> Int
    if wx < 0
        0
    else
        wx

fn ventana_recortar_ny(wy: Int, bar_h: Int) -> Int
    if wy < bar_h
        bar_h
    else
        wy

fn ventana_recortar_nw(wx: Int, ww: Int, sw: Int, nx: Int) -> Int
    nw = ww
    if nx + nw > sw
        nw = max(ventana_min_ancho(), sw - nx)
    nw

fn ventana_recortar_nh(wh: Int, sh: Int, ny: Int, gh: Int) -> Int
    bh = barra_alto(gh)
    nh = wh
    if ny + nh > sh
        nh = max(ventana_min_alto(gh), sh - ny)
    nh
