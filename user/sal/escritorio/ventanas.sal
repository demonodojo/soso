import "mate.sal"

fn tipo_terminal() -> Int
    1

fn tipo_cliente() -> Int
    2

fn barra_alto() -> Int
    24

fn ventana_min_ancho() -> Int
    120

fn ventana_min_alto() -> Int
    80

fn ventana_contiene(x: Int, y: Int, wx: Int, wy: Int, ww: Int, wh: Int) -> Int
    if x < wx
        0
    elsif y < wy
        0
    elsif x >= wx + ww
        0
    elsif y >= wy + wh
        0
    else
        1

fn ventana_hit_titulo(x: Int, y: Int, wx: Int, wy: Int, ww: Int) -> Int
    if ventana_contiene(x, y, wx, wy, ww, barra_alto()) == 0
        0
    else
        1

fn ventana_hit_cerrar(x: Int, y: Int, wx: Int, wy: Int, ww: Int) -> Int
    cx = wx + ww - 20
    if x < cx
        0
    elsif x >= cx + 16
        0
    elsif y < wy
        0
    elsif y >= wy + barra_alto()
        0
    else
        1

fn ventana_hit_resize(x: Int, y: Int, wx: Int, wy: Int, ww: Int, wh: Int) -> Int
    if x < wx + ww - 12
        0
    elsif y < wy + wh - 12
        0
    elsif x >= wx + ww
        0
    elsif y >= wy + wh
        0
    else
        1

fn ventana_mosaico_wx(i: Int, total: Int, pantalla_w: Int, pantalla_h: Int) -> Int
    if total <= 0
        0
    else
        if total == 1
            0
        else
            if i == 0
                0
            else
                pantalla_w / 2

fn ventana_mosaico_wy(i: Int, total: Int, pantalla_w: Int, pantalla_h: Int) -> Int
    barra_alto()

fn ventana_mosaico_ww(i: Int, total: Int, pantalla_w: Int, pantalla_h: Int) -> Int
    if total <= 0
        pantalla_w
    else
        if total == 1
            pantalla_w
        else
            if i == 0
                pantalla_w / 2
            else
                pantalla_w - pantalla_w / 2

fn ventana_mosaico_wh(i: Int, total: Int, pantalla_w: Int, pantalla_h: Int) -> Int
    pantalla_h - barra_alto()

fn ventana_recortar_pantalla(wx: Int, wy: Int, ww: Int, wh: Int, sw: Int, sh: Int) -> Int
    # Devuelve wx*1e9+wy*1e6+ww*1e3+wh recortado (solo uso interno WM legacy).
    nx = max(0, wx)
    ny = max(barra_alto(), wy)
    nw = ww
    nh = wh
    if nx + nw > sw
        nw = max(ventana_min_ancho(), sw - nx)
    if ny + nh > sh
        nh = max(ventana_min_alto() + barra_alto(), sh - ny)
    nx * 1000000000 + ny * 1000000 + nw * 1000 + nh

fn ventana_clip_wx(p: Int) -> Int
    p / 1000000000

fn ventana_clip_wy(p: Int) -> Int
    mod_pos(p / 1000000, 1000)

fn ventana_clip_ww(p: Int) -> Int
    mod_pos(p / 1000, 1000)

fn ventana_clip_wh(p: Int) -> Int
    mod_pos(p, 1000)
