fn tcp_accept(fd: Int, ms: Int) -> Int ! io
    syscall(sys_tcp_accept(), fd, ms, 0, 0, 0, 0)

fn sockaddr_loopback(port: Int) -> Int ! alloc
    sa = bytes_new(sockaddr_size())
    sap = bytes_ptr(sa)
    b = bytes_view_mem(sap, sockaddr_size())
    bytes_set_u8(b, 0, 127)
    bytes_set_u8(b, 1, 0)
    bytes_set_u8(b, 2, 0)
    bytes_set_u8(b, 3, 1)
    bytes_set_u8(b, 4, u32_b2(port))
    bytes_set_u8(b, 5, u32_b0(port))
    bytes_set_u8(b, 6, 0)
    bytes_set_u8(b, 7, 0)
    sap

fn tcp_connect(port: Int, timeout_ms: Int) -> Int ! io, alloc
    sa = sockaddr_loopback(port)
    syscall(sys_tcp_connect(), sa, timeout_ms, 0, 0, 0, 0)

