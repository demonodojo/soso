fn gpu_gfram_len() -> Int
    comp_gfram_len()

fn gpu_gfram(cmd_ptr: Int, rt_h: Int, tex_h: Int, src_ptr: Int, fb_w: Int, fb_h: Int, pitch: Int, dx: Int, dy: Int, rw: Int, rh: Int, rgba: Int) -> Int ! io, alloc
    b = bytes_view_mem(cmd_ptr, comp_gfram_len())
    _r = bytes_set_i64(b, 5, rt_h)
    _x = bytes_set_i64(b, 13, tex_h)
    _s = bytes_set_i64(b, 21, src_ptr)
    _w = bytes_set_u32(b, 29, fb_w)
    _h = bytes_set_u32(b, 33, fb_h)
    _p = bytes_set_u32(b, 37, pitch)
    _dx = bytes_set_u32(b, 41, dx)
    _dy = bytes_set_u32(b, 45, dy)
    _rw = bytes_set_u32(b, 49, rw)
    _rh = bytes_set_u32(b, 53, rh)
    _c = bytes_set_u32(b, 57, rgba)
    _t = gpu_tag5(cmd_ptr, 0, d"GFRAM")
    gpu_submit(cmd_ptr, comp_gfram_len())

