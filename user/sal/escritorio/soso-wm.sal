import "soso.sal"
import "superficie.sal"
import "term.sal"
import "ventanas.sal"
import "proto.sal"
import "tabla.sal"
import "wm.sal"

fn puerto_wm() -> Int
    7430

fn compos_len(stride: Int, sh: Int, bpp: Int) -> Int
    stride * sh * bpp

fn bucle_wm(st: Int, listener: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    if st_get(st, st_salir()) != 0
        0
    else
        _t = wm_tick(st, listener, compos, clen, sw, sh, stride, bpp, fmt)
        bucle_wm(st, listener, compos, clen, sw, sh, stride, bpp, fmt)

fn prueba_pixel_ok(compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, x: Int, y: Int, r: Int, g: Int, b: Int) -> Int ! alloc
    c = pixel_leer(compos, clen, stride, bpp, fmt, x, y)
    if u32_b2(c) != u8(r)
        0
    else
        if u32_b1(c) != u8(g)
            0
        else
            if u32_b0(c) != u8(b)
                0
            else
                1

fn prueba_modo(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    listener = tcp_listen(puerto_wm())
    if listener < 0
        1
    else
        evt = bytes_ptr(bytes_new(24 * 8))
        msg = bytes_ptr(bytes_new(msg_len()))
        st = st_nuevo(evt, msg)
        _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo())
        _p = spawn_io_full(d"/bin/demo-cliente", 0, 0, 0, fd_kernel_log())
        t0 = uptime_ms()
        ok = 0
        while ok == 0
            if uptime_ms() - t0 > 15000
                ok = 2
            else
                _t = wm_tick(st, listener, compos, clen, sw, sh, stride, bpp, fmt)
                fi = st_get(st, st_focus())
                if fi >= 0
                    tab = st_get(st, st_tab())
                    if tab_get(tab, fi, tab_fase()) == 2
                        wx = tab_get(tab, fi, tab_wx())
                        wy = tab_get(tab, fi, tab_wy())
                        if prueba_pixel_ok(compos, clen, stride, bpp, fmt, wx + 10, wy + barra_alto() + 10, 40, 80, 200) != 0
                            ok = 1
                        else
                            0
                    else
                        0
                else
                    0
        _c = wm_cerrar_cliente(st)
        close_fd(listener)
        if ok == 1
            0
        else
            ok

fn bucle_grafico(ejecutar: String) -> Int ! io, alloc
    info = fb_info_nuevo()
    r = fb_info(info)
    if r < 0
        2
    else
        if fb_info_leer(info) == 0
            3
        else
            _m = fb_set_mode(fb_mode_graficos())
            sw = fb_info_ancho(info)
            sh = fb_info_alto(info)
            stride = fb_info_stride(info)
            bpp = fb_info_bpp(info)
            fmt = fb_info_formato(info)
            plen = compos_len(stride, sh, bpp)
            compos = bytes_ptr(bytes_new(plen))
            evt = bytes_ptr(bytes_new(24 * 8))
            msg = bytes_ptr(bytes_new(msg_len()))
            _bg = rellenar_rect(compos, plen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo())
            listener = tcp_listen(puerto_wm())
            if listener < 0
                4
            else
                st = st_nuevo(evt, msg)
                if str_len(ejecutar) > 0
                    _sp = spawn_io_full(ejecutar, 0, 0, 0, fd_kernel_log())
                _loop = bucle_wm(st, listener, compos, plen, sw, sh, stride, bpp, fmt)
                _c = fb_set_mode(fb_mode_consola())
                close_fd(listener)
                0

fn arg_flag(nombre: String) -> Int ! io, alloc
    a = 1
    ok = 0
    while a < argc()
        if str_eq(argv(a), nombre) != 0
            ok = 1
        a = a + 1
    ok

fn arg_valor(flag: String) -> String ! io, alloc
    a = 1
    while a + 1 < argc()
        if str_eq(argv(a), flag) != 0
            argv(a + 1)
        a = a + 1
    d""

fn prueba_web_modo(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    listener = tcp_listen(puerto_wm())
    if listener < 0
        1
    else
        evt = bytes_ptr(bytes_new(24 * 8))
        msg = bytes_ptr(bytes_new(msg_len()))
        st = st_nuevo(evt, msg)
        _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo())
        _p = spawn_io_4(d"/bin/soso-web", d"--grafico", d"--local", d"/etc/web-prueba.html", 0, 0, 0, fd_kernel_log())
        t0 = uptime_ms()
        ok = 0
        while ok == 0
            if uptime_ms() - t0 > 20000
                ok = 2
            else
                _t = wm_tick(st, listener, compos, clen, sw, sh, stride, bpp, fmt)
                fi = st_get(st, st_focus())
                if fi >= 0
                    tab = st_get(st, st_tab())
                    if tab_get(tab, fi, tab_fase()) >= 1
                        ok = 1
                    else
                        0
                else
                    0
        close_fd(listener)
        if ok == 1
            0
        else
            ok

fn main() -> Int ! io, alloc
    if arg_flag(d"--prueba-web") != 0
        info = fb_info_nuevo()
        r = fb_info(info)
        if r < 0
            prueba_web_modo(0, 0, 640, 480, 640, 4, fmt_bgr())
        else
            sw = fb_info_ancho(info)
            sh = fb_info_alto(info)
            stride = fb_info_stride(info)
            bpp = fb_info_bpp(info)
            fmt = fb_info_formato(info)
            plen = compos_len(stride, sh, bpp)
            compos = bytes_ptr(bytes_new(plen))
            prueba_web_modo(compos, plen, sw, sh, stride, bpp, fmt)
    else
        if arg_flag(d"--prueba") != 0
            info = fb_info_nuevo()
            r = fb_info(info)
            if r < 0
                prueba_modo(0, 0, 640, 480, 640, 4, fmt_bgr())
            else
                sw = fb_info_ancho(info)
                sh = fb_info_alto(info)
                stride = fb_info_stride(info)
                bpp = fb_info_bpp(info)
                fmt = fb_info_formato(info)
                plen = compos_len(stride, sh, bpp)
                compos = bytes_ptr(bytes_new(plen))
                rc = prueba_modo(compos, plen, sw, sh, stride, bpp, fmt)
                if rc == 0
                    0
                else
                    rc
        else
            exe = arg_valor(d"--ejecutar")
            bucle_grafico(exe)
