import "soso.sal"
import "superficie.sal"
import "term.sal"
import "ventanas.sal"
import "proto.sal"
import "tabla.sal"
import "wm.sal"
import "mono.sal"

fn puerto_wm() -> Int
    7430

fn compos_len(stride: Int, sh: Int, bpp: Int) -> Int
    stride * sh * bpp

fn compos_ram(sw: Int, sh: Int, stride: Int, bpp: Int) -> Int ! alloc
    bytes_ptr(bytes_new(compos_len(stride, sh, bpp)))

fn bucle_wm(st: Int, listener: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    while st_get(st, st_salir()) == 0
        _t = wm_tick(st, listener, compos, clen, sw, sh, stride, bpp, fmt)
    0

fn prueba_pixel_ok(compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, x: Int, y: Int, r: Int, g: Int, b: Int) -> Int ! alloc
    c = pixel_leer(compos, clen, stride, bpp, fmt, x, y)
    ok = 1
    if u32_b2(c) != u8(r)
        ok = 0
    if u32_b1(c) != u8(g)
        ok = 0
    if u32_b0(c) != u8(b)
        ok = 0
    ok

fn term_busca_cp(grid: Int, glen: Int, w: Int, h: Int, cp: Int) -> Int ! alloc
    row = 0
    found = 0
    while row < h
        col = 0
        while col < w
            if found == 0
                if term_leer_cp(grid, glen, w, col, row) == cp
                    found = 1
            col = col + 1
        row = row + 1
    found

fn prueba_term_echo(st: Int, tab: Int, i: Int, cp: Int) -> Int ! alloc
    if tab_get(tab, i, tab_tipo()) != tab_tipo_term()
        0
    else
        grid = tab_get(tab, i, tab_shm_ptr())
        ww = tab_get(tab, i, tab_ww())
        wh = tab_get(tab, i, tab_wh())
        gw = wm_tab_gw(tab, i)
        gh = wm_tab_gh(tab, i)
        cols = wm_term_cols(ww, gw)
        rows = wm_term_rows(wh, gh, wm_bar_h(st))
        term_busca_cp(grid, cols * rows * celda_bytes(), cols, rows, cp)

fn prueba_modo(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    listener = tcp_listen(puerto_wm())
    ok = 1
    if listener >= 0
        evt = bytes_ptr(bytes_new(24 * 8))
        msg = bytes_ptr(bytes_new(msg_len()))
        st = st_nuevo(evt, msg)
        _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo(st))
        _t1 = wm_abrir_terminal(st, sw, sh)
        tab = st_get(st, st_tab())
        t0i = st_get(st, st_focus())
        if t0i >= 0
            fd0 = tab_get(tab, t0i, tab_fd())
            _w0 = write_str_fd(fd0, d"echo uno\n")
        _t2 = wm_abrir_terminal(st, sw, sh)
        t1i = st_get(st, st_focus())
        if t1i >= 0
            fd1 = tab_get(tab, t1i, tab_fd())
            _w1 = write_str_fd(fd1, d"echo dos\n")
        _p = spawn_io_full(d"/bin/demo-cliente", fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
        t0 = uptime_ms()
        ok = 0
        demo = 0
        uno = 0
        dos = 0
        demo_i = -1
        vstage = 0
        while ok == 0
            if uptime_ms() - t0 > 20000
                ok = 2
            if ok == 0
                _t = wm_tick(st, listener, compos, clen, sw, sh, stride, bpp, fmt)
            if ok == 0
                tab = st_get(st, st_tab())
                if uno == 0
                    if t0i >= 0
                        if prueba_term_echo(st, tab, t0i, 117) != 0
                            uno = 1
                if dos == 0
                    if t1i >= 0
                        if prueba_term_echo(st, tab, t1i, 100) != 0
                            dos = 1
                if demo == 0
                    fi = st_get(st, st_focus())
                    if fi >= 0
                        if tab_get(tab, fi, tab_fase()) == 2
                            wx = tab_get(tab, fi, tab_wx())
                            wy = tab_get(tab, fi, tab_wy())
                            if prueba_pixel_ok(compos, clen, stride, bpp, fmt, wx + 10, wy + wm_bar_h(st) + 10, 40, 80, 200) != 0
                                demo = 1
                                demo_i = fi
                # T3 de extremo a extremo con un cliente real (demo-cliente ignora
                # VISIBLE): al tapar su panel con otra pestaña el WM le avisa (vis=2),
                # al destaparlo también (vis=1) y la conexión sigue viva.
                if uno != 0
                    if dos != 0
                        if demo != 0
                            if vstage == 0
                                _ig = wm_integrar(st, t1i, demo_i)
                                _ac = grupo_activar(tab, t1i)
                                vstage = 1
                            elsif vstage == 1
                                if tab_get(tab, demo_i, tab_vis()) == 2
                                    _ac2 = grupo_activar(tab, demo_i)
                                    vstage = 2
                            elsif vstage == 2
                                if tab_get(tab, demo_i, tab_vis()) == 1
                                    ok = 1
        close_fd(listener)
        if ok == 2
            _d1 = print_str(d"soso-wm: prueba plazo agotado; faltan:")
            if uno == 0
                _d2 = print_str(d" eco-uno")
            if dos == 0
                _d3 = print_str(d" eco-dos")
            if demo == 0
                _d4 = print_str(d" pixel-demo")
            if demo != 0
                if vstage != 2
                    _d6 = print_str(d" visible-oculto")
                else
                    _d7 = print_str(d" visible-reaparece")
            _d5 = print_str(d"\n")
        if ok == 1
            _pr = print_str(d"soso-wm: prueba OK\n")
            ok = 0
    ok

fn prueba_mono_shm_ok(ptr: Int, slen: Int, cw: Int, ch: Int, fmt: Int, paso: Int) -> Int ! alloc
    mx = mono_paso_x(paso, cw, mono_ancho())
    my = mono_paso_y(paso, ch, mono_alto())
    fotograma = mono_fotograma(paso)
    lx = 15
    ly = 9
    exp = mono_pixel_rgb(lx, ly, fotograma)
    if exp == 0
        0
    else
        got = pixel_leer(ptr, slen, cw, 4, fmt, mx + lx, my + ly)
        if got == exp
            1
        else
            0

fn prueba_mono_shm_cualquier_paso(ptr: Int, slen: Int, cw: Int, ch: Int, fmt: Int) -> Int ! alloc
    paso = 0
    ok = 0
    while paso < 24
        if ok == 0
            if prueba_mono_shm_ok(ptr, slen, cw, ch, fmt, paso) != 0
                ok = 1
        paso = paso + 1
    ok

fn prueba_mono_modo(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    listener = tcp_listen(puerto_wm())
    ok = 7
    if listener < 0
        ok = 7
    if listener >= 0
        evt = bytes_ptr(bytes_new(24 * 8))
        msg = bytes_ptr(bytes_new(msg_len()))
        st = st_nuevo(evt, msg)
        mono_pid = -1
        _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo(st))
        warm = 0
        while warm < 8
            _w = wm_tick(st, listener, compos, clen, sw, sh, stride, bpp, fmt)
            warm = warm + 1
        _ss = wm_ss_armar(st, compos, clen, sw, sh, stride, bpp, fmt)
        if _ss == 0
            ok = 4
        if _ss != 0
            mono_pid = spawn_io_argv(d"/bin/soso-mono", d"--once", d"", d"", d"", d"", 2, fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
            if mono_pid < 0
                ok = 4
            if mono_pid >= 0
                _mp = st_set(st, st_ss_pid(), mono_pid)
                t0 = uptime_ms()
                pintado = 0
                fase2 = 0
                ok = 0
                while ok == 0
                    if uptime_ms() - t0 > 25000
                        if fase2 != 0
                            ok = 6
                        else
                            ok = 5
                    if ok == 0
                        _t = wm_tick(st, listener, compos, clen, sw, sh, stride, bpp, fmt)
                    if ok == 0
                        si = st_get(st, st_ss_slot())
                        if si >= 0
                            tab = st_get(st, st_tab())
                            if tab_get(tab, si, tab_fase()) == 2
                                fase2 = 1
                                ptr = tab_get(tab, si, tab_shm_ptr())
                                if ptr > 0
                                    cw = tab_get(tab, si, tab_cw())
                                    ch = tab_get(tab, si, tab_ch())
                                    slen = cw * ch * 4
                                    if prueba_mono_shm_cualquier_paso(ptr, slen, cw, ch, fmt) != 0
                                        pintado = 1
                        if pintado != 0
                            ok = 1
            if mono_pid > 0
                _k = kill_pid(mono_pid, 9)
        _x = wm_ss_cerrar(st)
        close_fd(listener)
        if ok == 1
            _pr = print_str(d"soso-wm: prueba-mono OK\n")
            ok = 0
    ok

fn prueba_lanzar_uno() -> Int ! io, alloc
    pid = spawn_io_full(d"/bin/demo-cliente", fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
    if pid > 0
        _k = kill_pid(pid, 9)
    pid

fn prueba_lanzar_modo() -> Int ! io, alloc
    ok = 0
    i = 0
    while i < 3
        if prueba_lanzar_uno() < 0
            ok = 1
        i = i + 1
    if ok == 0
        _pr = print_str(d"soso-wm: prueba-lanzar OK\n")
    ok

fn bucle_grafico(ejecutar: String) -> Int ! io, alloc
    info = fb_info_nuevo()
    r = fb_info(info)
    rc = 0
    if r < 0
        rc = 2
    if r >= 0
        if fb_info_leer(info) == 0
            rc = 3
        if fb_info_leer(info) != 0
            _m = fb_set_mode(fb_mode_graficos())
            sw = fb_info_ancho(info)
            sh = fb_info_alto(info)
            stride = fb_info_stride(info)
            bpp = fb_info_bpp(info)
            fmt = fb_info_formato(info)
            plen = compos_len(stride, sh, bpp)
            evt = bytes_ptr(bytes_new(24 * 8))
            msg = bytes_ptr(bytes_new(msg_len()))
            st = st_nuevo(evt, msg)
            sin_comp = arg_flag(d"--sin-comp")
            compos = wm_comp_ensure(st, sw, sh, stride, sin_comp)
            if compos < 0
                compos = bytes_ptr(bytes_new(plen))
            _bg = rellenar_rect(compos, plen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo(st))
            listener = tcp_listen(puerto_wm())
            if listener < 0
                rc = 4
            if listener >= 0
                _ic = wm_iniciar_cursor(st, sw, sh)
                _d0 = wm_marcar_dirty(st, 0, 0, sw, sh)
                _sp = lanzar_ejecutar()
                _loop = bucle_wm(st, listener, compos, plen, sw, sh, stride, bpp, fmt)
                _c = fb_set_mode(fb_mode_consola())
                close_fd(listener)
    rc

fn arg_flag(nombre: String) -> Int ! io, alloc
    a = 1
    ok = 0
    while a < argc()
        if str_eq(argv(a), nombre) != 0
            ok = 1
        a = a + 1
    ok

fn arg_valor(flag: String) -> String ! io, alloc
    a = 1
    while a + 1 < argc()
        if str_eq(argv(a), flag) != 0
            argv(a + 1)
        a = a + 1
    d""

fn lanzar_ejecutar() -> Int ! io, alloc
    ix = -1
    a = 1
    while a < argc()
        if str_eq(argv(a), d"--ejecutar") != 0
            ix = a
        a = a + 1
    if ix < 0
        0
    else
        if ix + 1 >= argc()
            0
        else
            path = argv(ix + 1)
            n = 1
            ai = ix + 2
            a1 = d""
            a2 = d""
            a3 = d""
            a4 = d""
            a5 = d""
            while ai < argc()
                if n >= 6
                    ai = argc()
                if n < 6
                    if n == 1
                        a1 = argv(ai)
                    if n == 2
                        a2 = argv(ai)
                    if n == 3
                        a3 = argv(ai)
                    if n == 4
                        a4 = argv(ai)
                    if n == 5
                        a5 = argv(ai)
                    n = n + 1
                    ai = ai + 1
            if n == 1
                spawn_io_full(path, fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
            else
                spawn_io_argv(path, a1, a2, a3, a4, a5, n, fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())

fn prueba_web_modo(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    listener = tcp_listen(puerto_wm())
    ok = 1
    if listener >= 0
        evt = bytes_ptr(bytes_new(24 * 8))
        msg = bytes_ptr(bytes_new(msg_len()))
        st = st_nuevo(evt, msg)
        _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo(st))
        _p = spawn_io_4(d"/var/paquetes/soso-web/bin/soso-web", d"--grafico", d"--local", d"/var/paquetes/soso-web/share/ejemplo/web-prueba.html", fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
        t0 = uptime_ms()
        ok = 0
        while ok == 0
            if uptime_ms() - t0 > 30000
                ok = 2
            if ok == 0
                _t = wm_tick(st, listener, compos, clen, sw, sh, stride, bpp, fmt)
            if ok == 0
                fi = st_get(st, st_focus())
                if fi >= 0
                    tab = st_get(st, st_tab())
                    if tab_get(tab, fi, tab_fase()) == 2
                        if prueba_web_pixel_ok(tab, fi) != 0
                            ok = 1
        close_fd(listener)
        if ok == 1
            _pr = print_str(d"soso-wm: prueba-web OK\n")
            ok = 0
    ok

fn prueba_layout_solapan(tab: Int, z: Int, nz: Int, a: Int, b: Int) -> Int ! alloc
    ia = z_get(z, a)
    ib = z_get(z, b)
    wx = tab_get(tab, ia, tab_wx())
    wy = tab_get(tab, ia, tab_wy())
    ww = tab_get(tab, ia, tab_ww())
    wh = tab_get(tab, ia, tab_wh())
    wx2 = tab_get(tab, ib, tab_wx())
    wy2 = tab_get(tab, ib, tab_wy())
    ww2 = tab_get(tab, ib, tab_ww())
    wh2 = tab_get(tab, ib, tab_wh())
    if wx < wx2 + ww2
        if wx2 < wx + ww
            if wy < wy2 + wh2
                if wy2 < wy + wh
                    1
    0

fn prueba_layout_mosaic(st: Int, sw: Int, sh: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    z = st_get(st, st_z())
    nz = st_get(st, st_nz())
    if nz != 4
        100
    else
        _m = st_set(st, st_mosaic(), 1)
        _a = wm_aplicar_mosaic(st, sw, sh)
        ok = 0
        k = 0
        while k < nz
            if ok == 0
                i = z_get(z, k)
                ww = tab_get(tab, i, tab_ww())
                wh = tab_get(tab, i, tab_wh())
                if ww < ventana_min_ancho()
                    ok = 110 + k
                if wh < ventana_min_alto(wm_gh_wm(st)) + wm_bar_h(st)
                    ok = 120 + k
            k = k + 1
        a = 0
        while a < nz
            if ok == 0
                b = a + 1
                while b < nz
                    if prueba_layout_solapan(tab, z, nz, a, b) != 0
                        ok = 130 + a * 4 + b
                    b = b + 1
            a = a + 1
        if ok == 0
            _m0 = st_set(st, st_mosaic(), 0)
            _r0 = wm_aplicar_mosaic(st, sw, sh)
        ok

fn prueba_layout_drag(st: Int, sw: Int, sh: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc, io
    tab = st_get(st, st_tab())
    fi = st_get(st, st_focus())
    if fi < 0
        200
    else
        wx0 = tab_get(tab, fi, tab_wx())
        wy0 = tab_get(tab, fi, tab_wy())
        gx = 10
        gy = 5
        _di = st_set(st, st_drag_ix(), fi)
        _dk = st_set(st, st_drag_kind(), 1)
        _gx = st_set(st, st_grab_x(), gx)
        _gy = st_set(st, st_grab_y(), gy)
        nx = wx0 + 50
        ny = wy0 + 40
        _mv = wm_raton_mover(st, nx, ny, 1, sw, sh)
        wx1 = tab_get(tab, fi, tab_wx())
        wy1 = tab_get(tab, fi, tab_wy())
        if wx1 != nx - gx
            201
        else
            if wy1 != ny - gy
                202
            else
                _c = wm_compose(st, compos, clen, sw, sh, stride, bpp, fmt)
                if tab_get(tab, fi, tab_wx()) != wx1
                    203
                else
                    0

fn prueba_layout_float(st: Int, sw: Int, sh: Int) -> Int ! alloc
    tab = st_get(st, st_tab())
    i = 0
    _x = tab_set(tab, i, tab_wx(), 0)
    _y = tab_set(tab, i, tab_wy(), 40 + wm_bar_h(st))
    _w = tab_set(tab, i, tab_ww(), 500)
    _h = tab_set(tab, i, tab_wh(), 350 + wm_bar_h(st))
    _fx = tab_set(tab, i, tab_fwx(), 0)
    _fy = tab_set(tab, i, tab_fwy(), 40 + wm_bar_h(st))
    _fw = tab_set(tab, i, tab_fww(), 500)
    _fh = tab_set(tab, i, tab_fwh(), 350 + wm_bar_h(st))
    rc = 0
    if rc == 0
        _m = st_set(st, st_mosaic(), 1)
        _a = wm_aplicar_mosaic(st, sw, sh)
        _m0 = st_set(st, st_mosaic(), 0)
        _a2 = wm_aplicar_mosaic(st, sw, sh)
        ww = tab_get(tab, i, tab_ww())
        fw = tab_get(tab, i, tab_fww())
        if tab_get(tab, i, tab_wx()) != 0
            rc = 300
        if rc == 0
            if fw != 500
                rc = 301
        if rc == 0
            if ww != 500
                rc = 302
    rc

# Pestañas (T1/T2): integrar, reordenar arrastrando, despegar y volver a integrar.
fn prueba_layout_pestanas(st: Int, sw: Int, sh: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    _a = wm_integrar(st, 1, 0)
    _b = wm_integrar(st, 2, 0)
    rc = 0
    if grupo_n(tab, 0) != 3
        rc = 400
    if rc == 0
        wx = tab_get(tab, 0, tab_wx())
        wy = tab_get(tab, 0, tab_wy())
        # Arrastra la 3.ª pestaña hasta el sitio de la 1.ª: queda la primera.
        _ra = wm_pest_arrastrar(st, 2, pest_x0(wx) + 5, wy + wm_bar_h(st) / 2, sh)
        if grupo_pos(tab, 2) != 0
            rc = 401
    if rc == 0
        # Fuera de la barra se despega: ventana propia y arrastre de ventana.
        _rd = wm_pest_arrastrar(st, 2, tab_get(tab, 0, tab_wx()) + 60, tab_get(tab, 0, tab_wy()) + 200, sh)
        if grupo_n(tab, 0) != 2
            rc = 402
        elsif grupo_cab(tab, 2) != 2
            rc = 403
        elsif st_get(st, st_drag_kind()) != 1
            rc = 404
    if rc == 0
        # Soltarla sobre la barra de la ventana que queda la integra otra vez.
        dst = wm_destino_soltar(st, pest_x0(tab_get(tab, 0, tab_wx())) + 20, tab_get(tab, 0, tab_wy()) + 5, 2)
        if dst != 0
            rc = 405
        else
            _ig = wm_integrar(st, 2, dst)
            if grupo_n(tab, 0) != 3
                rc = 406
    if rc == 0
        rc = prueba_layout_lista(st, sw, sh)
    _d = st_set(st, st_drag_ix(), -1)
    _k = st_set(st, st_drag_kind(), 0)
    rc

# Lista de pestañas (T4): con la tira desbordada aparece «▾», y su menú elige pestaña.
fn prueba_layout_lista(st: Int, sw: Int, sh: Int) -> Int ! io, alloc
    tab = st_get(st, st_tab())
    gh = wm_gh_wm(st)
    rc = 0
    _w = tab_set(tab, 0, tab_ww(), 200)
    wx = tab_get(tab, 0, tab_wx())
    wy = tab_get(tab, 0, tab_wy())
    ww = tab_get(tab, 0, tab_ww())
    n = grupo_n(tab, 0)
    if pest_desborda(wx, ww, gh, n) == 0
        rc = 410
    if rc == 0
        if pest_hit(pest_lista_x(wx, ww, gh) + 3, wy + 8, wx, wy, ww, gh, n, wm_pest_act(tab, 0)) != 201
            rc = 411
    if rc == 0
        _ab = wm_lista_abrir(st, 0, sw, sh)
        if st_get(st, st_ctx()) != 0
            rc = 412
        elsif ctx_cuenta(st) != n
            rc = 413
        else
            ia = ctx_item_alto(st)
            it = ctx_item(st, st_get(st, st_ctx_x()) + 4, st_get(st, st_ctx_y()) + ia + ia / 2)
            if it != 1
                rc = 414
            else
                _la = wm_activar_pestana(st, tab, 0, it)
                if grupo_panel_activo(tab, 0) != grupo_miembro(tab, 0, 1)
                    rc = 415
    _cc = wm_ctx_cerrar(st)
    _w2 = tab_set(tab, 0, tab_ww(), 500)
    rc

fn prueba_layout_preparar(st: Int, sw: Int, sh: Int) -> Int ! io, alloc
    _esc = wm_init_escala(st, sw)
    n = 0
    while n < 4
        _t = wm_prueba_anadir_terminal(st, sw, sh)
        n = n + 1
    0

fn prueba_layout_mosaic_only(sw: Int, sh: Int) -> Int ! io, alloc
    evt = bytes_ptr(bytes_new(24 * 8))
    msg = bytes_ptr(bytes_new(msg_len()))
    st = st_nuevo(evt, msg)
    _prep = prueba_layout_preparar(st, sw, sh)
    prueba_layout_mosaic(st, sw, sh)

fn prueba_layout_modo(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    evt = bytes_ptr(bytes_new(24 * 8))
    msg = bytes_ptr(bytes_new(msg_len()))
    st = st_nuevo(evt, msg)
    _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo(st))
    _prep = prueba_layout_preparar(st, sw, sh)
    ok = prueba_layout_mosaic(st, sw, sh)
    if ok == 0
        ok = prueba_layout_drag(st, sw, sh, compos, clen, stride, bpp, fmt)
    if ok == 0
        ok = prueba_layout_float(st, sw, sh)
    if ok == 0
        ok = prueba_layout_pestanas(st, sw, sh)
    if ok == 0
        _pr = print_str(d"soso-wm: prueba-layout OK\n")
        ok = 0
    ok

fn fotograma() -> Int ! io, alloc
    info = fb_info_nuevo()
    r = fb_info(info)
    rc = 0
    if r < 0
        rc = 2
    if r >= 0
        if fb_info_leer(info) == 0
            rc = 3
        if fb_info_leer(info) != 0
            _m = fb_set_mode(fb_mode_graficos())
            sw = fb_info_ancho(info)
            sh = fb_info_alto(info)
            stride = fb_info_stride(info)
            bpp = fb_info_bpp(info)
            fmt = fb_info_formato(info)
            plen = compos_len(stride, sh, bpp)
            compos = bytes_ptr(bytes_new(plen))
            evt = bytes_ptr(bytes_new(24 * 8))
            msg = bytes_ptr(bytes_new(msg_len()))
            st = st_nuevo(evt, msg)
            _bg = wm_pintar_fondo(st, compos, plen, sw, sh, stride, bpp, fmt)
            listener = tcp_listen(puerto_wm())
            if listener < 0
                rc = 4
            if listener >= 0
                _ic = wm_iniciar_cursor(st, sw, sh)
                _d0 = wm_marcar_dirty(st, 0, 0, sw, sh)
                n = 0
                while n < 8
                    _t = wm_tick(st, listener, compos, plen, sw, sh, stride, bpp, fmt)
                    n = n + 1
                _pr = print_str(d"soso-wm: fotograma OK\n")
                rc = 0
                _c = fb_set_mode(fb_mode_consola())
                close_fd(listener)
    rc

fn main() -> Int ! io, alloc
    rc = 0
    if arg_flag(d"--prueba-web") != 0
        info = fb_info_nuevo()
        r = fb_info(info)
        if r < 0
            compos = compos_ram(640, 480, 640, 4)
            rc = prueba_web_modo(compos, compos_len(640, 480, 4), 640, 480, 640, 4, fmt_bgr())
        if r >= 0
            sw = fb_info_ancho(info)
            sh = fb_info_alto(info)
            stride = fb_info_stride(info)
            bpp = fb_info_bpp(info)
            fmt = fb_info_formato(info)
            plen = compos_len(stride, sh, bpp)
            compos = bytes_ptr(bytes_new(plen))
            rc = prueba_web_modo(compos, plen, sw, sh, stride, bpp, fmt)
    if arg_flag(d"--prueba-web") == 0
        if arg_flag(d"--prueba") != 0
            info = fb_info_nuevo()
            r = fb_info(info)
            if r < 0
                compos = compos_ram(640, 480, 640, 4)
                rc = prueba_modo(compos, compos_len(640, 480, 4), 640, 480, 640, 4, fmt_bgr())
            if r >= 0
                sw = fb_info_ancho(info)
                sh = fb_info_alto(info)
                stride = fb_info_stride(info)
                bpp = fb_info_bpp(info)
                fmt = fb_info_formato(info)
                plen = compos_len(stride, sh, bpp)
                compos = bytes_ptr(bytes_new(plen))
                rc = prueba_modo(compos, plen, sw, sh, stride, bpp, fmt)
        if arg_flag(d"--prueba") == 0
            if arg_flag(d"--prueba-layout") != 0
                compos = compos_ram(1280, 800, 1280, 4)
                rc = prueba_layout_modo(compos, compos_len(1280, 800, 4), 1280, 800, 1280, 4, fmt_bgr())
                if rc == 0
                    info = fb_info_nuevo()
                    r = fb_info(info)
                    if r >= 0
                        if fb_info_leer(info) != 0
                            sw = fb_info_ancho(info)
                            sh = fb_info_alto(info)
                            if sw != 1280
                                rc2 = prueba_layout_mosaic_only(sw, sh)
                                if rc2 != 0
                                    rc = rc2
                            if sw == 1280
                                if sh != 800
                                    rc2 = prueba_layout_mosaic_only(sw, sh)
                                    if rc2 != 0
                                        rc = rc2
            if arg_flag(d"--prueba-layout") == 0
                if arg_flag(d"--prueba-mono") != 0
                    compos = compos_ram(640, 480, 640, 4)
                    rc = prueba_mono_modo(compos, compos_len(640, 480, 4), 640, 480, 640, 4, fmt_bgr())
                if arg_flag(d"--prueba-mono") == 0
                    if arg_flag(d"--prueba-lanzar") != 0
                        rc = prueba_lanzar_modo()
                    if arg_flag(d"--prueba-lanzar") == 0
                        if arg_flag(d"--fotograma") != 0
                            rc = fotograma()
                        if arg_flag(d"--fotograma") == 0
                            rc = bucle_grafico(d"")
    rc
