import "soso.sal"
import "superficie.sal"
import "term.sal"
import "ventanas.sal"
import "proto.sal"
import "tabla.sal"
import "wm.sal"
import "mono.sal"

fn puerto_wm() -> Int
    7430

fn compos_len(stride: Int, sh: Int, bpp: Int) -> Int
    stride * sh * bpp

fn compos_ram(sw: Int, sh: Int, stride: Int, bpp: Int) -> Bytes ! alloc
    bytes_new(compos_len(stride, sh, bpp))

fn bucle_wm(st: &mut Estado, listener: Int, compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    while st.salir == 0
        _t = wm_tick(st, listener, compos, clen, sw, sh, stride, bpp, fmt)
    0

fn prueba_pixel_ok(compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int, x: Int, y: Int, r: Int, g: Int, b: Int) -> Int ! alloc
    c = pixel_leer(compos, clen, stride, bpp, fmt, x, y)
    ok = 1
    if u32_b2(c) != u8(r)
        ok = 0
    if u32_b1(c) != u8(g)
        ok = 0
    if u32_b0(c) != u8(b)
        ok = 0
    ok

fn term_busca_cp(grid: Int, glen: Int, w: Int, h: Int, cp: Int) -> Int ! alloc
    row = 0
    found = 0
    while row < h
        col = 0
        while col < w
            if found == 0
                if term_leer_cp(grid, glen, w, col, row) == cp
                    found = 1
            col = col + 1
        row = row + 1
    found

fn prueba_term_echo(st: &mut Estado, i: Int, cp: Int) -> Int ! alloc
    if st.tab.tipo(i) != tab_tipo_term()
        0
    else
        grid = st.tab.shm_ptr(i)
        ww = st.tab.ww(i)
        wh = st.tab.wh(i)
        gw = wm_tab_gw(st, i)
        gh = wm_tab_gh(st, i)
        cols = wm_term_cols(ww, gw)
        rows = wm_term_rows(wh, gh, wm_bar_h(st))
        term_busca_cp(grid, cols * rows * celda_bytes(), cols, rows, cp)

fn prueba_modo(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    listener = tcp_listen(puerto_wm())
    ok = 1
    if listener >= 0
        evt_own = bytes_new(24 * 8)
        msg_own = bytes_new(msg_len())
        evt = bytes_ptr(evt_own)
        msg = bytes_ptr(msg_own)
        st = Estado.new(evt, msg)
        _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo(&mut st))
        _t1 = wm_abrir_terminal(&mut st, sw, sh)
        t0i = st.focus
        if t0i >= 0
            fd0 = st.tab.fd(t0i)
            _w0 = write_str_fd(fd0, d"echo uno\n")
        _t2 = wm_abrir_terminal(&mut st, sw, sh)
        t1i = st.focus
        if t1i >= 0
            fd1 = st.tab.fd(t1i)
            _w1 = write_str_fd(fd1, d"echo dos\n")
        _p = spawn_io_full(d"/bin/demo-cliente", fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
        t0 = uptime_ms()
        ok = 0
        demo = 0
        uno = 0
        dos = 0
        demo_i = -1
        vstage = 0
        while ok == 0
            if uptime_ms() - t0 > 20000
                ok = 2
            if ok == 0
                _t = wm_tick(&mut st, listener, compos, clen, sw, sh, stride, bpp, fmt)
            if ok == 0
                if uno == 0
                    if t0i >= 0
                        if prueba_term_echo(&mut st, t0i, 117) != 0
                            uno = 1
                if dos == 0
                    if t1i >= 0
                        if prueba_term_echo(&mut st, t1i, 100) != 0
                            dos = 1
                if demo == 0
                    fi = st.focus
                    if fi >= 0
                        if st.tab.fase(fi) == 2
                            wx = st.tab.wx(fi)
                            wy = st.tab.wy(fi)
                            if prueba_pixel_ok(compos, clen, stride, bpp, fmt, wx + 10, wy + wm_bar_h(&mut st) + 10, 40, 80, 200) != 0
                                demo = 1
                                demo_i = fi
                # T3 de extremo a extremo con un cliente real (demo-cliente ignora
                # VISIBLE): al tapar su panel con otra pestaña el WM le avisa (vis=2),
                # al destaparlo también (vis=1) y la conexión sigue viva.
                if uno != 0
                    if dos != 0
                        if demo != 0
                            if vstage == 0
                                _ig = wm_integrar(&mut st, t1i, demo_i)
                                _ac = st.tab.grupo_activar(t1i)
                                vstage = 1
                            elsif vstage == 1
                                if st.tab.vis(demo_i) == 2
                                    _ac2 = st.tab.grupo_activar(demo_i)
                                    vstage = 2
                            elsif vstage == 2
                                if st.tab.vis(demo_i) == 1
                                    ok = 1
        close_fd(listener)
        if ok == 2
            _d1 = print_str(d"soso-wm: prueba plazo agotado; faltan:")
            if uno == 0
                _d2 = print_str(d" eco-uno")
            if dos == 0
                _d3 = print_str(d" eco-dos")
            if demo == 0
                _d4 = print_str(d" pixel-demo")
            if demo != 0
                if vstage != 2
                    _d6 = print_str(d" visible-oculto")
                else
                    _d7 = print_str(d" visible-reaparece")
            _d5 = print_str(d"\n")
        if ok == 1
            _pr = print_str(d"soso-wm: prueba OK\n")
            ok = 0
    ok

fn prueba_mono_shm_ok(ptr: Int, slen: Int, cw: Int, ch: Int, fmt: Int, paso: Int) -> Int ! alloc
    mx = mono_paso_x(paso, cw, mono_ancho())
    my = mono_paso_y(paso, ch, mono_alto())
    fotograma = mono_fotograma(paso)
    lx = 15
    ly = 9
    exp = mono_pixel_rgb(lx, ly, fotograma)
    if exp == 0
        0
    else
        got = pixel_leer(ptr, slen, cw, 4, fmt, mx + lx, my + ly)
        if got == exp
            1
        else
            0

fn prueba_mono_shm_cualquier_paso(ptr: Int, slen: Int, cw: Int, ch: Int, fmt: Int) -> Int ! alloc
    paso = 0
    ok = 0
    while paso < 24
        if ok == 0
            if prueba_mono_shm_ok(ptr, slen, cw, ch, fmt, paso) != 0
                ok = 1
        paso = paso + 1
    ok

fn prueba_mono_modo(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    listener = tcp_listen(puerto_wm())
    ok = 7
    if listener < 0
        ok = 7
    if listener >= 0
        evt_own = bytes_new(24 * 8)
        msg_own = bytes_new(msg_len())
        evt = bytes_ptr(evt_own)
        msg = bytes_ptr(msg_own)
        st = Estado.new(evt, msg)
        mono_pid = -1
        _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo(&mut st))
        warm = 0
        while warm < 8
            _w = wm_tick(&mut st, listener, compos, clen, sw, sh, stride, bpp, fmt)
            warm = warm + 1
        _ss = wm_ss_armar(&mut st, compos, clen, sw, sh, stride, bpp, fmt)
        if _ss == 0
            ok = 4
        if _ss != 0
            mono_pid = spawn_io_argv(d"/bin/soso-mono", d"--once", d"", d"", d"", d"", 2, fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
            if mono_pid < 0
                ok = 4
            if mono_pid >= 0
                st.ss_pid = mono_pid
                t0 = uptime_ms()
                pintado = 0
                fase2 = 0
                ok = 0
                while ok == 0
                    if uptime_ms() - t0 > 25000
                        if fase2 != 0
                            ok = 6
                        else
                            ok = 5
                    if ok == 0
                        _t = wm_tick(&mut st, listener, compos, clen, sw, sh, stride, bpp, fmt)
                    if ok == 0
                        si = st.ss_slot
                        if si >= 0
                            if st.tab.fase(si) == 2
                                fase2 = 1
                                ptr = st.tab.shm_ptr(si)
                                if ptr > 0
                                    cw = st.tab.cw(si)
                                    ch = st.tab.ch(si)
                                    slen = cw * ch * 4
                                    if prueba_mono_shm_cualquier_paso(ptr, slen, cw, ch, fmt) != 0
                                        pintado = 1
                        if pintado != 0
                            ok = 1
            if mono_pid > 0
                _k = kill_pid(mono_pid, 9)
        _x = wm_ss_cerrar(&mut st)
        close_fd(listener)
        if ok == 1
            _pr = print_str(d"soso-wm: prueba-mono OK\n")
            ok = 0
    ok

fn prueba_lanzar_uno() -> Int ! io, alloc
    pid = spawn_io_full(d"/bin/demo-cliente", fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
    if pid > 0
        _k = kill_pid(pid, 9)
    pid

fn prueba_lanzar_modo() -> Int ! io, alloc
    ok = 0
    i = 0
    while i < 3
        if prueba_lanzar_uno() < 0
            ok = 1
        i = i + 1
    if ok == 0
        _pr = print_str(d"soso-wm: prueba-lanzar OK\n")
    ok

fn bucle_grafico(ejecutar: String) -> Int ! io, alloc
    info = fb_info_nuevo()
    r = fb_info(info)
    rc = 0
    if r < 0
        rc = 2
    if r >= 0
        if fb_info_leer(info) == 0
            rc = 3
        if fb_info_leer(info) != 0
            _m = fb_set_mode(fb_mode_graficos())
            sw = fb_info_ancho(info)
            sh = fb_info_alto(info)
            stride = fb_info_stride(info)
            bpp = fb_info_bpp(info)
            fmt = fb_info_formato(info)
            plen = compos_len(stride, sh, bpp)
            evt_own = bytes_new(24 * 8)
            msg_own = bytes_new(msg_len())
            evt = bytes_ptr(evt_own)
            msg = bytes_ptr(msg_own)
            st = Estado.new(evt, msg)
            sin_comp = arg_flag(d"--sin-comp")
            compos = wm_comp_ensure(&mut st, sw, sh, stride, sin_comp)
            if compos < 0
                compos_own = bytes_new(plen)
                compos = bytes_ptr(compos_own)
            _bg = rellenar_rect(compos, plen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo(&mut st))
            listener = tcp_listen(puerto_wm())
            if listener < 0
                rc = 4
            if listener >= 0
                _ic = wm_iniciar_cursor(&mut st, sw, sh)
                _d0 = wm_marcar_dirty(&mut st, 0, 0, sw, sh)
                _sp = lanzar_ejecutar()
                _loop = bucle_wm(&mut st, listener, compos, plen, sw, sh, stride, bpp, fmt)
                _c = fb_set_mode(fb_mode_consola())
                close_fd(listener)
    rc

fn arg_flag(nombre: String) -> Int ! io, alloc
    a = 1
    ok = 0
    while a < argc()
        if str_eq(argv(a), nombre) != 0
            ok = 1
        a = a + 1
    ok

fn arg_valor(flag: String) -> String ! io, alloc
    a = 1
    while a + 1 < argc()
        if str_eq(argv(a), flag) != 0
            argv(a + 1)
        a = a + 1
    d""

fn lanzar_ejecutar() -> Int ! io, alloc
    ix = -1
    a = 1
    while a < argc()
        if str_eq(argv(a), d"--ejecutar") != 0
            ix = a
        a = a + 1
    if ix < 0
        0
    else
        if ix + 1 >= argc()
            0
        else
            path = argv(ix + 1)
            n = 1
            ai = ix + 2
            a1 = d""
            a2 = d""
            a3 = d""
            a4 = d""
            a5 = d""
            while ai < argc()
                if n >= 6
                    ai = argc()
                if n < 6
                    if n == 1
                        a1 = argv(ai)
                    if n == 2
                        a2 = argv(ai)
                    if n == 3
                        a3 = argv(ai)
                    if n == 4
                        a4 = argv(ai)
                    if n == 5
                        a5 = argv(ai)
                    n = n + 1
                    ai = ai + 1
            if n == 1
                spawn_io_full(path, fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
            else
                spawn_io_argv(path, a1, a2, a3, a4, a5, n, fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())

fn prueba_web_modo(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    listener = tcp_listen(puerto_wm())
    ok = 1
    if listener >= 0
        evt_own = bytes_new(24 * 8)
        msg_own = bytes_new(msg_len())
        evt = bytes_ptr(evt_own)
        msg = bytes_ptr(msg_own)
        st = Estado.new(evt, msg)
        _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo(&mut st))
        _p = spawn_io_4(d"/var/paquetes/soso-web/bin/soso-web", d"--grafico", d"--local", d"/var/paquetes/soso-web/share/ejemplo/web-prueba.html", fd_tty_heredado(), fd_tty_heredado(), fd_tty_heredado(), fd_kernel_log())
        t0 = uptime_ms()
        ok = 0
        while ok == 0
            if uptime_ms() - t0 > 30000
                ok = 2
            if ok == 0
                _t = wm_tick(&mut st, listener, compos, clen, sw, sh, stride, bpp, fmt)
            if ok == 0
                fi = st.focus
                if fi >= 0
                    if st.tab.fase(fi) == 2
                        if prueba_web_pixel_ok(&mut st, fi) != 0
                            ok = 1
        close_fd(listener)
        if ok == 1
            _pr = print_str(d"soso-wm: prueba-web OK\n")
            ok = 0
    ok

fn prueba_layout_solapan(st: &mut Estado, a: Int, b: Int) -> Int ! alloc
    ia = st.tab.z_get(a)
    ib = st.tab.z_get(b)
    wx = st.tab.wx(ia)
    wy = st.tab.wy(ia)
    ww = st.tab.ww(ia)
    wh = st.tab.wh(ia)
    wx2 = st.tab.wx(ib)
    wy2 = st.tab.wy(ib)
    ww2 = st.tab.ww(ib)
    wh2 = st.tab.wh(ib)
    if wx < wx2 + ww2
        if wx2 < wx + ww
            if wy < wy2 + wh2
                if wy2 < wy + wh
                    1
    0

fn prueba_layout_mosaic(st: &mut Estado, sw: Int, sh: Int) -> Int ! alloc
    nz = st.tab.nz()
    if nz != 4
        100
    else
        st.mosaic = 1
        _a = wm_aplicar_mosaic(st, sw, sh)
        ok = 0
        k = 0
        while k < nz
            if ok == 0
                i = st.tab.z_get(k)
                ww = st.tab.ww(i)
                wh = st.tab.wh(i)
                if ww < ventana_min_ancho()
                    ok = 110 + k
                if wh < ventana_min_alto(wm_gh_wm(st)) + wm_bar_h(st)
                    ok = 120 + k
            k = k + 1
        a = 0
        while a < nz
            if ok == 0
                b = a + 1
                while b < nz
                    if prueba_layout_solapan(st, a, b) != 0
                        ok = 130 + a * 4 + b
                    b = b + 1
            a = a + 1
        if ok == 0
            st.mosaic = 0
            _r0 = wm_aplicar_mosaic(st, sw, sh)
        ok

fn prueba_layout_drag(st: &mut Estado, sw: Int, sh: Int, compos: Int, clen: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! alloc, io
    fi = st.focus
    if fi < 0
        200
    else
        wx0 = st.tab.wx(fi)
        wy0 = st.tab.wy(fi)
        gx = 10
        gy = 5
        st.drag_ix = fi
        st.drag_kind = 1
        st.grab_x = gx
        st.grab_y = gy
        nx = wx0 + 50
        ny = wy0 + 40
        _mv = wm_raton_mover(st, nx, ny, 1, sw, sh)
        wx1 = st.tab.wx(fi)
        wy1 = st.tab.wy(fi)
        if wx1 != nx - gx
            201
        else
            if wy1 != ny - gy
                202
            else
                _c = wm_compose(st, compos, clen, sw, sh, stride, bpp, fmt)
                if st.tab.wx(fi) != wx1
                    203
                else
                    0

fn prueba_layout_float(st: &mut Estado, sw: Int, sh: Int) -> Int ! alloc
    i = 0
    st.tab.set_wx(i, 0)
    st.tab.set_wy(i, 40 + wm_bar_h(st))
    st.tab.set_ww(i, 500)
    st.tab.set_wh(i, 350 + wm_bar_h(st))
    st.tab.set_fwx(i, 0)
    st.tab.set_fwy(i, 40 + wm_bar_h(st))
    st.tab.set_fww(i, 500)
    st.tab.set_fwh(i, 350 + wm_bar_h(st))
    rc = 0
    if rc == 0
        st.mosaic = 1
        _a = wm_aplicar_mosaic(st, sw, sh)
        st.mosaic = 0
        _a2 = wm_aplicar_mosaic(st, sw, sh)
        ww = st.tab.ww(i)
        fw = st.tab.fww(i)
        if st.tab.wx(i) != 0
            rc = 300
        if rc == 0
            if fw != 500
                rc = 301
        if rc == 0
            if ww != 500
                rc = 302
    rc

# Pestañas (T1/T2): integrar, reordenar arrastrando, despegar y volver a integrar.
fn prueba_layout_pestanas(st: &mut Estado, sw: Int, sh: Int) -> Int ! io, alloc
    _a = wm_integrar(st, 1, 0)
    _b = wm_integrar(st, 2, 0)
    rc = 0
    if st.tab.grupo_n(0) != 3
        rc = 400
    if rc == 0
        wx = st.tab.wx(0)
        wy = st.tab.wy(0)
        # Arrastra la 3.ª pestaña hasta el sitio de la 1.ª: queda la primera.
        _ra = wm_pest_arrastrar(st, 2, pest_x0(wx) + 5, wy + wm_bar_h(st) / 2, sh)
        if st.tab.grupo_pos(2) != 0
            rc = 401
    if rc == 0
        # Fuera de la barra se despega: ventana propia y arrastre de ventana.
        _rd = wm_pest_arrastrar(st, 2, st.tab.wx(0) + 60, st.tab.wy(0) + 200, sh)
        if st.tab.grupo_n(0) != 2
            rc = 402
        elsif st.tab.grupo_cab(2) != 2
            rc = 403
        elsif st.drag_kind != 1
            rc = 404
    if rc == 0
        # Soltarla sobre la barra de la ventana que queda la integra otra vez.
        dst = wm_destino_soltar(st, pest_x0(st.tab.wx(0)) + 20, st.tab.wy(0) + 5, 2)
        if dst != 0
            rc = 405
        else
            _ig = wm_integrar(st, 2, dst)
            if st.tab.grupo_n(0) != 3
                rc = 406
    if rc == 0
        rc = prueba_layout_lista(st, sw, sh)
    st.drag_ix = -1
    st.drag_kind = 0
    rc

# Lista de pestañas (T4): con la tira desbordada aparece «▾», y su menú elige pestaña.
fn prueba_layout_lista(st: &mut Estado, sw: Int, sh: Int) -> Int ! io, alloc
    gh = wm_gh_wm(st)
    rc = 0
    st.tab.set_ww(0, 200)
    wx = st.tab.wx(0)
    wy = st.tab.wy(0)
    ww = st.tab.ww(0)
    n = st.tab.grupo_n(0)
    if pest_desborda(wx, ww, gh, n) == 0
        rc = 410
    if rc == 0
        if pest_hit(pest_lista_x(wx, ww, gh) + 3, wy + 8, wx, wy, ww, gh, n, wm_pest_act(st, 0)) != 201
            rc = 411
    if rc == 0
        _ab = wm_lista_abrir(st, 0, sw, sh)
        if st.ctx != 0
            rc = 412
        elsif ctx_cuenta(st) != n
            rc = 413
        else
            ia = ctx_item_alto(st)
            it = ctx_item(st, st.ctx_x + 4, st.ctx_y + ia + ia / 2)
            if it != 1
                rc = 414
            else
                _la = wm_activar_pestana(st, 0, it)
                if st.tab.grupo_panel_activo(0) != st.tab.grupo_miembro(0, 1)
                    rc = 415
    _cc = wm_ctx_cerrar(st)
    st.tab.set_ww(0, 500)
    rc

fn prueba_layout_preparar(st: &mut Estado, sw: Int, sh: Int) -> Int ! io, alloc
    _esc = wm_init_escala(st, sw)
    n = 0
    while n < 4
        _t = wm_prueba_anadir_terminal(st, sw, sh)
        n = n + 1
    0

fn prueba_layout_mosaic_only(sw: Int, sh: Int) -> Int ! io, alloc
    evt_own = bytes_new(24 * 8)
    msg_own = bytes_new(msg_len())
    evt = bytes_ptr(evt_own)
    msg = bytes_ptr(msg_own)
    st = Estado.new(evt, msg)
    _prep = prueba_layout_preparar(&mut st, sw, sh)
    prueba_layout_mosaic(&mut st, sw, sh)

fn prueba_layout_modo(compos: Int, clen: Int, sw: Int, sh: Int, stride: Int, bpp: Int, fmt: Int) -> Int ! io, alloc
    evt_own = bytes_new(24 * 8)
    msg_own = bytes_new(msg_len())
    evt = bytes_ptr(evt_own)
    msg = bytes_ptr(msg_own)
    st = Estado.new(evt, msg)
    _r = rellenar_rect(compos, clen, sw, sh, stride, bpp, fmt, 0, 0, sw, sh, wm_color_fondo(&mut st))
    _prep = prueba_layout_preparar(&mut st, sw, sh)
    ok = prueba_layout_mosaic(&mut st, sw, sh)
    if ok == 0
        ok = prueba_layout_drag(&mut st, sw, sh, compos, clen, stride, bpp, fmt)
    if ok == 0
        ok = prueba_layout_float(&mut st, sw, sh)
    if ok == 0
        ok = prueba_layout_pestanas(&mut st, sw, sh)
    if ok == 0
        _pr = print_str(d"soso-wm: prueba-layout OK\n")
        ok = 0
    ok

fn fotograma() -> Int ! io, alloc
    info = fb_info_nuevo()
    r = fb_info(info)
    rc = 0
    if r < 0
        rc = 2
    if r >= 0
        if fb_info_leer(info) == 0
            rc = 3
        if fb_info_leer(info) != 0
            _m = fb_set_mode(fb_mode_graficos())
            sw = fb_info_ancho(info)
            sh = fb_info_alto(info)
            stride = fb_info_stride(info)
            bpp = fb_info_bpp(info)
            fmt = fb_info_formato(info)
            plen = compos_len(stride, sh, bpp)
            compos_own = bytes_new(plen)
            compos = bytes_ptr(compos_own)
            evt_own = bytes_new(24 * 8)
            msg_own = bytes_new(msg_len())
            evt = bytes_ptr(evt_own)
            msg = bytes_ptr(msg_own)
            st = Estado.new(evt, msg)
            _bg = wm_pintar_fondo(&mut st, compos, plen, sw, sh, stride, bpp, fmt)
            listener = tcp_listen(puerto_wm())
            if listener < 0
                rc = 4
            if listener >= 0
                _ic = wm_iniciar_cursor(&mut st, sw, sh)
                _d0 = wm_marcar_dirty(&mut st, 0, 0, sw, sh)
                n = 0
                while n < 8
                    _t = wm_tick(&mut st, listener, compos, plen, sw, sh, stride, bpp, fmt)
                    n = n + 1
                _pr = print_str(d"soso-wm: fotograma OK\n")
                rc = 0
                _c = fb_set_mode(fb_mode_consola())
                close_fd(listener)
    rc

fn main() -> Int ! io, alloc
    rc = 0
    if arg_flag(d"--prueba-web") != 0
        info = fb_info_nuevo()
        r = fb_info(info)
        if r < 0
            compos_own = compos_ram(640, 480, 640, 4)
            compos = bytes_ptr(compos_own)
            rc = prueba_web_modo(compos, compos_len(640, 480, 4), 640, 480, 640, 4, fmt_bgr())
        if r >= 0
            sw = fb_info_ancho(info)
            sh = fb_info_alto(info)
            stride = fb_info_stride(info)
            bpp = fb_info_bpp(info)
            fmt = fb_info_formato(info)
            plen = compos_len(stride, sh, bpp)
            compos_own = bytes_new(plen)
            compos = bytes_ptr(compos_own)
            rc = prueba_web_modo(compos, plen, sw, sh, stride, bpp, fmt)
    if arg_flag(d"--prueba-web") == 0
        if arg_flag(d"--prueba") != 0
            info = fb_info_nuevo()
            r = fb_info(info)
            if r < 0
                compos_own = compos_ram(640, 480, 640, 4)
                compos = bytes_ptr(compos_own)
                rc = prueba_modo(compos, compos_len(640, 480, 4), 640, 480, 640, 4, fmt_bgr())
            if r >= 0
                sw = fb_info_ancho(info)
                sh = fb_info_alto(info)
                stride = fb_info_stride(info)
                bpp = fb_info_bpp(info)
                fmt = fb_info_formato(info)
                plen = compos_len(stride, sh, bpp)
                compos_own = bytes_new(plen)
                compos = bytes_ptr(compos_own)
                rc = prueba_modo(compos, plen, sw, sh, stride, bpp, fmt)
        if arg_flag(d"--prueba") == 0
            if arg_flag(d"--prueba-layout") != 0
                compos_own = compos_ram(1280, 800, 1280, 4)
                compos = bytes_ptr(compos_own)
                rc = prueba_layout_modo(compos, compos_len(1280, 800, 4), 1280, 800, 1280, 4, fmt_bgr())
                if rc == 0
                    info = fb_info_nuevo()
                    r = fb_info(info)
                    if r >= 0
                        if fb_info_leer(info) != 0
                            sw = fb_info_ancho(info)
                            sh = fb_info_alto(info)
                            if sw != 1280
                                rc2 = prueba_layout_mosaic_only(sw, sh)
                                if rc2 != 0
                                    rc = rc2
                            if sw == 1280
                                if sh != 800
                                    rc2 = prueba_layout_mosaic_only(sw, sh)
                                    if rc2 != 0
                                        rc = rc2
            if arg_flag(d"--prueba-layout") == 0
                if arg_flag(d"--prueba-mono") != 0
                    compos_own = compos_ram(640, 480, 640, 4)
                    compos = bytes_ptr(compos_own)
                    rc = prueba_mono_modo(compos, compos_len(640, 480, 4), 640, 480, 640, 4, fmt_bgr())
                if arg_flag(d"--prueba-mono") == 0
                    if arg_flag(d"--prueba-lanzar") != 0
                        rc = prueba_lanzar_modo()
                    if arg_flag(d"--prueba-lanzar") == 0
                        if arg_flag(d"--fotograma") != 0
                            rc = fotograma()
                        if arg_flag(d"--fotograma") == 0
                            rc = bucle_grafico(d"")
    rc
