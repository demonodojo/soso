import "soso.sal"
import "proto.sal"
import "superficie.sal"
import "mono.sal"

fn mono_cliente_crear(sock: Int, w: Int, h: Int) -> Int ! io, alloc
    m = msg_nuevo()
    _h = msg_encode_hola(m, 1)
    _w1 = write_fd(sock, m, msg_len())
    m2 = msg_nuevo()
    _t = msg_titulo_copiar(m2, 16, d"Mono")
    _c = msg_encode_crear(m2, w, h, 16)
    _w2 = write_fd(sock, m2, msg_len())
    rep = msg_nuevo()
    n = read_fd(sock, rep, msg_len())
    if n != msg_len()
        1
    else
        if msg_get_op(rep) != op_ventana()
            2
        else
            sid = msg_get_u32(rep, 8)
            cw = msg_get_u32(rep, 12)
            ch = msg_get_u32(rep, 16)
            ptr = shm_map(sid)
            if ptr < 0
                3
            else
                slen = cw * ch * 4
                fmt = msg_get_u32(rep, 20)
                paso = 0
                while paso >= 0
                    mx = mono_paso_x(paso, cw, mono_ancho())
                    my = mono_paso_y(paso, ch, mono_alto())
                    fotograma = mono_fotograma(paso)
                    if mono_golpe_activo(paso) != 0
                        gx0 = mono_golpe_x0(mx, my, fotograma)
                        gy0 = mono_golpe_y0(my, fotograma)
                        gx1 = gx0 + mono_golpe_w()
                        gy1 = gy0 + mono_golpe_h()
                        _r = mono_romper_rect(ptr, slen, cw, 4, fmt, cw, ch, gx0, gy0, gx1, gy1, paso + 99)
                    _d = mono_dibujar(ptr, slen, cw, 4, fmt, cw, ch, mx, my, fotograma)
                    dx0 = mono_danio_x0(mx, my, paso, cw, ch)
                    dy0 = mono_danio_y0(mx, my, paso, cw, ch)
                    dx1 = mono_danio_x1(mx, my, paso, cw, ch)
                    dy1 = mono_danio_y1(mx, my, paso, cw, ch)
                    md = msg_nuevo()
                    _dm = msg_encode_danio(md, dx0, dy0, dx1 - dx0, dy1 - dy0)
                    wn = write_fd(sock, md, msg_len())
                    if wn <= 0
                        paso = -1
                    rn = read_timeout_fd(sock, rep, msg_len(), 1)
                    if rn > 0
                        if msg_get_op(rep) == op_cerrar_wm()
                            paso = -1
                    if paso >= 0
                        _s = sleep_ms(mono_frame_ms())
                        paso = paso + 1
                _x = close_fd(sock)
                0

fn main() -> Int ! io, alloc
    sock = -1
    intento = 0
    while intento < 40
        if sock < 0
            sock = tcp_connect(7430, 500)
        if sock >= 0
            intento = 40
        if sock < 0
            intento = intento + 1
            _s = sleep_ms(50)
    if sock < 0
        1
    else
        mono_cliente_crear(sock, 640, 480)
