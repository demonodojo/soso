+/// Todos los valores de la cabecera `key` (sin distinguir mayúsculas), en el orden en que aparecen.
+pub fn header_values<'a>(headers: &'a [(String, String)], key: &str) -> Vec<&'a str> {
+    headers
+        .iter()
+        .filter(|(k, _)| k.eq_ignore_ascii_case(key))
+        .map(|(_, v)| v.as_str())
+        .collect()
