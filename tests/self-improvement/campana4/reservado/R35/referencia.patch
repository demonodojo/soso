+/// Longitud máxima de una cadena GGUF (nombres, tokens, plantillas).
+const MAX_CADENA: u64 = 16 << 20;
+/// Máximo de dimensiones de un tensor (ggml usa 4; se deja margen).
+const MAX_DIMS: usize = 8;
+
 fn read_string<R: Read + Seek>(file: &mut R) -> Result<String, String> {
-    let len = read_u64(file)? as usize;
-    let mut buf = vec![0u8; len];
-    file.read_exact(&mut buf)?;
+    let len = read_u64(file)?;
+    if len > MAX_CADENA {
+        return Err(format!("cadena de {len} bytes demasiado larga (máximo {MAX_CADENA})"));
+    }
+    // Se lee por trozos: la memoria reservada nunca pasa de lo que el fichero trae.
+    let len = len as usize;
+    let mut buf = Vec::new();
+    while buf.len() < len {
+        let n = (len - buf.len()).min(1 << 16);
+        let ini = buf.len();
+        buf.resize(ini + n, 0);
+        file.read_exact(&mut buf[ini..])?;
+    }
     String::from_utf8(buf).map_err(|e| e.to_string())
 }
 
