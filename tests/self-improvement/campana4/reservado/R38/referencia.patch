+/// Descomprime un miembro gzip (RFC 1952): cabecera, deflate crudo y cola.
+fn gunzip(body: &[u8]) -> Result<Vec<u8>, ()> {
+    if body.len() < 18 || body[0] != 0x1f || body[1] != 0x8b || body[2] != 8 {
+        return Err(());
+    }
+    let flags = body[3];
+    let mut pos = 10;
+    if flags & 0x04 != 0 {
+        let xlen = u16::from_le_bytes([*body.get(pos).ok_or(())?, *body.get(pos + 1).ok_or(())?]);
+        pos += 2 + xlen as usize;
+    }
+    for bit in [0x08, 0x10] {
+        if flags & bit != 0 {
+            let nul = body.get(pos..).ok_or(())?.iter().position(|&b| b == 0).ok_or(())?;
+            pos += nul + 1;
+        }
+    }
+    if flags & 0x02 != 0 {
+        pos += 2;
+    }
+    if pos + 8 > body.len() {
+        return Err(());
+    }
+    let (data, tail) = body[pos..].split_at(body.len() - pos - 8);
+    let out = decompress_to_vec(data).map_err(|_| ())?;
+    let isize = u32::from_le_bytes([tail[4], tail[5], tail[6], tail[7]]);
+    if isize != out.len() as u32 {
+        return Err(());
+    }
+    Ok(out)
+}
