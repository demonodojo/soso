+/// Elimina los segmentos `.` y `..` de una ruta (RFC 3986 §5.2.4).
+///
+/// Dejarlos pasa el problema al servidor: `https://x/a/../c` y `https://x/c`
+/// son la misma página, pero como cadenas no coinciden, así que el enlace se
+/// pide dos veces y la caché no acierta ninguna. Los `..` que sobran se
+/// descartan: la ruta no sube por encima de la raíz.
+fn quitar_segmentos_punto(ruta: &str) -> String {
+    let mut pila: Vec<&str> = Vec::new();
+    for seg in ruta.split('/') {
+        match seg {
+            "" | "." => continue,
+            ".." => {
+                pila.pop();
+            }
+            otro => pila.push(otro),
         }
-        return href.to_string();
