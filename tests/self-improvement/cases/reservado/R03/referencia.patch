+/// Valor de una cabecera por nombre, **sin distinguir mayúsculas** (RFC 9110
+/// §5.1). El parser de respuestas guarda los nombres en minúscula, pero quien
+/// llama escribe `Content-Length` como en la especificación; comparar exacto
+/// hacía que esa consulta no encontrara nada.
 pub fn header_value<'a>(headers: &'a [(String, String)], key: &str) -> Option<&'a str> {
     headers
         .iter()
-        .find(|(k, _)| k == key)
+        .find(|(k, _)| k.eq_ignore_ascii_case(key))
         .map(|(_, v)| v.as_str())
 }
 
