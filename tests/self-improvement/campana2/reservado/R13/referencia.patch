+    /// ¿Cae `lba` dentro? Ambos extremos cuentan; una geometría vacía no contiene nada.
+    pub fn contains(&self, lba: u64) -> bool {
+        self.sectors > 0 && lba >= self.first && lba <= self.last
+    }
+
+    /// ¿Comparten algún sector? Rangos cerrados; lo vacío no se solapa con nada.
+    pub fn overlaps(&self, other: &PartGeom) -> bool {
+        self.sectors > 0 && other.sectors > 0 && self.first <= other.last && other.first <= self.last
+    }
