+/// La mayor de una lista según [`cmp`]; en un empate, la primera.
+pub fn max(versions: &[SemVer]) -> Option<&SemVer> {
+    let mut mejor: Option<&SemVer> = None;
+    for v in versions {
+        if mejor.map_or(true, |m| cmp(v, m) == Ordering::Greater) {
+            mejor = Some(v);
+        }
+    }
+    mejor
