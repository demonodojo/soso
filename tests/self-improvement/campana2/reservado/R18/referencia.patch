+pub const KDE_DATA_TYPE_PMKID: u8 = 4;
+
+/// Busca el KDE del PMKID (16 bytes). Un payload más corto se ignora; uno más largo se corta a 16.
+pub fn find_pmkid(key_data: &[u8]) -> Option<[u8; 16]> {
+    let mut found = None;
+    for_each_rsn_kde(key_data, |data_type, payload| {
+        if data_type != KDE_DATA_TYPE_PMKID || found.is_some() || payload.len() < 16 {
+            return;
+        }
+        let mut k = [0u8; 16];
+        k.copy_from_slice(&payload[..16]);
+        found = Some(k);
+    });
+    found
+}
