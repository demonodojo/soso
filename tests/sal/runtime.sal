fn main() -> Int ! io, alloc
    v = vec_new()
    _v = vec_push(v, 42)
    texto = "hola " + "ñ" + "\n"
    escrito = write_file(d"/tmp/sal-texto", texto)
    otro = read_file(d"/tmp/sal-texto")
    elemento = vec_get(v, 0)
    _p = print_str(texto)
    _f = vec_free(v)
    if argc() != 2
        2
