import "../../../user/sal/escritorio/tabla.sal"

fn nuevo(tab: &mut Tabla, i: Int, x: Int) -> Int ! alloc
    _t = tab.set_tipo(i, tab_tipo_term())
    _x = tab.set_wx(i, x)
    _w = tab.set_ww(i, 300 + x)
    0

fn main() -> Int ! alloc
    tab = Tabla.new()
    _a = nuevo(&mut tab, 0, 10)
    _b = nuevo(&mut tab, 1, 20)
    _c = nuevo(&mut tab, 2, 30)
    if tab.grupo_cab(1) != 1
        1
    elsif tab.wx(1) != 20
        2
    else
        # integrar 1 y 2 en el grupo de 0: la geometría pasa a ser la de 0
        _i = tab.grupo_integrar(1, 0)
        _j = tab.grupo_integrar(2, 0)
        if tab.grupo_n(0) != 3
            3
        elsif tab.wx(2) != 10
            4
        else
            _m = tab.set_wx(1, 77)
            if tab.wx(0) != 77
                5
            elsif tab.cw(1) != 0
                6
            else
                _v = tab.grupo_activar(2)
                if tab.grupo_panel_activo(0) != 2
                    7
                else
                    # separar el panel 1: ventana propia con la geometría del grupo
                    _s = tab.grupo_separar(1)
                    if tab.grupo_cab(1) != 1
                        8
                    elsif tab.wx(1) != 77
                        9
                    elsif tab.grupo_n(0) != 2
                        10
                    elsif tab.grupo_panel_activo(0) != 2
                        11
                    else
                        # separar la cabecera: el grupo sigue con otra cabecera y su geometría
                        _t = tab.grupo_separar(0)
                        if tab.grupo_cab(2) != 2
                            12
                        elsif tab.wx(2) != 77
                            13
                        elsif tab.grupo_cab(0) != 0
                            14
                        else
                            ord_ok(&mut tab)

# Orden de pestañas: 0 (cabecera) y luego 2 y 1 por integración; reintegrar 1 lo deja al final.
fn ord_ok(tab: &mut Tabla) -> Int ! alloc
    _a = tab.set_tipo(1, tab_tipo_term())
    _c = tab.grupo_integrar(2, 0)
    _b = tab.grupo_integrar(1, 0)
    if tab.grupo_n(0) != 3
        20
    elsif tab.grupo_miembro(0, 0) != 0
        21
    elsif tab.grupo_miembro(0, 1) != 2
        22
    elsif tab.grupo_miembro(0, 2) != 1
        23
    elsif tab.grupo_pos(1) != 2
        24
    else
        0
