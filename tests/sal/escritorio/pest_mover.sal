import "../../../user/sal/escritorio/tabla.sal"

fn nuevo(tab: &mut Tabla, i: Int) -> Int ! alloc
    _t = tab.set_tipo(i, tab_tipo_term())
    0

fn main() -> Int ! alloc
    tab = Tabla.new()
    _a = nuevo(&mut tab, 0)
    _b = nuevo(&mut tab, 1)
    _c = nuevo(&mut tab, 2)
    _d = nuevo(&mut tab, 3)
    _i1 = tab.grupo_integrar(1, 0)
    _i2 = tab.grupo_integrar(2, 0)
    _i3 = tab.grupo_integrar(3, 0)
    # orden inicial 0 1 2 3
    if tab.grupo_miembro(0, 3) != 3
        1
    else
        _m = tab.grupo_mover(3, 0)
        # 3 0 1 2
        if tab.grupo_miembro(0, 0) != 3
            2
        elsif tab.grupo_miembro(0, 1) != 0
            3
        elsif tab.grupo_miembro(0, 3) != 2
            4
        else
            _m2 = tab.grupo_mover(3, 2)
            # 0 1 3 2
            if tab.grupo_miembro(0, 2) != 3
                5
            elsif tab.grupo_miembro(0, 0) != 0
                6
            elsif tab.grupo_miembro(0, 3) != 2
                7
            elsif tab.grupo_mover(3, 2) != 0
                8
            else
                _m3 = tab.grupo_mover(0, 99)
                # 1 3 2 0
                if tab.grupo_miembro(0, 3) != 0
                    9
                elsif tab.grupo_miembro(0, 0) != 1
                    10
                else
                    0
