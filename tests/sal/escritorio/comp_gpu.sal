import "../../../user/sal/escritorio/comp_gfram_layout.sal"
import "../../../user/sal/escritorio/comp_gscen_layout.sal"

fn rgba_prueba() -> Int
    305419896

fn main() -> Int ! alloc
    if comp_gfram_len() != 61
        1
    else
        if comp_st_size() != 182
            2
        else
            st = bytes_ptr(bytes_new(comp_st_size()))
            rgba = rgba_prueba()
            _p = comp_gpu_patch_gfram(st, 7, 9, 640, 480, 2560, rgba)
            cmd = st + comp_st_cmd_gfram()
            b = bytes_view_mem(cmd, comp_gfram_len())
            if bytes_get_u8(b, 0) != 71
                3
            else
                if bytes_get_i64(b, 5) != 7
                    4
                else
                    if bytes_get_u32(b, 29) != 640
                        5
                    else
                        if bytes_get_u32(b, 57) != rgba
                            6
                        else
                            if comp_st_cmd_guprc() != 109
                                7
                            else
                                0
