import "../../../user/sal/escritorio/comp_scanout_policy.sal"

fn main() -> Int
    if comp_scanout_auto_nvdisp(1, 1) != 1
        1
    else
        if comp_scanout_auto_gop(1, 1) != 0
            2
        else
            if comp_scanout_auto_gop(0, 1) != 1
                3
            else
                if comp_scanout_auto_nvdisp(0, 0) != 0
                    4
                else
                    if comp_scanout_use_nvdisp(1, 1) != 1
                        9
                    else
                        if comp_scanout_use_gop(1, 1) != 0
                            10
                        else
                            if comp_scanout_rt_nvdisp(1) != 1
                                11
                            else
                                if comp_scanout_rt_nvdisp(2) != 0
                                    12
                                else
                                    if comp_scanout_effective(1, 1, 1) != 2
                                        13
                                    else
                                        if comp_scanout_rt_nvdisp(comp_scanout_effective(1, 1, 1)) != 0
                                            15
                                        else
                                            if comp_scanout_fb_w(1920, 1) != 640
                                                5
                                            else
                                                if comp_scanout_fb_h(1080, 1) != 480
                                                    6
                                                else
                                                    if comp_scanout_fb_pitch(1920, 7680, 1) != 2560
                                                        7
                                                    else
                                                        if comp_scanout_fb_w(640, 1) != 640
                                                            8
                                                        else
                                                            0
