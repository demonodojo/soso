import "../../../user/sal/escritorio/utf8.sal"

fn main() -> Int ! alloc
    st = utf8_inicio()
    st = utf8_feed(st, 195)
    cp = utf8_feed(st, 161)
    if cp != 225
        1
    else
        ov = utf8_feed(utf8_inicio(), 224)
        ov = utf8_feed(ov, 128)
        if ov != 65533
            2
        else
            su = utf8_feed(utf8_inicio(), 237)
            su = utf8_feed(su, 160)
            if su != 65533
                3
            else
                bad = utf8_feed(utf8_inicio(), 255)
                if bad != 65533
                    4
                else
                    0
