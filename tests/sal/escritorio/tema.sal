import "../../../user/sal/escritorio/tema.sal"

fn main() -> Int
    if tema_fondo_arriba(tema_oscuro()) == tema_fondo_arriba(tema_claro())
        1
    elsif tema_luma(tema_texto(tema_oscuro())) <= tema_luma(tema_barra(tema_oscuro()))
        2
    elsif tema_luma(tema_texto(tema_claro())) >= tema_luma(tema_marco(tema_claro(), 1))
        3
    elsif mezclar_rgb(color_rgb(255, 0, 0), color_rgb(0, 0, 255), 0) != color_rgb(0, 0, 255)
        4
    elsif mezclar_rgb(color_rgb(255, 0, 0), color_rgb(0, 0, 255), 255) != color_rgb(255, 0, 0)
        5
    else
        0
