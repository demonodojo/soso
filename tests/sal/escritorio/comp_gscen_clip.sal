import "../../../user/sal/escritorio/comp_clip.sal"
import "../../../user/sal/escritorio/comp_proto.sal"

fn main() -> Int
    if comp_intersect_len(100, 200, 150, 250) != 50
        1
    else
        if comp_intersect_len(100, 200, 0, 50) != 0
            2
        else
            if comp_intersect_x0(120, 100) != 120
                3
            else
                if comp_rect_contains(0, 0, 640, 480, 10, 20, 12, 16) == 0
                    4
                else
                    if comp_surf_visible(comp_geom_hidden()) != 0
                        5
                    else
                        if comp_surf_opaque(comp_geom_opaque()) == 0
                            6
                        else
                            if comp_surf_opaque(0) != 0
                                7
                            else
                                0
