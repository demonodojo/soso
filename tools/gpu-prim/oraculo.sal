import "../../user/sal/escritorio/soso.sal"
import "../../user/sal/escritorio/gprim_prueba_escena.sal"

# Oráculo CPU de la escena de primitivas: escribe en stdout las N primitivas (64 B cada una)
# y después el buffer de píxeles resultante (128 x 96, BGR, 4 B por píxel), la fuente y las celdas.
# Lo usa tools/gpu-prim/validar.py para comprobar el kernel de GPU contra este backend.

fn main() -> Int ! io, alloc
    w = gprim_prueba_w()
    h = gprim_prueba_h()
    cap = gprim_prueba_cap()
    e = esc_nueva(cap)
    n = gprim_prueba_construir(e)
    psf = psf_sintetica()
    cel = gprim_prueba_celdas()
    pix = bytes_ptr(bytes_new(w * h * 4))
    _x = esc_cpu_ejecutar_r(pix, w * h * 4, w, h, w, 4, 1, e, cap, n, cel, psf, gprim_prueba_psf_len())
    _w1 = write_fd(1, e, n * esc_prim_bytes())
    _w2 = write_fd(1, pix, w * h * 4)
    _w3 = write_fd(1, psf, gprim_prueba_psf_len())
    _w4 = write_fd(1, cel, gprim_prueba_ncells() * 12)
    0
